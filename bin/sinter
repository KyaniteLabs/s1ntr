  for (const [alias, target] of COMMAND_ALIASES) console.log(`  ${alias.padEnd(20)} ${target}`);
  console.log('  learn study/reserve/pick-best/verify/stack = dream run/transfer/autoseal/guard/compound');
  console.log('  motifs mine/list/evolve = compost digest/seeds list/soup');
  console.log('  mediums check/list, autopilot balance/curate, promote --undo, titles make/budget');
