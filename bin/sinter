else if (cmd === 'archive') {
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks, LineageTracker, ArchivePlacement } = await import('../dist/emergence/index.js');

  const subCmd = cmdArgs[0];
  const artifactRef = cmdArgs[1];

  const sinterFs = SinterFS.open(process.cwd());

  try {
    if (subCmd === 'inspect' && artifactRef) {
      const hooks = new EmergenceHooks(sinterFs);
      const cell = hooks.getArchive().findCellForArtifact(artifactRef);
      if (!cell) {
        console.error(`Artifact ${artifactRef} not found in archive.`);
        process.exit(1);
      }
      const elite = cell.elite;
      if (!elite) {
        console.error(`No elite in cell for ${artifactRef}.`);
        process.exit(1);
      }
      console.log('');
      console.log(`Archive Entry: ${elite.id}`);
      console.log(`  Cell: ${cell.cellId}`);
      console.log(`  Quality: ${elite.qualityScore.toFixed(3)}`);
      console.log(`  Provenance: ${elite.lineage.provenance}`);
      console.log(`  Parents: ${elite.lineage.parentIds.length > 0 ? elite.lineage.parentIds.join(', ') : '(root)'}`);
      console.log(`  Archived: ${elite.archivedAt}`);
      console.log('');
      console.log('  Descriptors:');
      for (const dv of elite.descriptor.values) {
        console.log(`    ${dv.axis}: ${dv.value.toFixed(3)}`);
      }
      console.log('');
      console.log('  Emergence signals:');
      console.log(`    Novelty: ${elite.signals.novelty.toFixed(3)}`);
      console.log(`    Structure: ${elite.signals.structure.toFixed(3)}`);
      console.log(`    Temporal richness: ${elite.signals.temporalRichness.toFixed(3)}`);
      console.log(`    Fertility: ${elite.signals.fertility.toFixed(3)}`);
      console.log(`    Aesthetic: ${elite.signals.aesthetic.toFixed(3)}`);
      console.log('');
    } else if (subCmd === 'lineage' && artifactRef) {
      const tracker = new LineageTracker();
      const ancestry = await tracker.getAncestry(artifactRef);
      if (ancestry.length === 0) {
        console.error(`No lineage found for ${artifactRef}.`);
        process.exit(1);
      }
      console.log('');
      console.log(`Lineage for ${artifactRef}:`);
      for (const record of ancestry) {
        const indent = '  ' + '  '.repeat(await tracker.getDepth(record.artifactId));
        console.log(`${indent}${record.artifactId} [${record.provenance}] ${record.parentIds.length > 0 ? '<- ' + record.parentIds.join(', ') : '(root)'}`);
      }
      console.log('');
    } else if (subCmd === 'branch' && artifactRef) {
      console.log('');
      console.log(`Branching from ${artifactRef}...`);
      console.log('  (Branch action recorded. Use sinter gen with --parent to continue.)');
      console.log('');
    } else if (subCmd === 'list') {
      const hooks = new EmergenceHooks(sinterFs);
      const stats = hooks.getArchive().getStats();
      const elites = hooks.getArchive().getAllElites();
      console.log('');
      console.log(`Archive: ${stats.totalCells} cells, ${stats.totalElites} elites, ${stats.totalNearElites} near-elites`);
      console.log(`  Average quality: ${stats.avgQuality.toFixed(3)}`);
      console.log('');
      if (elites.length > 0) {
        for (const e of elites.slice(0, 20)) {
          console.log(`  ${e.id}  q=${e.qualityScore.toFixed(2)}  ${e.lineage.provenance}  novelty=${e.signals.novelty.toFixed(2)}`);
        }
        if (elites.length > 20) console.log(`  ... and ${elites.length - 20} more`);
      }
      console.log('');
    } else {
      console.error('Usage: sinter archive <inspect|lineage|branch|list> [artifactRef]');
      process.exit(1);
    }
  } finally {
    sinterFs.close();
  }
  process.exit(0);
}

else if (cmd === 'compact') {
  const { runSinterCompact, formatCompactReport } = await import('../dist/cli/SinterCompact.js');
  const execute = Boolean(flags.execute || flags.force || cmdArgs.includes('--execute'));
  const rootFlag = flags.root || (cmdArgs.includes('--root') ? cmdArgs[cmdArgs.indexOf('--root') + 1] : undefined);
  const result = runSinterCompact({
    execute,
    root: typeof rootFlag === 'string' && rootFlag.length > 0 ? rootFlag : undefined,
  });
  process.stdout.write(formatCompactReport(result));
  process.exit(0);
}
else if (cmd === 'preferences') {
  const { PreferenceEventLogger, TasteLearningService } = await import('../dist/learning/index.js');
  const { SinterFS } = await import('../dist/fs/index.js');
  const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');

  const subCmd = cmdArgs[0];
  const sinterFs = SinterFS.open(resolveSinterProjectRoot());
  let exitCode = 0;

  try {
    const logger = new PreferenceEventLogger({
      prefDir: TasteLearningService.preferenceDirForProject(sinterFs),
    });
    const service = new TasteLearningService(sinterFs);

    if (subCmd === 'export') {
      const sessionId = flags.session || flags.prompt;
      let records;
      if (sessionId) {
        records = await logger.exportSession(sessionId);
        console.log('');
        console.log(`Preference events for session ${sessionId}:`);
      } else {
        const dataset = await logger.exportDataset();
        console.log('');
        console.log('Preference Dataset Export:');
        console.log(`  Total events: ${dataset.totalEvents}`);
        console.log(`  Pairwise comparisons: ${dataset.pairwiseComparisons.length}`);
        console.log(`  Positive feedback: ${dataset.positiveFeedback.length}`);
        console.log(`  Negative feedback: ${dataset.negativeFeedback.length}`);
        console.log('');
        if (dataset.pairwiseComparisons.length > 0) {
          console.log('  Pairwise:');
          for (const c of dataset.pairwiseComparisons) {
            console.log(`    winner: ${c.winner}  loser: ${c.loser}`);
          }
        }
        console.log('');
      }
      if (records) {
        for (const r of records) {
          console.log(`  ${r.action} ${r.artifactId}${r.comparedTo ? ' vs ' + r.comparedTo : ''}  @${r.capturedAt}`);
        }
        console.log('');
      }
    } else if (subCmd === 'stats') {
      const stats = await logger.getStats();
      console.log('');
      console.log('Preference Stats:');
      console.log(`  Total events: ${stats.totalEvents}`);
      console.log(`  Unique artifacts: ${stats.uniqueArtifacts}`);
      console.log(`  Pairwise: ${stats.pairwiseCount}`);
      console.log('');
      if (Object.keys(stats.byAction).length > 0) {
        console.log('  By action:');
        for (const [action, count] of Object.entries(stats.byAction)) {
          console.log(`    ${action}: ${count}`);
        }
      }
      console.log('');
    } else if (subCmd === 'train') {
      const summary = await service.trainFromProject();
      console.log('');
      console.log('=== Taste Model Training ===');
      console.log(`  Archive entries: ${summary.archiveEntryCount}`);
      console.log(`  Preference events: ${summary.preferenceEventCount}`);
      console.log(`  Training pairs: ${summary.pairCount}`);

      if (!summary.persisted || !summary.weights) {
        console.error(`  Not trained: ${summary.reason ?? 'no usable preference data'}`);
        console.log('');
        exitCode = 1;
      } else {
        console.log(`  Model ref: ${summary.ref?.kind}:${summary.ref?.path}`);
        console.log(`  Pair count: ${summary.weights.pairCount}`);
        console.log(`  Training agreement: ${(summary.weights.trainingAgreement * 100).toFixed(1)}%`);
        console.log(`  Quality weight: ${summary.weights.qualityWeight.toFixed(3)}`);
        console.log(`  Axis weights: ${summary.weights.axisWeights.map((w, i) => `[${i}]${w.toFixed(3)}`).join(' ')}`);
        console.log('');
      }
    } else if (subCmd === 'model') {
      const model = service.loadLatestModel();
      console.log('');
      console.log('=== Taste Model ===');
      if (!model) {
        console.error('  No persisted taste model found. Run `sinter preferences train` first.');
        console.log('');
        exitCode = 1;
      } else {
        console.log(`  Trained at: ${model.trainedAt}`);
        console.log(`  Pair count: ${model.pairCount}`);
        console.log(`  Training agreement: ${(model.trainingAgreement * 100).toFixed(1)}%`);
        console.log(`  Quality weight: ${model.qualityWeight.toFixed(3)}`);
        console.log(`  Axis weights: ${model.axisWeights.map((w, i) => `[${i}]${w.toFixed(3)}`).join(' ')}`);
        console.log('');
      }
    } else {
      console.error('Usage: sinter preferences <export|stats|train|model> [--session <id>]');
      exitCode = 1;
    }
  } catch (err) {
    console.error(`Error: ${err.message}`);
    exitCode = 1;
  } finally {
    sinterFs.close();
  }
  process.exit(exitCode);
}
else if (cmd === 'emergence') {
  const subCmd = cmdArgs[0];

  if (subCmd === 'score') {
    const { EmergenceCritic, BehaviorDescriptorExtractor } = await import('../dist/emergence/index.js');
    const { EmergenceScorecard } = await import('../dist/evaluation/EmergenceScorecard.js');

    const output = cmdArgs[1] ? String(cmdArgs[1]) : null;
    if (!output) {
      console.error('Usage: sinter emergence score <text-or-file-path>');
      process.exit(1);
    }

    // Check if it's a file path
    let text = output;
    try {
      const { readFileSync } = await import('fs');
      text = readFileSync(output, 'utf-8');
    } catch { /* not a file path, use as raw text */ }

    const extractor = new BehaviorDescriptorExtractor();
    const critic = new EmergenceCritic();
    const scorecard = new EmergenceScorecard();

    const descriptor = extractor.extract(text);
    const result = critic.evaluateQuick({
      descriptor,
      qualityScore: 0.5,
      archive: [],
      output: text,
    });

    const card = scorecard.score(result.signals, result.composite);
    console.log('');
    console.log(scorecard.format(card));
  } else if (subCmd === 'probe') {
    const { PerturbationProbe, BehaviorDescriptorExtractor } = await import('../dist/emergence/index.js');

    const output = cmdArgs[1] ? String(cmdArgs[1]) : null;
    if (!output) {
      console.error('Usage: sinter emergence probe <text-or-file-path> [--magnitude 0.1]');
      process.exit(1);
    }

    let text = output;
    try {
      const { readFileSync } = await import('fs');
      text = readFileSync(output, 'utf-8');
    } catch { /* not a file path, use as raw text */ }

    const extractor = new BehaviorDescriptorExtractor();
    const probe = new PerturbationProbe();

    const descriptor = extractor.extract(text);
    const result = probe.probe(text, descriptor, (t) => extractor.extract(t));

    console.log('');
    console.log(`Perturbation Resilience: ${result.resilience.toFixed(3)} [${result.classification}]`);
    for (const p of result.perturbations) {
      console.log(`  ${p.type}: ${p.score.toFixed(3)}`);
    }
    console.log('');
  } else {
    console.error('Usage: sinter emergence <score|probe> <text-or-file-path>');
    process.exit(1);
  }
  process.exit(0);
}
