      prefDir: TasteLearningService.preferenceDirForProject(sinterFs),
    });
    const service = new TasteLearningService(sinterFs);

    if (subCmd === 'export') {
      const sessionId = flags.session || flags.prompt;
      let records;
      if (sessionId) {
        records = await logger.exportSession(sessionId);
        console.log('');
