  console.log('  sinter --configure --provider lmstudio');
  console.log('  sinter provider set-key minimax sk-... --use   # MiniMax-M3, international endpoint, made active');
  console.log('  sinter provider set-key glm <KEY> --use && sinter "make a p5 sketch"   # generate uses the configured seat, not a per-run --provider');
  console.log('  sinter provider status');
  console.log('');
}

function printProviderList() {
  console.log('');
  console.log('Available Sinter providers:');
  for (const name of CLI_PROVIDER_NAMES) {
    const provider = CLI_PROVIDER_DEFAULTS[name];
    console.log(`  ${name.padEnd(10)} ${provider.label} (${provider.baseUrl})`);
  }
  console.log('');
}

function readSinterConfig() {
  const p = sinterConfigPath();
  if (!fs.existsSync(p)) return {};
  try {
    return JSON.parse(fs.readFileSync(p, 'utf-8'));
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    // Fail closed: continuing with defaults silently switches provider, model,
    // and billing. The operator must fix or rebuild the config.
    throw new Error(`${p} is not valid JSON (${message}). Refusing to run with defaults; move it aside (mv \"${p}\" \"${p}.bak\") or fix the JSON, then re-run.`);
  }
}

function savedKeyFor(name, config) {
  const fromProvider = config.providers?.[name]?.apiKey;
  const fromRole = ['generator', 'evaluator', 'harness']
    .map((r) => config.roles?.[r])
    .find((role) => role?.provider === name && role?.apiKey)?.apiKey;
  return Boolean(fromProvider || fromRole);
}

// Keyless providers are only "ready" if a listener actually answers; the
// status used to claim ready for LM Studio / Ollama with nothing running.
function probeLocalEndpoint(baseUrl, timeoutMs = 300) {
  return new Promise((resolve) => {
    let url;
    try { url = new URL(baseUrl); } catch { resolve(false); return; }
    const port = Number(url.port) || (url.protocol === 'https:' ? 443 : 80);
    const socket = net.connect({ host: url.hostname, port });
    let settled = false;
    const done = (ok) => {
      if (settled) return;
      settled = true;
      socket.destroy();
      resolve(ok);
    };
    socket.setTimeout(timeoutMs, () => done(false));
    socket.once('connect', () => done(true));
    socket.once('error', () => done(false));
  });
}

async function printProviderStatus() {
  const config = readSinterConfig();
  const names = Object.keys(CLI_PROVIDER_DEFAULTS);
  // The route Generate really takes is the resolved generator seat (file pin, env, or default), not the catalog URL.
  let seat = null;
  try { const { LLMClient: Client } = await import('../dist/llm/LLMClient.js'); await Client.loadRoles(); seat = Client.getResolvedRoleConfig('generator'); } catch (e) { if (process.env.SINTER_DEBUG_STATUS) console.error(e); }
  const { resolveStatusRoute } = await import('../dist/cli/providerStatusRoute.js');
  const route = resolveStatusRoute(seat, config.defaultProvider,
    names.map((n) => ({ name: n, baseUrl: CLI_PROVIDER_DEFAULTS[n].baseUrl })));
  const active = route.activeName;
  const urlFor = (name) => (name === active && route.probeUrl) ? route.probeUrl : CLI_PROVIDER_DEFAULTS[name].baseUrl;
  const seatUp = route.probeUrl && seat?.apiKey === undefined ? await probeLocalEndpoint(route.probeUrl) : null;
  const reachable = new Map(await Promise.all(names.map(async (name) => {
    const provider = CLI_PROVIDER_DEFAULTS[name];
    if (provider.requiresKey) return [name, true];
    return [name, await probeLocalEndpoint(urlFor(name))];
  })));
  console.log('');
  console.log('Sinter provider readiness:');
  for (const [name, provider] of Object.entries(CLI_PROVIDER_DEFAULTS)) {
    // Ready if a required key is present, and a keyless endpoint answers.
    const hasKey = Boolean(process.env[provider.apiKeyEnv]) || savedKeyFor(name, config);
    const configured = !provider.requiresKey || hasKey;
    const status = !configured
      ? `missing key (set with: sinter provider set-key ${name} <KEY>)`
      : reachable.get(name) === false
        ? `not reachable at ${urlFor(name)}`
        : 'ready';
    const activeMark = name === active ? ' (active)' : '';
    console.log(`  ${name.padEnd(10)} ${status}${activeMark}`);
  }
  if (route.seatLine) console.log('\n' + route.seatLine + (seatUp === null ? '' : seatUp ? ' (reachable)' : ' (not reachable)'));
  if (route.mismatchNote) console.log(route.mismatchNote);
  console.log('');
  console.log('Set a key with `sinter provider set-key <name> <KEY> --use`.');
  console.log('');
}

function hasConfiguredProviderKey(name) {
  const provider = CLI_PROVIDER_DEFAULTS[name];
  if (!provider?.requiresKey) return true;
  if (flags.apiKey || process.env.LLM_API_KEY || process.env.LIMINAL_LLM_API_KEY || process.env.SINTER_LLM_API_KEY) return true;
  if (provider.apiKeyEnv && process.env[provider.apiKeyEnv]) return true;
  return savedKeyFor(name, readSinterConfig());
}

function providerNameFromBaseUrl(baseUrl) {
  if (!baseUrl) return undefined;
  const normalized = String(baseUrl).toLowerCase();
  return CLI_PROVIDER_NAMES.find((name) => {
    const defaults = CLI_PROVIDER_DEFAULTS[name];
    return defaults.baseUrl && normalized.startsWith(defaults.baseUrl.toLowerCase());
  });
}

function providerForGenerationPreflight() {
  if (flags.provider) return resolveCliProvider(flags.provider);
  const config = readSinterConfig();
  if (config.defaultProvider && CLI_PROVIDER_DEFAULTS[config.defaultProvider]) return config.defaultProvider;
  const configuredBaseUrl = process.env.LIMINAL_LLM_BASE_URL || process.env.SINTER_LLM_BASE_URL;
  const providerFromEndpoint = providerNameFromBaseUrl(configuredBaseUrl);
  if (providerFromEndpoint) return providerFromEndpoint;
  const keyedProvider = CLI_PROVIDER_NAMES.find((name) => {
    const provider = CLI_PROVIDER_DEFAULTS[name];
    return provider.requiresKey && provider.apiKeyEnv && process.env[provider.apiKeyEnv];
  });
  return keyedProvider || 'anthropic';
}

async function missingProviderKeyMessageForGeneration() {
  // The resolved generator role is the witness: a file-pinned key, a cli://
  // subscription seat or a keyless local server (Ollama, LM Studio, loopback)
  // needs no env key. The sniff below only sees env keys and would otherwise
  // demand an unrelated default-provider key (#1592).
  try {
    const { generatorRoleNeedsNoKey } = await import('../dist/cli/generationKeyPreflight.js');
    if (generatorRoleNeedsNoKey(LLMClient.getResolvedRoleConfig('generator'))) return null;
  } catch { /* fall through to the sniff */ }
  const providerName = providerForGenerationPreflight();
  const provider = providerName ? CLI_PROVIDER_DEFAULTS[providerName] : undefined;
  if (!providerName || !provider?.requiresKey || hasConfiguredProviderKey(providerName)) return null;
  const keyHint = provider.apiKeyEnv || 'the provider API key env var';
  return [
    `Missing API key for ${providerName}.`,
    `Set ${keyHint} or run: sinter provider set-key ${providerName} <KEY> --use`,
  ].join(' ');
}

function parsePortArg(rawPort) {
  if (rawPort === undefined) return 3456;
  if (!/^\d+$/.test(String(rawPort))) return null;
  const port = Number(rawPort);
  if (!Number.isInteger(port) || port < 0 || port > 65535) return null;
  return port;
}

function parseNumericFlag(flag, rawValue, { integer = false, min, max, expected }) {
  const value = rawValue === undefined || String(rawValue).trim() === ''
    ? NaN
    : Number(rawValue);
  if (
    !Number.isFinite(value)
    || (integer && !Number.isInteger(value))
    || value < min
    || value > max
  ) {
    console.error(`Invalid value for ${flag}: expected ${expected}.`);
    process.exit(1);
  }
  return value;
}

// Parse flags
const { normalizeCliCommand, cliSubcommandAlias, COMMAND_ALIASES } = await import('../dist/cli/PromptArgs.js');
const flags = {};
let cmd = null;
let cmdArgs = [];
let prompt = null;
let cmdIndex = -1;
let expandedSubcommand = false;
// Commands whose own parser owns their flags (Sol audit F02/F03/F16). The global parser below still records the flags it
// knows (flags.dryRun, flags.output, ...), but it consumes them, so a leaf that re-reads its argv never saw --dry-run,
// --lane, --verbose, --window, --no-write ... and a leaf-only flag hit "Unknown option" before the leaf ran. For these
// commands unknown flags are left for the leaf and the leaf receives the raw tokens after the command (leafArgv()).
const LEAF_OWNED_ARGV = new Set(['ledger', 'compost', 'image', 'gbg', 'taxonomy', 'phases', 'islands', 'mece', 'rotation', 'ship', 'rescore']);
// Boolean flags that may legitimately precede the command (`sinter --dry-run ledger run X`): re-appended for the leaf.
const LEAF_FORWARDED_BOOLEANS = ['--dry-run', '--json', '--live', '--verbose', '-v', '--mock'];

let maxIterations = 3;
let output = null;

for (let i = 0; i < args.length; i++) {
  let arg = args[i];
  if (cmd && !cmdArgs.length && !expandedSubcommand) {
    const replacement = cliSubcommandAlias(cmd, arg);
    if (replacement) {
      const [canonical, ...prefix] = replacement;
      expandedSubcommand = true;
      args[cmdIndex] = cmd = canonical;
      args.splice(i, 1, ...prefix);
      if (prefix.length === 0) { i--; continue; }
      arg = args[i];
    }
  }
  if (cmd === 'dream' && ['autoseal', 'guard'].includes(cmdArgs[0]) && arg !== '--help' && arg !== '-h') {
    cmdArgs.push(arg); // autoseal/guard parse their own flags and values from cmdArgs
  } else if (cmd === 'ledger' && cmdArgs.length && cmdArgs[0] !== 'query' && arg !== '--help' && arg !== '-h') {
    cmdArgs.push(arg);
  } else if (cmd === 'taste' && ['train', 'eval', 'ingest'].includes(cmdArgs[0]) && arg !== '--help' && arg !== '-h') {
    cmdArgs.push(arg); // taste consumes its own subcommand arguments
  } else if (['phases', 'islands'].includes(cmd) && arg !== '--help' && arg !== '-h') {
    cmdArgs.push(arg); // phases/islands parse --trend/--window/--k-sigma/--epochs/--k/--domain from cmdArgs (PopulationCli)
  } else if (['judge-evidence', 'legacy-backfill'].includes(cmd) && arg !== '--help' && arg !== '-h') {
    cmdArgs.push(arg); // the learning-step commands parse their own flags (--write-negatives, --out, ...) from cmdArgs
  } else if (arg === '--help' || arg === '-h') {
    flags.help = true;
  } else if (cmd === 'judge' && arg === '--round') {
    const round = args[++i];
    if (round !== '2' && round !== '3') {
      console.error('judge --round expects 2 or 3');
      process.exit(1);
    }
    cmd = round === '2' ? 'second-judge' : 'third-judge';
  } else if (arg === '--version') {
    flags.version = true;
  } else if (arg === '--prompt' || arg === '-p') {
    flags.prompt = args[++i];
  } else if (arg === '--n') {
    flags.n = args[++i];
  } else if (arg === '--session') {
    flags.session = args[++i];
  } else if (arg === '--max-iterations' || arg === '-m') {
    flags.maxIterations = parseNumericFlag('--max-iterations (-m)', args[++i], {
      integer: true,
      min: 1,
      max: Infinity,
      expected: 'a positive integer',
    });
  } else if (arg === '--teach') {
    flags.teach = args[++i] ?? '';
  } else if (arg.startsWith('--retry-unknown=')) {
    flags.retryUnknown = parseNumericFlag('--retry-unknown', arg.slice('--retry-unknown='.length), {
      integer: true, min: 1, max: 12, expected: 'a loop number from 1 to 12',
    });
  } else if (arg === '--parent') {
    flags.parent = args[++i] ?? '';
  } else if (arg === '--retry-unknown') {
    flags.retryUnknown = true;
  } else if (arg === '--max-age-ms') {
    flags.maxAgeMs = args[++i] ?? '';
    if (!Number.isFinite(Number(flags.maxAgeMs)) || flags.maxAgeMs === '') { console.error('Error: --max-age-ms needs a number'); process.exit(1); }
  } else if (arg === '--w9-brief') {
    flags.w9Brief = args[++i] ?? '';
    if (!flags.w9Brief.trim()) { console.error('Error: --w9-brief needs list, temporal, narrative or information'); process.exit(1); }
  } else if (arg === '--concept-graph') {
    flags.conceptGraph = args[++i] ?? '';
    if (!flags.conceptGraph.trim()) { console.error('Error: --concept-graph needs a concept-graph JSON file'); process.exit(1); }
  } else if (arg === '--revise-from') {
    flags.reviseFrom = args[++i] ?? '';
    if (!flags.reviseFrom.trim()) { console.error('Error: --revise-from needs the previous loop\'s run folder'); process.exit(1); }
  } else if (arg === '--revise-loop' || arg === '--revise-of') {
    const n = Number(args[++i]);
    if (!Number.isInteger(n) || n < 1) { console.error(`Error: ${arg} needs a positive integer`); process.exit(1); }
    flags[arg === '--revise-loop' ? 'reviseLoop' : 'reviseOf'] = n;
  } else if (arg === '--loops') {
    flags.loops = args[++i] ?? '';
  } else if (arg === '--attempt') {
    flags.attempt = args[++i] ?? '';
    if (!flags.attempt.trim()) { console.error('Error: --attempt needs a non-empty id'); process.exit(1); }
  } else if (arg === '--max-provider-calls') {
    flags.maxProviderCalls = parseNumericFlag('--max-provider-calls', args[++i], {
      integer: true, min: 1, max: Infinity, expected: 'a positive integer (a cap of 0 cannot run a generation)',
    });
  } else if (arg === '--reasoning') {
    // #1735: per-run reasoning level for every role; same pin as SINTER_LLM_THINKING_EFFORT.
    const level = String(args[++i] || '').toLowerCase();
    if (!['none', 'low', 'medium', 'high', 'xhigh', 'max'].includes(level)) {
      console.error('--reasoning needs one of: none, low, medium, high, xhigh, max');
      process.exit(1);
    }
    process.env.SINTER_LLM_THINKING_EFFORT = level;
    flags.reasoning = level;
  } else if (arg === '--stages') {
    flags.stages = args[++i];
  } else if (arg === '--output' || arg === '-o') {
    flags.output = args[++i];
  } else if (arg === '--gallery') {
    flags.gallery = args[++i] ?? '';
    if (!flags.gallery.trim() || flags.gallery.startsWith('--')) { console.error('Error: --gallery needs a directory path'); process.exit(1); }
  } else if (arg === '--plugins-dir') {
    flags.pluginsDir = args[++i];
  } else if (arg === '--input' || arg === '-f') {
    flags.input = args[++i];
  } else if (arg === '--domain' || arg === '--medium') {
    flags.domain = args[++i];
  } else if (arg === '--output-mode') {
    flags.outputMode = args[++i] ?? '';
  } else if (arg === '--ref' || arg === '--reference') {
    (flags.ref ??= []).push(args[++i]);
  } else if (arg === '--arc' || arg === '--energy') {
