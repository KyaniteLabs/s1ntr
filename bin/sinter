#!/usr/bin/env node
import net from "node:net";
import "./wait-for-dist.mjs";
// A ./.env may supply API keys and model names only; see loadProjectDotenv.
const { loadProjectDotenv } = await import("../dist/config/loadProjectDotenv.js");
loadProjectDotenv();

// Graceful top-level error handling
process.on('uncaughtException', (err) => {
  if (process.env.SINTER_DEBUG && err && err.stack) console.error(err.stack);
  console.error(`Error: ${err.message || err}`);
  process.exit(1);
});

process.on('unhandledRejection', (reason) => {
  if (process.env.SINTER_DEBUG && reason instanceof Error) console.error(reason.stack);
  console.error(`Error: ${reason instanceof Error ? reason.message : reason}`);
  process.exit(1);
});

// Env back-compat: mirror SINTER_*/LIMINAL_* so both prefixes work whichever the
// user set (the canonical prefix is SINTER_; LIMINAL_ stays supported).
// Never mirror *_API_KEY or *_BASE_URL when the other prefix already binds a
// different endpoint/key, matching src/utils/env.ts.
(function mirrorBrandEnv() {
  for (const key of Object.keys(process.env)) {
    const base = key.startsWith('SINTER_') ? key.slice(7)
      : key.startsWith('LIMINAL_') ? key.slice(8) : undefined;
    if (!base) continue;
    const value = process.env[key];
    if (value === undefined) continue;
    const srcPrefix = key.startsWith('SINTER_') ? 'SINTER_' : 'LIMINAL_';
    const dstPrefix = srcPrefix === 'SINTER_' ? 'LIMINAL_' : 'SINTER_';
    if (process.env[`${dstPrefix}${base}`] !== undefined) continue;
    if (base.endsWith('_API_KEY')) {
      const urlStem = `${base.slice(0, -'_API_KEY'.length)}_BASE_URL`;
      const dstUrl = process.env[`${dstPrefix}${urlStem}`];
      const srcUrl = process.env[`${srcPrefix}${urlStem}`];
      if (dstUrl && dstUrl !== srcUrl) continue;
    } else if (base.endsWith('_BASE_URL')) {
      const keyStem = `${base.slice(0, -'_BASE_URL'.length)}_API_KEY`;
      const dstKey = process.env[`${dstPrefix}${keyStem}`];
      const srcKey = process.env[`${srcPrefix}${keyStem}`];
      if (dstKey && dstKey !== srcKey) continue;
    }
    process.env[`${dstPrefix}${base}`] = value;
  }
})();

