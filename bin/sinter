]);

// Initialize Meta-Harness only after cheap help/version fast paths have exited.
metaHarness.initialize();

// Load config and set env vars for LLMClient to pick up
async function initializeConfig() {
  const config = await getEffectiveConfig(undefined, process.cwd());

  // Explicitly file-pinned seats beat the provider sniff: writing the sniffed
  // endpoint into LIMINAL_LLM_* would override every pinned role via
  // env-beats-file (F4/F10 family). Only propagate sniff defaults when the
  // generator seat is not pinned in a config file.
  const rawRoles = LLMClient.getRawRoleConfig()?.roles;
  const generatorPinned = Boolean(rawRoles?.generator?.baseUrl || rawRoles?.generator?.model);
  if (generatorPinned) {
    console.error('[config] file-pinned seats take precedence over provider sniff defaults (no LIMINAL_LLM_* env written)');
    return config;
  }

  // Set env vars so LLMClient picks them up
  // Note: provider is no longer used - we use baseUrl + model directly
  // Only set if not already set in environment (respect user env vars)
  if (config.baseUrl && !process.env.LIMINAL_LLM_BASE_URL) process.env.LIMINAL_LLM_BASE_URL = config.baseUrl;
  // Propagate model — auto-detect from /v1/models only works for local LM Studio;
  // remote providers (MiniMax, OpenRouter, etc.) need an explicit model name.
  if (config.model && !process.env.LIMINAL_LLM_MODEL) process.env.LIMINAL_LLM_MODEL = config.model;
  if (config.apiKey && !process.env.LIMINAL_LLM_API_KEY) process.env.LIMINAL_LLM_API_KEY = config.apiKey;

  return config;
}

// Initialize prompt history
const history = new PromptHistory();

// Handle --configure flag
if (flags.configure) {
  const providerKey = resolveCliProvider(flags.provider) || 'anthropic';
  const providerDefaults = CLI_PROVIDER_DEFAULTS[providerKey];
  console.log('');
  console.log('🎨 Sinter Configuration');
  console.log('');
  console.log(`Setting up ${providerDefaults.label} config...`);
  console.log('');

  try {
    // Deep-merge into the existing config (atomic, mode 0600) so roles,
    // fallbacks, capability settings, and unknown forward-compatible keys
    // survive --configure instead of being wiped by a full overwrite.
    const result = await updateConfig({
      defaultProvider: providerKey,
      providers: {
        [providerKey]: {
          baseUrl: providerDefaults.baseUrl,
          model: flags.model || providerDefaults.model
        }
      }
    }, sinterConfigPath());
    if (result.isErr()) throw result.error;
    console.log(`✅ Config saved to ${sinterConfigPath()}`);
    // A default change does not move an explicitly pinned generator seat: say so instead of implying activation.
    const pinned = result.value?.roles?.generator;
    if (pinned && pinned.provider && pinned.provider !== providerKey) {
      console.log(`⚠️  roles.generator is pinned to "${pinned.provider}" and still wins; run \`sinter provider set-key ${providerKey} --use\` to switch the generator seat.`);
    }
    console.log('');
    console.log('You can now run:');
    console.log('  sinter --prompt "your idea"');
    if (providerDefaults.requiresKey && providerDefaults.apiKeyEnv) {
      console.log('');
      console.log(`Set ${providerDefaults.apiKeyEnv} before generating with ${providerDefaults.label}.`);
    }
    console.log('');
    process.exit(0);
  } catch (err) {
    console.error('❌ Error saving config:', err.message);
    process.exit(1);
  }
}

// Override config with CLI flags
if (flags.provider) {
  const providerKey = resolveCliProvider(flags.provider);
  if (providerKey) {
    const providerDefaults = CLI_PROVIDER_DEFAULTS[providerKey];
    // A CLI provider/model selection is a generator override, even when the
    // full loop also evaluates. Keep evaluator, harness, and studio seats pinned.
    // Set both LIMINAL_* and SINTER_* so neither prefix shadows the CLI flag.
    const envPrefix = 'LIMINAL_GENERATOR';
    const resolvedBaseUrl = flags.baseUrl || providerDefaults.baseUrl;
    process.env[`${envPrefix}_PROVIDER`] = providerKey;
    process.env.SINTER_GENERATOR_PROVIDER = providerKey;
    // An explicit --base-url beats the provider default endpoint; both beat any
    // file role config (env-over-file in RoleConfig).
    process.env[`${envPrefix}_BASE_URL`] = resolvedBaseUrl;
    process.env.SINTER_GENERATOR_BASE_URL = resolvedBaseUrl;
    if (!process.env.SINTER_GENERATOR_MODEL && !process.env[`${envPrefix}_MODEL`]) {
      process.env[`${envPrefix}_MODEL`] = providerDefaults.model;
      process.env.SINTER_GENERATOR_MODEL = providerDefaults.model;
    }
    // Requested, not yet resolved — RoleConfig/loadRoles may still surface a
    // different endpoint after env-over-file, and runtime fallbacks may switch again.
    console.log(`[CLI] Requested provider: ${providerKey} @ ${process.env[`${envPrefix}_BASE_URL`]} (model=${process.env.SINTER_GENERATOR_MODEL || process.env[`${envPrefix}_MODEL`]})`);
  } else {
    console.error(`Unknown --provider "${flags.provider}".`);
    console.error(`Valid providers: ${CLI_PROVIDER_NAMES.join(', ')}`);
    process.exit(1);
  }
}
if (flags.baseUrl && !flags.provider) {
  // --base-url without --provider: still an explicit endpoint override.
  process.env.SINTER_GENERATOR_BASE_URL = flags.baseUrl;
  process.env.LIMINAL_GENERATOR_BASE_URL = flags.baseUrl;
}
if (flags.model) {
  process.env.SINTER_GENERATOR_MODEL = flags.model;
  process.env.LIMINAL_GENERATOR_MODEL = flags.model;
}


// Handle --favorite flag (add to favorites)
if (flags.favorite) {
  await history.addFavorite(flags.favorite);
  console.log('');
  console.log('⭐ Added to favorites: "' + flags.favorite + '"');
  console.log('');
  process.exit(0);
}

if (cmd === 'report' && cmdArgs[0] === 'fitness') {
  const { buildFitnessObservationReport } = await import('../dist/quality/FitnessObservationStore.js');
  const report = await buildFitnessObservationReport();
  if (flags.json) {
    console.log(JSON.stringify(report, null, 2));
  } else {
    const showGroup = (label, group) => {
      const span = group.firstSeen ? `${group.firstSeen} → ${group.lastSeen}` : 'no observations';
      console.log(`  ${label}: ${group.count} total, ${group.honestCount} honest, ${group.graduationEligibleCount} graduation-eligible; ${span}`);
    };
    console.log('\n=== Fitness Observation Report ===');
    showGroup('All', report);
    console.log('  Domains:');
    for (const [domain, group] of Object.entries(report.byDomain).sort()) showGroup(`  ${domain}`, group);
    console.log('  Provider/model lanes:');
    for (const [lane, group] of Object.entries(report.byModel).sort()) showGroup(`  ${lane}`, group);
    console.log('  Your seats per medium (your own runs; evidence only, nothing switches models for you):');
    for (const [medium, seats] of Object.entries(report.byMediumSeat).sort()) {
      const best = report.bestSeatByMedium[medium];
      console.log(`    ${medium}${best ? `  best so far: ${best}` : '  (no seat has 3 scored runs yet)'}`);
      for (const [lane, seat] of Object.entries(seats).sort()) {
        const mean = seat.meanScore === null ? 'n/a' : seat.meanScore.toFixed(3);
        console.log(`      ${lane}: ${seat.totalCount} runs, mean score ${mean}, ${seat.failureCount} failed, ${seat.meanDurationMs === null ? 'time n/a' : (seat.meanDurationMs / 1000).toFixed(1) + 's avg'}`);
      }
    }
    console.log('  Cohorts:');
    showGroup('  control', report.byCohort.control);
    showGroup('  treatment', report.byCohort.treatment);
    if (report.malformedCount) console.log(`  Malformed rows skipped: ${report.malformedCount}`);
    console.log('');
  }
  process.exit(0);
}

if (cmd === 'hillclimb' && cmdArgs[0] !== 'run') {
  // Calibrated accept/reject/escalate for the hill-climb (docs/design/lfm3-hillclimb-20261109.md).
  // Pure arithmetic: dispatched before provider resolution so stdout stays machine-readable.
  // `run` calls providers, so it is dispatched after role loading below.
  const { runHillClimbCommand } = await import('../dist/cli/HillClimbCli.js');
  await runHillClimbCommand(cmdArgs);
  process.exit(process.exitCode ?? 0);
}

if (cmd === 'ledger' && cmdArgs[0] === 'query') {
  const { queryEventLedger } = await import('../dist/telemetry/EventLedger.js');
  const limit = flags.limit !== undefined
    ? parseNumericFlag('--limit', flags.limit, {
      integer: true,
      min: 0,
      max: Number.MAX_SAFE_INTEGER,
      expected: 'a non-negative integer',
    })
    : undefined;
  const { events, malformedCount } = await queryEventLedger({
    event: flags.event,
    model: flags.model,
    role: flags.role,
    since: flags.since,
    limit,
  });
  for (const event of events) {
    console.log(JSON.stringify(event));
  }
  if (malformedCount > 0) {
    console.error(`# malformed rows skipped: ${malformedCount}`);
  }
  process.exit(0);
}

// Load role definitions for LLMClient BEFORE initializeConfig: the provider
// sniff's env-write must not poison explicitly file-pinned seats (F4-family).
await LLMClient.loadRoles();

// Initialize config (loads from file or uses defaults)
await initializeConfig();

// Report the provider+endpoint the generator role will actually use (after
// env-over-file resolution) so the CLI never claims one provider while calling
// another. Runtime fallbacks (if any) emit a separate stderr notice.
const resolvedGeneratorRole = LLMClient.getResolvedRoleConfig('generator');
if ((cmd === 'compost' && cmdArgs[0] === 'add') || cmd === 'dream') {
  // Learning calls providers only here. With SINTER_LEARNING_FREE_SEATS_ONLY=1 it never falls through to a paid default.
  const { assertFreeLearningSeat } = await import('../dist/learning/FreeSeatGuard.js');
  try { assertFreeLearningSeat(process.env, resolvedGeneratorRole?.provider); }
  catch (error) { console.error(error.message); process.exit(2); }
}
if (resolvedGeneratorRole) {
  const resolvedProvider = resolvedGeneratorRole.provider || 'auto';
  console.log(
    `[CLI] Resolved provider: ${resolvedProvider} @ ${resolvedGeneratorRole.baseUrl} (model=${resolvedGeneratorRole.model})`,
  );
  // When the user asked for a specific provider and resolution landed elsewhere
  // (e.g. env beat file, or requested beat default), surface one explicit notice.
  if (flags.provider) {
    const requestedKey = resolveCliProvider(flags.provider);
    const requestedEndpoint = (flags.baseUrl || (requestedKey && CLI_PROVIDER_DEFAULTS[requestedKey]?.baseUrl) || '').replace(/\/+$/, '');
    const resolvedEndpoint = String(resolvedGeneratorRole.baseUrl || '').replace(/\/+$/, '');
    if (requestedKey && (resolvedProvider !== requestedKey || (requestedEndpoint && resolvedEndpoint !== requestedEndpoint))) {
      console.error(
        `[config] override: requested ${requestedKey} → resolved ${resolvedProvider} @ ${resolvedGeneratorRole.baseUrl} (env beats file / requested beats default)`,
      );
    }
  }
}

if (cmd === 'hillclimb' && cmdArgs[0] === 'run') {
  // Live climb (#1423 PR 7): roles are loaded, provider calls go through the governed runtime.
  const { runHillClimbCommand } = await import('../dist/cli/HillClimbCli.js');
  await runHillClimbCommand(cmdArgs);
  process.exit(process.exitCode ?? 0);
