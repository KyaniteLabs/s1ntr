else if (cmd === 'quality') {
  const subCmd = cmdArgs[0];
  if (!subCmd || (subCmd !== 'run' && subCmd !== 'gate')) {
    console.error('Usage: sinter quality <run|gate>');
    console.error('  run   --spec <path>   Run a golden suite');
    console.error('  gate  --spec <path>   Block promotion on regression');
    process.exit(1);
  }

  const { EvaluationFabric } = await import('../dist/evaluation/EvaluationFabric.js');
  const { GoldenSuiteRunner } = await import('../dist/release/GoldenSuiteRunner.js');
  const { PromotionGate } = await import('../dist/release/PromotionGate.js');

  const suitePath = flags.spec;
  if (!suitePath) {
    console.error('Error: --spec <path> is required (path to golden suite JSON)');
    process.exit(1);
  }

  const suiteJson = fs.readFileSync(suitePath, 'utf-8');
  const suite = JSON.parse(suiteJson);

  console.log('');
  console.log('◆ Sinter Quality Gate');
  console.log(`  Suite: ${suite.name} (${suite.cases.length} cases)`);
  console.log('');

  const runner = new GoldenSuiteRunner({
    qualityThreshold: flags.confidenceThreshold,
    onCaseComplete: (id, passed, score) => {
      const icon = passed ? 'PASS' : 'FAIL';
      console.log(`  ${icon} ${id}: ${score.toFixed(3)}`);
    },
  });

  const result = await runner.run(suite);
  console.log('');
  console.log(`  Result: ${result.aggregate.passed}/${result.aggregate.total} passed`);
  console.log(`  Average score: ${result.aggregate.averageScore.toFixed(3)}`);
  console.log(`  Duration: ${result.durationMs}ms`);

  if (subCmd === 'gate') {
    console.log('');
    const gate = new PromotionGate({ maxRegressions: 0 });
    const gateResult = gate.check(result.aggregate);
    console.log(gateResult.summary);
    console.log('');
    process.exit(gateResult.passed ? 0 : 1);
  } else {
    console.log(`  Suite passed: ${result.aggregate.suitePassed}`);
    console.log('');
    process.exit(result.aggregate.suitePassed ? 0 : 1);
  }
}
else if (cmd === 'fix') {
  // Fix command - auto-fix code issues with LLM assistance
  const fixTarget = cmdArgs[0];

  console.log('');
  console.log('🔧 Sinter Fix');
  console.log('');

  // Validate and normalize confirm option
  const confirmLevel = flags.confirm || 'ask';
  if (!['auto', 'ask', 'never'].includes(confirmLevel)) {
    console.error('Error: --confirm must be one of: auto, ask, never');
    process.exit(1);
  }

  if (!fixTarget && !flags.error && !flags.testFailures && !flags.testFile) {
    printFixUsage();
    process.exit(1);
  }

  // Build fix configuration from parsed arguments
  const fixConfig = {
    target: fixTarget,
    error: flags.error,
    testFailures: flags.testFailures,
    testFile: flags.testFile,
    dryRun: flags.dryRun,
    confirm: confirmLevel,
  };

  // Determine fix type based on arguments
  let fixType = 'natural-language';
  if (flags.testFailures) {
    fixType = 'test-failures';
  } else if (flags.testFile || flags.error || (fixTarget && fixTarget.match(/\.(ts|js|tsx|jsx)$/))) {
    fixType = 'file-error';
  }

  // Import and use AutoFixOrchestrator
  const { AutoFixOrchestrator } = await import('../dist/fix/index.js');
  const llmClient = new LLMClient({ role: 'generator' });
  const orchestrator = new AutoFixOrchestrator(llmClient);

  // Build and execute the fix request
  const fixRequest = {
    type: fixType,
    target: fixTarget || flags.testFile,
    errorDescription: flags.error || fixTarget, // For natural language, use target as description
    dryRun: flags.dryRun,
    confirmLevel: confirmLevel,
  };

  console.log('Starting fix...');
  console.log('  Type:', fixType);
  console.log('  Target:', fixRequest.target || '(none)');
  console.log('');

  try {
    // LLMModeAgent's provider calls need a journal-reserved generator grant
    // (#710). Unique key per run: a repeat fix must run again, not replay.
    const { runProductionCliProviderEffect } =
      await import('../dist/cli/LiminalProductionProviderEffect.js');
    const result = await runProductionCliProviderEffect({
      idempotencyKey: 'production-fix:' + randomUUID(),
      binding: { surface: 'cli-fix', type: fixType, target: fixRequest.target ?? null },
      effect: () => orchestrator.executeFix(fixRequest),
    });

    console.log('');
    if (result.success) {
      console.log('✅ Fix completed successfully!');
      if (result.error) {
        console.log('   Notice:', result.error);
      }
    } else {
      console.log('❌ Fix failed');
      if (result.error) {
        console.log('   Error:', result.error);
      }
    }
    console.log('   Task ID:', result.taskId);
    console.log('   Changes:', result.changes.length);
    if (fixRequest.dryRun) {
      console.log('   Build passed: not run (dry run)');
      console.log('   Tests passed: not run (dry run)');
    } else {
      console.log('   Build passed:', result.buildPassed);
      console.log('   Tests passed:', result.testsPassed);
    }
    if (result.rolledBack) {
      console.log('   ⚠️  Changes were rolled back');
    }
    console.log('');

    process.exit(result.success ? 0 : 1);
  } catch (error) {
    console.error('❌ Fix execution error:', error.message);
    process.exit(1);
  }
}
else if (cmd === 'fs') {
  const subCmd = cmdArgs[0];
  const { SinterFS } = await import('../dist/fs/index.js');
  const sinterFs = SinterFS.open(process.cwd());

  try {
    if (subCmd === 'refs') {
      const refName = cmdArgs[1];
      if (!refName) {
        // List all refs
        const fs = await import('fs');
        const refsDir = path.join(process.cwd(), '.sinter', 'refs');
        if (!fs.existsSync(refsDir)) {
          console.log('No refs found.');
          process.exit(0);
        }
        const entries = fs.readdirSync(refsDir).filter(f => f.endsWith('.json'));
        console.log(`\n🔖 Refs (${entries.length}):\n`);
        for (const entry of entries) {
          console.log(`  ${entry.replace('.json', '')}`);
        }
        console.log('');
      } else {
        const ref = sinterFs.readRef(refName);
        if (!ref) {
          console.error(`Ref not found: ${refName}`);
          process.exit(1);
        }
        console.log(JSON.stringify(ref, null, 2));
      }
    } else if (subCmd === 'runs') {
      // Query EventStore for run_record events
      const projectStore = sinterFs.getProjectStore();
      const eventStore = projectStore.getEventStore();
      // EventStore has queryEvents method — use it to filter run_record events
      const events = eventStore.queryEvents({ type: 'run_record' });
      if (!events || events.length === 0) {
        console.log('No runs recorded.');
        process.exit(0);
      }
      console.log(`\n🏃 Runs (${events.length}):\n`);
      for (const event of events) {
        const data = event.payload || event.data || event;
        const runId = data.runId || 'unknown';
        const status = data.status || 'unknown';
        const project = data.project || '';
        console.log(`  ${String(runId).slice(0, 12)}…  ${String(status).padEnd(10)}  ${project}`);
      }
      console.log('');
    } else {
      console.log('Usage: sinter fs <artifacts|refs|runs>');
      console.log('  sinter fs artifacts          List all tracked artifacts');
      console.log('  sinter fs refs [name]        List refs or show specific ref');
      console.log('  sinter fs runs               List recorded runs');
      process.exit(1);
    }
  } finally {
    sinterFs.close();
  }
}
else if (cmd === 'second-judge') {
  // SECOND JUDGING PANEL (CEO 2026-08-30): completely independent re-scoring.
  // Round 1: gemini + minimax + glm-flash. Round 2: Sol (vision, API) +
  // glm-5.3 (vision, z.ai; replaced kimi-via-kilo 2026-09-01) + grok-4.5 (code, CLI).
  // Also: failure investigation for rejected generations.
  // Usage: sinter second-judge <artifact-dir>          (one piece)
  //        sinter second-judge --sweep                 (recent scored pieces)
  //        sinter second-judge --investigate           (failed generations)
  const sub = cmdArgs[0];
  const SJ_DIR = path.join(process.cwd(), '.omx', 'atelier', 'second-judge');
  fs.mkdirSync(SJ_DIR, { recursive: true });
  const sinterCfg = JSON.parse(fs.readFileSync(sinterConfigPath(), 'utf8'));
  const KILO_KEY = sinterCfg.providers?.kilo?.apiKey || '';
  const SOL_KEY = sinterCfg.roles?.evaluator?.apiKey || '';
  const JUDGE_PROMPT_FULL = (domain) => 'Judge this generative artwork using ALL senses. You see: SCREENSHOT + SOURCE CODE + METADATA (motion, domain context, round-1 scores). Score D craft, A artistic, R reliability, N novelty. Each 1-10, be strict.' + (SINTER_DOMAIN_RUBRIC[domain] ? ' DOMAIN CRITERIA — weight these: ' + SINTER_DOMAIN_RUBRIC[domain] : '') + ' Output ONLY JSON: {"D":n,"A":n,"R":n,"N":n}';

  async function judgeWithSol(imgB64, code, meta, domain) {
    const body = JSON.stringify({ model: 'gpt-5.6-sol', max_tokens: 1500, messages: [{ role: 'user', content: [
      { type: 'text', text: JUDGE_PROMPT_FULL(domain) + '\n\nSOURCE CODE:\n```\n' + (code||'').slice(0, 8000) + '\n```\n\nCONTEXT: ' + (meta||'none') },
      { type: 'image_url', image_url: { url: `data:image/png;base64,${imgB64}` } }] }] });
    const res = await fetch('http://localhost:8317/v1/chat/completions', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${SOL_KEY}` }, body });
    const r = await res.json();
    return (r.choices || [{}])[0]?.message?.content || '';
  }
  async function judgeWithGlm(imgB64, code, meta, domain) {
    // 2026-09-01 second substitution: kimi-via-kilo was dead (negative balance);
    // the LAN champion model hangs on ANY image payload (probed: 64x64 png times
    // out - the "champion has vision" note failed the law-27 transport test).
    // GLM-5.3 @ z.ai accepts anthropic-format image blocks in ~2s (probed) and
    // is MECE vs the R1 panel (R1 carries glm-5.3-FLASH, a different model;
    // family overlap noted honestly). Record key 'glm-5.3'.
    const GLM_KEY = sinterCfg.providers?.glm?.apiKey || sinterCfg.roles?.harness?.apiKey || '';
    const body = JSON.stringify({ model: 'glm-5.3', max_tokens: 4000, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: [
      { type: 'text', text: JUDGE_PROMPT_FULL(domain) + '\n\nSOURCE CODE:\n```\n' + (code||'').slice(0, 8000) + '\n```\n\nCONTEXT: ' + (meta||'none') },
      { type: 'image', source: { type: 'base64', media_type: 'image/png', data: imgB64 } }] }] });
    const res = await fetch('https://api.z.ai/api/anthropic/v1/messages', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-key': GLM_KEY, 'anthropic-version': '2023-06-01' }, body, signal: AbortSignal.timeout(180000) });
    const r = await res.json();
    const blocks = Array.isArray(r.content) ? r.content : [];
    return blocks.filter(b => b.type === 'text').map(b => b.text || '').join('');
  }
  async function judgeWithGrok(imgB64, code, meta, domain) {
    // Grok via CLI subscription (not kilo API) — reads code + visual metrics
    const { execFile } = await import('node:child_process');
    const prompt = JUDGE_PROMPT_FULL(domain) + '\n\nNOTE: You receive code + visual metrics (not the raw screenshot). Judge code craft from source, aesthetics from the visual metrics + code logic.\n\nSOURCE CODE:\n```\n' + (code||'').slice(0, 10000) + '\n```\n\nVISUAL + MOTION DATA: ' + (meta||'none') + '\n\nOutput ONLY the JSON scores.';
    return new Promise((resolve) => {
      execFile('grok', ['--model', 'grok-4.5', '-p', prompt],
        { timeout: 120000, encoding: 'utf8', env: process.env }, (e, stdout) => {
          resolve(e ? '' : stdout);
        });
    });
  }
  function parseJudgeOutput(text) {
    if (!text) return null;
    // Strip markdown code fences and reasoning text; find the JSON
    let t = text.replace(/```[a-z]*\n?/g, '').trim();
    // Try direct JSON parse first (fastest path)
    try { const j = JSON.parse(t); if (j.D !== undefined) return j; } catch {}
    // Regex fallback: find {..."D":number...}
    const m = t.match(/\{[^{}]*"D"\s*:\s*[\d.]+[^{}]*\}/);
    if (m) { try { return JSON.parse(m[0]); } catch {} }
    return null;
  }
  function collectMeta(dir, shotPath) {
    try {
      const artId = path.basename(dir);
      const cardsDir = path.join(process.cwd(), '.omx', 'atelier', 'scorecards');
      const cards = fs.readdirSync(cardsDir).filter(f => f.endsWith('.json')).sort().reverse();
      let myCard = null;
      for (const c of cards.slice(0, 50)) {
        try { const sc = JSON.parse(fs.readFileSync(path.join(cardsDir, c), 'utf8'));
          if (String(sc.artifact || '').includes(artId)) { myCard = sc; break; } } catch {}
      }
      const domain = (myCard?.domain || '').toLowerCase();
      const pngBytes = fs.readFileSync(shotPath);
      const smp = [];
      for (let bi = 100; bi < Math.min(pngBytes.length, 12000); bi += 97) smp.push(pngBytes[bi]);
      const mean = smp.reduce((a,b)=>a+b,0) / smp.length;
      const distinct = new Set(smp.slice(0, 200)).size;
      const parts = [`brightness=${mean.toFixed(0)}/255, color_diversity=${distinct}/200`];
      if (myCard) {
        if (myCard.temporal?.verdict) parts.push(`fps=${myCard.temporal.verdict.fps || '?'}, jank=${myCard.temporal.verdict.jankPercent || '?'}%`);
        if (myCard.domain) parts.push(`domain=${myCard.domain}`);
        if (myCard.ensemble) parts.push(`round1=D=${myCard.ensemble.D} A=${myCard.ensemble.A} R=${myCard.ensemble.R} N=${myCard.ensemble.N}`);
      }
      const dh = { p5:'2D canvas', three:'3D WebGL', glsl:'shaders', hydra:'video-synth', strudel:'live-coding music', tone:'Web Audio' };
      if (dh[domain]) parts.push(`typical=${dh[domain]}`);
      return { text: parts.join(', '), domain };
    } catch { return { text: 'none', domain: '' }; }
  }
  async function judgeArtifact(dir, domainHint) {
    const playable = path.join(dir, 'playable.html');
    const source = path.join(dir, 'source.txt');
    if (!fs.existsSync(playable)) return null;
    const shot = path.join('/tmp', `sj-${Date.now()}.png`);
    const { capturePlayableScreenshot } = await import('../dist/render/capturePlayableScreenshot.js');
    await capturePlayableScreenshot(playable, shot);
    const imgB64 = fs.readFileSync(shot).toString('base64');
    const code = fs.existsSync(source) ? fs.readFileSync(source, 'utf8') : '';
    const meta = collectMeta(dir, shot);
    const dom = String(domainHint || meta.domain || '').toLowerCase();
    console.log('[second-judge] judging ' + path.basename(dir).slice(0, 20) + '…');
    const [solR, glmR, grokR] = await Promise.allSettled([
      judgeWithSol(imgB64, code, meta.text, dom), judgeWithGlm(imgB64, code, meta.text, dom), judgeWithGrok(imgB64, code, meta.text, dom)
    ]);
    const results = {};
    for (const [name, r] of [['sol', solR], ['glm-5.3', glmR], ['grok', grokR]]) {
      const parsed = r.status === 'fulfilled' ? parseJudgeOutput(r.value) : null;
      results[name] = parsed || { error: r.status === 'rejected' ? String(r.reason).slice(0, 80) : 'parse-fail' };
    }
    try { fs.unlinkSync(shot); } catch (_) {}
    return results;
  }

  if (sub === 'sweep') {
    // Re-judge the most recent scored pieces (last 5 that haven't been round-2'd)
    const trendPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    if (!fs.existsSync(trendPath)) { console.error('no trend data'); process.exit(1); }
    const rows = fs.readFileSync(trendPath, 'utf8').trim().split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
    const already = new Set(fs.readdirSync(SJ_DIR).filter(f => f.endsWith('.json')).map(f => f.replace('.json', '')));
    // artifact_scored rows may record the playable FILE (.../playable.html) or the
    // artifact DIR — normalize to the dir before existence checks and id extraction.
    const artDirOf = (r) => {
      const a = String(r.artifact || '');
      return a.endsWith('.html') ? path.dirname(a) : a;
    };
    const toJudge = rows.filter(r => r.axes).slice(-10).filter(r => {
      const id = path.basename(artDirOf(r));
      return id && !already.has(id) && fs.existsSync(path.join(artDirOf(r), 'playable.html'));
    }).slice(0, 5);
    console.log(`[second-judge] sweep: ${toJudge.length} pieces to re-judge`);
    for (const r of toJudge) {
      const id = path.basename(artDirOf(r));
      try {
        const results = await judgeArtifact(artDirOf(r), r.domain);
        if (results) {
          const round1 = r.axes || '';
          const m = round1.match(/D=([\d.]+)\s+A=([\d.]+)\s+R=([\d.]+)\s+N=([\d.]+)/);
          const r1 = m ? { D: +m[1], A: +m[2], R: +m[3], N: +m[4] } : null;
          const out = { id, domain: r.domain, model: r.model, round1: r1, round1_axes: round1, round2: results,
            timestamp: new Date().toISOString() };
          fs.writeFileSync(path.join(SJ_DIR, id + '.json'), JSON.stringify(out, null, 1));
          console.log(`[second-judge] ${id.slice(0, 16)}… saved`);
        }
      } catch (e) { console.log(`[second-judge] ${id.slice(0, 16)}… failed: ${String(e).slice(0, 80)}`); }
    }
    console.log('[second-judge] sweep complete');
  } else if (sub === 'investigate') {
    // FAILURE INVESTIGATION: diagnose why generations failed
    const failsPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'failures.log');
    if (!fs.existsSync(failsPath)) { console.error('no failures.log'); process.exit(1); }
    const lines = fs.readFileSync(failsPath, 'utf8').trim().split('\n').filter(l => l.includes('Error:'));
    const recent = lines.slice(-5); // investigate last 5 failures
    console.log(`[investigate] ${recent.length} recent failures to diagnose`);
    const INVESTIGATE_PROMPT = 'You are a failure investigator for a generative-art system. Analyze this error and the code that produced it. Answer STRICT JSON: {"failure_class":"syntax|validation|render|audio|lease|provider|other","root_cause":"one sentence","preventable":true/false,"prevention":"specific deterministic fix if preventable, else empty","severity":"low|medium|high"}';
    for (const line of recent) {
      const errMatch = line.match(/Error: (.+)/);
      if (!errMatch) continue;
      const error = errMatch[1].slice(0, 300);
      console.log(`[investigate] diagnosing: ${error.slice(0, 60)}…`);
      try {
        const { execFile } = await import('node:child_process');
        const diag = await new Promise((resolve) => {
          execFile('grok', ['--model', 'grok-4.5', '-p', INVESTIGATE_PROMPT + '\n\nERROR:\n' + error],
            { timeout: 60000, encoding: 'utf8', env: process.env }, (e, stdout) => resolve(e ? '' : stdout));
        });
        const parsed = parseJudgeOutput(diag);
        if (parsed) {
          const entry = { error: error.slice(0, 200), diagnosis: parsed, timestamp: new Date().toISOString() };
          const invDir = path.join(SJ_DIR, 'investigations');
          fs.mkdirSync(invDir, { recursive: true });
          fs.writeFileSync(path.join(invDir, `inv-${Date.now()}.json`), JSON.stringify(entry, null, 1));
          console.log(`[investigate] ${parsed.failure_class}: ${parsed.root_cause?.slice(0, 60)} (preventable: ${parsed.preventable})`);
        }
      } catch (e) { console.log(`[investigate] failed: ${String(e).slice(0, 60)}`); }
    }
    console.log('[investigate] complete');
  } else if (sub && !sub.startsWith('-')) {
    // Single artifact
    const dir = path.resolve(sub);
    const results = await judgeArtifact(dir);
    if (results) {
      console.log(JSON.stringify(results, null, 1));
    } else { console.error('could not judge artifact'); process.exit(1); }
  } else {
    console.error('usage: sinter second-judge <dir> | sweep | investigate');
    process.exit(1);
  }
}
else if (cmd === 'third-judge') {
  // THIRD JUDGE TEAM (CEO order 2026-08-31): independent judges with
  // domain-customized criteria whose job is pushing each domain toward its
  // most amazing output. MECE vs R1 (gemini/minimax/glm vision) and R2
  // (Sol/kimi/grok): zero model overlap. This panel's sense is DOMAIN-EXPERT
  // CODE READING — no screenshot render (least compute), judges read source
  // + motion metrics + round-1 context against SINTER_DOMAIN_RUBRIC, and each
  // lane returns a "gap": the one system-level thing separating the piece
  // from a 9/10 in its domain (coaching signal for the lessons channel).
  // Lanes: command-code (CLI), agy (CLI — quota window may be closed; lane
  //        degrades gracefully). The two kilo lanes (deepseek-v4-flash,
  //        mimo-v2.5-pro) were REMOVED 2026-09-02: kilo balance went negative
  //        and every call 402s — dead lanes shipped error entries into the
  //        team map. CEO no-kilo-credit order; revisit at the Sep 15 review.
  // Usage: sinter third-judge <artifact-dir>
  //        sinter third-judge sweep [spread] [N]   (spread = one per domain, best first)
  const sub = cmdArgs[0];
  const TJ_DIR = path.join(process.cwd(), '.omx', 'atelier', 'third-judge');
  fs.mkdirSync(TJ_DIR, { recursive: true });
  // Loud skip log (honesty law): the panel is command-code + agy since the
  // kilo lanes died. One line per invocation, cannot be mistaken for a
  // 4-lane panel.
  console.log('[third-judge] kilo lanes (deepseek/mimo) SKIPPED — removed 2026-09-02 (kilo balance negative, every call 402s; CEO no-kilo-credit order, Sep 15 review). Panel: command-code + agy.');
  const spread = cmdArgs.includes('spread');
  const nArg = cmdArgs.slice(1).find(a => /^\d+$/.test(a));
  const COUNT = nArg ? Math.max(1, parseInt(nArg, 10)) : 5;

  async function judgeViaCli(bin, args, prompt) {
    const { execFile } = await import('node:child_process');
    return new Promise((resolve) => {
      execFile(bin, args.concat([prompt]), { timeout: 120000, encoding: 'utf8', env: process.env },
        (e, stdout, stderr) => resolve(e ? `__CLI_ERROR__: ${String(e.message || stderr || e).slice(0, 120)}` : stdout));
    });
  }
  function tjMeta(dir) {
    // Same metadata the second panel sees, minus the screenshot sample:
    // motion verdict + round-1 ensemble from the artifact's scorecard.
    try {
      const artId = path.basename(dir);
      const cardsDir = path.join(process.cwd(), '.omx', 'atelier', 'scorecards');
      const cards = fs.readdirSync(cardsDir).filter(f => f.endsWith('.json')).sort().reverse();
      let myCard = null;
      for (const c of cards.slice(0, 50)) {
        try { const sc = JSON.parse(fs.readFileSync(path.join(cardsDir, c), 'utf8'));
          if (String(sc.artifact || '').includes(artId)) { myCard = sc; break; } } catch {}
      }
      const parts = [];
      if (myCard?.temporal?.verdict) parts.push(`fps=${myCard.temporal.verdict.fps || '?'}, jank=${myCard.temporal.verdict.jankPercent || '?'}%`);
      if (myCard?.ensemble) parts.push(`round1=D=${myCard.ensemble.D} A=${myCard.ensemble.A} R=${myCard.ensemble.R} N=${myCard.ensemble.N}`);
      if (myCard?.domain) parts.push(`domain=${myCard.domain}`);
      return { text: parts.join(', ') || 'none', domain: (myCard?.domain || '').toLowerCase() };
    } catch { return { text: 'none', domain: '' }; }
  }
  async function tjJudge(dir, domainHint, domainsHint) {
    const source = path.join(dir, 'source.txt');
    const code = fs.existsSync(source) ? fs.readFileSync(source, 'utf8') : '';
    if (!code) return null;
    const meta = tjMeta(dir);
    const domain = String(domainHint || meta.domain || '').toLowerCase();
    // LAW 30 — composite domains are first-class: a layered piece carries
    // domains[] (lead first). Judge it against EVERY layer's rubric, not just
    // the primary — that's where the frontier accumulates.
    const domains = Array.isArray(domainsHint) ? domainsHint.map(d => String(d).toLowerCase()) : [];
    const rubricFor = (d) => SINTER_DOMAIN_RUBRIC[d] ? ' DOMAIN CRITERIA — weight these: ' + SINTER_DOMAIN_RUBRIC[d] : '';
    const rubricText = domains.length
      ? ' DOMAIN CRITERIA (layered piece — weight each layer): ' + domains.map(d => SINTER_DOMAIN_RUBRIC[d]).filter(Boolean).join(' || ')
      : rubricFor(domain);
    const prompt = 'You are a domain-expert judge of generative art. You read SOURCE CODE plus MOTION/VISUAL METADATA (no screenshot). Score D craft, A artistic, R reliability, N novelty. Each 1-10, be strict.' + rubricText + ' Also answer "gap": the ONE system-level thing that most separates this piece from a 9/10 in THIS domain — a coaching insight about the approach, not an edit request. Output ONLY JSON: {"D":n,"A":n,"R":n,"N":n,"gap":"..."}';
    console.log('[third-judge] judging ' + path.basename(dir).slice(0, 20) + ' domain=' + (domains.length ? domains.join('+') : (domain || '?')));
    const fullPrompt = prompt + '\n\nSOURCE CODE:\n```\n' + code.slice(0, 10000) + '\n```\n\nVISUAL + MOTION DATA: ' + meta.text + '\n\nOutput ONLY the JSON.';
    // 2026-09-02: kilo lanes (deepseek/deepseek-v4-flash, xiaomi/mimo-v2.5-pro)
    // removed from this allSettled — negative balance, all calls 402s. CEO
    // no-kilo-credit order; revisit at the Sep 15 review before re-adding.
    const [ccR, agyR] = await Promise.allSettled([
      judgeViaCli('command-code', ['-p'], fullPrompt),
      judgeViaCli('agy', ['-p'], fullPrompt),
    ]);
    const results = {};
    for (const [name, r] of [['command_code', ccR], ['agy', agyR]]) {
      const raw = r.status === 'fulfilled' ? String(r.value || '') : '';
      const cliErr = raw.startsWith('__CLI_ERROR__') ? raw.slice('__CLI_ERROR__:'.length) : null;
      const parsed = !cliErr && raw ? parseJudgeJsonLoose(raw) : null;
      results[name] = parsed || { error: cliErr || (r.status === 'rejected' ? String(r.reason).slice(0, 80) : 'parse-fail') };
    }
    return { team: results, domain, ...(domains.length ? { domains } : {}) };
  }
  function tjConsensus(team) {
    const axes = { D: [], A: [], R: [], N: [] };
    for (const v of Object.values(team)) {
      if (v && typeof v.D === 'number') { axes.D.push(v.D); axes.A.push(v.A); axes.R.push(v.R); axes.N.push(v.N); }
    }
    const out = {};
    for (const k of Object.keys(axes)) if (axes[k].length) out[k] = +(axes[k].reduce((a,b)=>a+b,0) / axes[k].length).toFixed(2);
    return Object.keys(out).length ? out : null;
  }

  if (sub === 'sweep') {
    const trendPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    if (!fs.existsSync(trendPath)) { console.error('no trend data'); process.exit(1); }
    const rows = fs.readFileSync(trendPath, 'utf8').trim().split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
    const already = new Set(fs.readdirSync(TJ_DIR).filter(f => f.endsWith('.json')).map(f => f.replace('.json', '')));
    const artDirOf = (r) => {
      const a = String(r.artifact || '');
      return a.endsWith('.html') ? path.dirname(a) : a;
    };
    const scored = rows.filter(r => r.axes).filter(r => {
      const id = path.basename(artDirOf(r));
      return id && fs.existsSync(path.join(artDirOf(r), 'source.txt'));
    });
    let toJudge;
    if (spread) {
      // One piece per domain, highest round-1 mean first: judge each domain's
      // current best — where "push toward amazing" matters most. The best is
      // chosen from ALL scored rows (rare domains' only pieces can be far back
      // in history), and already-judged bests are skipped at EXECUTION time —
      // filtering them during selection would silently demote each domain to
      // its best REMAINING piece on every re-run.
      const byDomain = {};
      for (const r of scored) {
        const m = String(r.axes).match(/D=([\d.]+)\s+A=([\d.]+)\s+R=([\d.]+)\s+N=([\d.]+)/);
        if (!m) continue;
        const mean = (+m[1] + +m[2] + +m[3] + +m[4]) / 4;
        const d = r.domain || 'unlabeled';
        if (!byDomain[d] || mean > byDomain[d].mean) byDomain[d] = { r, mean };
      }
      toJudge = Object.values(byDomain).sort((a,b) => b.mean - a.mean)
        .map(x => x.r).filter(r => !already.has(path.basename(artDirOf(r)))).slice(0, COUNT);
    } else {
      toJudge = scored.filter(r => !already.has(path.basename(artDirOf(r)))).slice(-COUNT);
    }
    console.log(`[third-judge] sweep: ${toJudge.length} pieces${spread ? ' (spread: one per domain)' : ''}`);
    for (const r of toJudge) {
      const id = path.basename(artDirOf(r));
      try {
        const out = await tjJudge(artDirOf(r), r.domain, r.domains);
        if (out) {
          const m = String(r.axes).match(/D=([\d.]+)\s+A=([\d.]+)\s+R=([\d.]+)\s+N=([\d.]+)/);
          const rec = { id, domain: out.domain || r.domain, round1: m ? { D: +m[1], A: +m[2], R: +m[3], N: +m[4] } : null,
            round1_axes: r.axes, team: out.team, consensus: tjConsensus(out.team),
            gaps: Object.values(out.team).filter(v => v && typeof v.gap === 'string' && v.gap).map(v => v.gap).slice(0, 4),
            timestamp: new Date().toISOString() };
          fs.writeFileSync(path.join(TJ_DIR, id + '.json'), JSON.stringify(rec, null, 1));
          console.log(`[third-judge] ${id.slice(0, 16)}… saved consensus=` + JSON.stringify(rec.consensus));
        }
      } catch (e) { console.log(`[third-judge] ${id.slice(0, 16)}… failed: ${String(e).slice(0, 80)}`); }
    }
    console.log('[third-judge] sweep complete');
  } else if (sub && !sub.startsWith('-')) {
    const dir = path.resolve(sub);
    const out = await tjJudge(dir);
    if (out) { console.log(JSON.stringify(out, null, 1)); }
    else { console.error('could not judge artifact (no source.txt)'); process.exit(1); }
  } else {
    console.error('usage: sinter third-judge <dir> | sweep [spread] [N]');
    process.exit(1);
  }
}
