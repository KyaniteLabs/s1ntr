else if (cmd === 'entropy') {
  // Entropy organ: the seed and phrase harvested from this project's own state (trend rows, compost heap).
  const { harvestProjectEntropy } = await import('../dist/entropy/index.js');
  const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');
  const r = await harvestProjectEntropy(resolveSinterProjectRoot());
  const src = r.sources;
  console.log(`Entropy: ${r.quality} (${r.source})`);
  console.log(`  seed:   ${r.seed}`);
  console.log(`  phrase: ${r.phrase}`);
  if (src) console.log(`  from:   ${src.events} trend rows, ${src.heapFiles} compost heap files, ${src.seeds} seeds, telemetry ${src.telemetry ? 'yes' : 'no'}`);
  if (r.quality !== 'harvested') console.log('  Nothing in this project to harvest yet: run `sinter generate` here, then try again.');
  console.log('  best-of steers its tries apart with this phrase.');
  process.exit(0);
}
else if (cmd === 'plugins') {
  // Plugins organ: what is in the plugins folder, and whether the governed gate would admit it. Nothing is executed.
  const { inspectPlugins, pinPlugin } = await import('../dist/plugins/PluginStatus.js');
  const dir = path.resolve(flags.pluginsDir || path.join(repoRoot, 'plugins'));
  const sub = cmdArgs[0] ?? 'status';
  if (sub === 'pin') {
    const id = cmdArgs[1];
    if (!id) { console.error('Usage: sinter plugins pin <id> [--plugins-dir <dir>]'); process.exit(1); }
    try { console.log(`Pinned ${id}: ${pinPlugin(dir, id)}`); process.exit(0); }
    catch (e) { console.error(`Cannot pin "${id}" in ${dir}: ${e instanceof Error ? e.message : e}`); process.exit(1); }
  }
  if (sub !== 'status') { console.error('Usage: sinter plugins <status|pin <id>> [--plugins-dir <dir>]'); process.exit(1); }
  const rows = inspectPlugins(dir);
  console.log(`Plugins in ${dir}: ${rows.length}`);
  console.log('  Execution: refused. Status checks admission only.');
  for (const r of rows) console.log(`  ${r.id.padEnd(12)} ${r.admission.padEnd(10)} domains: ${r.domains.join(', ') || '-'}`);
  if (rows.some(r => r.admission === 'unpinned')) console.log('  Pin one with: sinter plugins pin <id>');
  process.exit(0);
}
else if (cmd === 'best-of') {
  // TOURNAMENT ORGAN (wayfinder #933): best-of-N over novelty islands.
  // Generates N salted, island-varied candidates sequentially (rotation env
  // inherited by children), scores each via the sss-score ensemble, keeps the
  // best by 4-axis mean, archives the rest. Selection lifts the mean (order
  // statistics); islands widen the max (EvoDiverse anti-collapse pattern).
  const nRaw = parseInt(cmdArgs[0], 10, 10);
  const N = Number.isFinite(nRaw) && nRaw >= 2 && nRaw <= 3 ? nRaw : 2;
  const rest = Number.isFinite(nRaw) && cmdArgs.length > 1 ? cmdArgs.slice(1) : (Number.isFinite(nRaw) ? [] : cmdArgs);
  const prompt = rest.join(' ').trim();
  if (!prompt) { console.error('usage: sinter best-of [N=2..3] <prompt>'); process.exit(1); }
  const { execFileSync, spawnSync } = await import('node:child_process');
  const { runTournament } = await import('../dist/cli/BestOfTournament.js');
  const scoreFailures = new Set();
  const self = process.argv[1];
  const boLog = (line) => { try { fs.appendFileSync(path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'loop.log'), line + '\n'); } catch {} };
  boLog(`[best-of] tournament START n=${N} (failures now logged — stdout is discarded by the loop)`);
  const { harvestProjectEntropy } = await import('../dist/entropy/index.js');
  const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');
  const entropy = await harvestProjectEntropy(resolveSinterProjectRoot());
  boLog(`[best-of] entropy ${entropy.quality}/${entropy.source} seed=${entropy.seed} phrase="${entropy.phrase}"`);
  const outcome = await runTournament(prompt, N, {
    log: boLog,
    entropyPhrase: entropy.quality === 'harvested' ? entropy.phrase : undefined,
    rejectDir: path.join(process.cwd(), '.omx', 'atelier', 'tournament-rejects'),
    // Forward the explicit domain to children (meta postmortem 2026-08-31): the child re-invokes with the prompt only.
    // spawnSync, not execFileSync: exit 3 ("generated, not accepted") must reach the eligibility rule, not throw.
    runChild: (flavored, i) => {
      // Children also inherit the generation flags: they used to drop --teach (best-of
      // pieces were untaught), --max-provider-calls and -o. Each variant gets its own
      // output subdirectory so the N children cannot collide in one -o.
      const childArgs = [self];
      if (flags.domain) childArgs.push('--domain', String(flags.domain));
      if (flags.teach !== undefined) childArgs.push('--teach', String(flags.teach));
      if (flags.maxProviderCalls !== undefined) childArgs.push('--max-provider-calls', String(flags.maxProviderCalls));
      if (flags.retryUnknown) childArgs.push('--retry-unknown');
      if (flags.output) childArgs.push('--output', path.join(String(flags.output), `variant-${i + 1}`));
      if (flags.loops) childArgs.push('--loops', String(flags.loops));
      childArgs.push(flavored);
      const r = spawnSync('node', childArgs, { timeout: 900000, encoding: 'utf8', env: process.env, cwd: process.cwd(), maxBuffer: 16 * 1024 * 1024 });
      return { status: r.status, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
    },
    score: (dir) => {
      try {
        const scoreArgs = flags.domain ? [self, 'sss-score', '--domain', String(flags.domain), dir] : [self, 'sss-score', dir];
        const out = execFileSync('node', scoreArgs, { timeout: 300000, encoding: 'utf8', cwd: process.cwd(),
          env: { ...process.env, SINTER_NO_TREND_APPEND: '1' }, maxBuffer: 16 * 1024 * 1024 });
        const m = /\[sss\] ensemble D=([\d.]+) A=([\d.]+) R=([\d.]+) N=([\d.]+)/.exec(out);
        if (!m) scoreFailures.add('sss-score returned no ensemble');
        return m ? (+m[1] + +m[2] + +m[3] + +m[4]) / 4 : null;
      } catch (error) {
        const detail = /^SSS_SCORE_[A-Z_]+[^\r\n]*/m.exec(String(error.stderr ?? ''));
        scoreFailures.add(detail ? detail[0].slice(0, 400) : `sss-score failed (exit ${error.status ?? error.code ?? 'unknown'})`);
        return null;
      }
    },
  });
  if (!outcome.winner) {
    const detail = scoreFailures.size ? '; scoring failed: ' + [...scoreFailures].join(' | ') : '';
    const summary = 'BEST_OF_NO_CANDIDATES: nothing completed' + detail;
    boLog('[best-of] ' + summary);
    console.error(summary);
    process.exit(4);
  }
  const best = outcome.winner;
  const scoredCount = outcome.scoredCount;
  console.log(`[best-of] tournament of ${scoredCount}: winner mean=${best.mean.toFixed(2)}${outcome.runnerUp ? `, runner-up ${outcome.runnerUp.mean.toFixed(2)}` : ''}${outcome.diversityRanked ? ' (runner-up chosen for a different look)' : ''}`);
  boLog(`[best-of] tournament of ${scoredCount}: winner ${path.basename(best.dir)} mean=${best.mean.toFixed(2)}${outcome.runnerUp ? ` (runner-up ${outcome.runnerUp.mean.toFixed(2)})` : ''}`);
  console.log(`Saved: ${best.dir}`);
}
else if (cmd === 'data') {
  // DATA-INTEGRITY CLI SURFACE (epic #991, internalization mandate):
