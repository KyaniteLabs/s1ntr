        console.log('  By action:');
        for (const [action, count] of Object.entries(stats.byAction)) {
          console.log(`    ${action}: ${count}`);
        }
      }
      console.log('');
    } else if (subCmd === 'train') {
      const summary = await service.trainFromProject();
      console.log('');
      console.log('=== Taste Model Training ===');
      console.log(`  Archive entries: ${summary.archiveEntryCount}`);
      console.log(`  Preference events: ${summary.preferenceEventCount}`);
      console.log(`  Training pairs: ${summary.pairCount}`);

      if (!summary.persisted || !summary.weights) {
        console.error(`  Not trained: ${summary.reason ?? 'no usable preference data'}`);
        console.log('');
        exitCode = 1;
      } else {
        console.log(`  Model ref: ${summary.ref?.kind}:${summary.ref?.path}`);
        console.log(`  Pair count: ${summary.weights.pairCount}`);
        console.log(`  Training agreement: ${(summary.weights.trainingAgreement * 100).toFixed(1)}%`);
        console.log(`  Held-out evaluation: ${summary.heldOutStatus ?? 'unavailable'} (${summary.weights.heldOutPairCount ?? 0} pairs)`);
        console.log(`  Quality weight: ${summary.weights.qualityWeight.toFixed(3)}`);
        console.log(`  Axis weights: ${summary.weights.axisWeights.map((w, i) => `[${i}]${w.toFixed(3)}`).join(' ')}`);
        console.log('');
