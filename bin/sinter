  const command = JSON.parse(fs.readFileSync(path.resolve(commandPath), 'utf8'));
  const { bootstrapProductionDreamRuntime } = await import(
    '../dist/runtime-core/ProductionLiminalRuntime.js');
  const liminalRuntime = await bootstrapProductionDreamRuntime();
  try {
    const handler = action === 'transfer' ? liminalRuntime.dreamTransfer
      : action === 'activate' ? liminalRuntime.dreamActivation : liminalRuntime.compoundCreate;
    if (!handler) throw new Error(action === 'transfer' ? 'DREAM_TRANSFER_RUNTIME_NOT_CONFIGURED'
      : action === 'activate' ? 'DREAM_ACTIVATION_RUNTIME_NOT_CONFIGURED'
        : 'COMPOUND_CREATE_RUNTIME_NOT_CONFIGURED');
    const result = await handler.run(command);
    console.log(JSON.stringify(result, null, 2));
  } catch (error) {
    console.error(`Dream ${action} failed: ${error?.message || String(error)}`);
    process.exitCode = 1;
  } finally {
    await liminalRuntime.close();
  }
  if (!process.exitCode) process.exit(0);
