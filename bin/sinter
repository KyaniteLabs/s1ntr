if (cmd === 'provider') {
  const subCmd = cmdArgs[0] || 'help';
  if (subCmd === 'help' || subCmd === '--help' || subCmd === '-h') {
    printProviderHelp();
    process.exit(0);
  }
  if (subCmd === 'list') {
    printProviderList();
    process.exit(0);
  }
  if (subCmd === 'status') {
    await printProviderStatus();
    process.exit(0);
  }
  if (subCmd === 'provision-glm-coding-plan') {
    const required = [flags.seatId, flags.expiresAt, flags.ownerPrivateKey, flags.ownerPublicKey];
    if (!flags.confirmOwnerAuthorizedSubscription
      || required.some((value) => typeof value !== 'string' || !value.trim())) {
      console.error('Usage: sinter provider provision-glm-coding-plan --seat-id <id> --expires-at <iso> --owner-private-key <path> --owner-public-key <path> --confirm-owner-authorized-subscription');
      process.exit(1);
    }
    try {
      const { runGLMCodingPlanProvision } = await import('../dist/cli/GLMCodingPlanProvision.js');
      const result = runGLMCodingPlanProvision({
        confirmedOwnerAuthorizedSubscription: true, seatId: flags.seatId,
        expiresAt: flags.expiresAt, ownerPrivateKeyPath: flags.ownerPrivateKey,
        ownerPublicKeyPath: flags.ownerPublicKey,
      });
      console.log(JSON.stringify(result, null, 2));
      process.exit(0);
    } catch (error) {
      console.error('GLM coding-plan provisioning failed: ' + (error.message || error));
      process.exit(1);
    }
  }
  if (subCmd === 'set-key') {
    // cmdArgs[0] is 'set-key'; --use/--model/--base-url are parsed into flags.
    const providerKey = resolveCliProvider(cmdArgs[1]);
    const apiKey = cmdArgs[2];
    const model = flags.model;
    const baseUrl = flags.baseUrl;
    const activate = !!flags.use;
    // Local servers (ollama/lmstudio) need no key; cloud providers do.
    const keyRequired = providerKey ? CLI_PROVIDER_DEFAULTS[providerKey].requiresKey : true;
    if (!providerKey || (keyRequired && !apiKey)) {
      console.error('Usage: sinter provider set-key <provider> [<API_KEY>] [--base-url <url>] [--model <id>] [--use]');
      console.error(`Providers: ${CLI_PROVIDER_NAMES.join(', ')}`);
      console.error('  Cloud:  sinter provider set-key minimax sk-... --use');
      console.error('  Local:  sinter provider set-key ollama --base-url http://localhost:11434/v1 --model qwen2.5-coder --use');
      process.exit(1);
    }
    try {
      const r = await setProviderKey(providerKey, apiKey, { model, baseUrl, activate });
      console.log('');
      console.log(`✅ Saved ${CLI_PROVIDER_DEFAULTS[providerKey].label} provider to ${r.cfgPath}`);
      console.log(`   endpoint: ${r.baseUrl}`);
      console.log(`   model:    ${r.model}`);
      console.log(`   active:   ${r.activated ? 'yes (default — all roles inherit it)' : 'no (use --use to activate)'}`);
      console.log('');
      console.log(r.activated
        ? '   Try: sinter --prompt "a glsl aurora shader" --max-iterations 1 -o output/test'
        : `   Activate with: sinter provider set-key ${providerKey} ${keyRequired ? '<KEY> ' : ''}--use`);
      console.log('');
      process.exit(0);
    } catch (e) {
      console.error(`❌ ${e.message}`);
      process.exit(1);
    }
  }

  console.error(`Unknown provider subcommand: ${subCmd}`);
  console.error('Usage: sinter provider <help|list|status|set-key|provision-glm-coding-plan>');
  process.exit(1);
}
if (flags.recent || flags.favorites) {
  const { PromptHistory } = await import('../dist/config/PromptHistory.js');
  const history = new PromptHistory();

  if (flags.recent) {
    const recent = await history.getRecent(flags.recent);
    console.log('');
    console.log('🕐 Recent Prompts:');
    console.log('');
    if (recent.length === 0) {
      console.log('  (none yet)');
    } else {
      recent.forEach((p, i) => console.log('  ' + (i + 1) + '. ' + p));
    }
  } else {
    const favorites = await history.getFavorites();
    console.log('');
    console.log('⭐ Favorite Prompts:');
    console.log('');
    if (favorites.length === 0) {
      console.log('  (none yet)');
    } else {
      favorites.forEach((p, i) => console.log('  ' + (i + 1) + '. ' + p));
    }
  }
  console.log('');
  process.exit(0);
}

if (cmd === 'list' || cmd === 'ls') {
  const outDir = path.join(process.env.HOME || '/tmp', '.sinter', 'output');
  const artifactsDir = path.join(outDir, 'artifacts');
  // Each saved artwork is a folder with playable.html (plus source and provenance).
  const artworks = [];
  if (fs.existsSync(artifactsDir)) {
    for (const name of fs.readdirSync(artifactsDir)) {
      const playable = path.join(artifactsDir, name, 'playable.html');
      if (!fs.existsSync(playable)) continue;
      let domain = '';
      try {
        domain = JSON.parse(fs.readFileSync(path.join(artifactsDir, name, 'provenance.txt'), 'utf8')).domain || '';
      } catch { /* provenance is optional */ }
      artworks.push({ playable, domain, mtime: fs.statSync(playable).mtimeMs });
    }
  }
  artworks.sort((a, b) => b.mtime - a.mtime);
  const legacy = fs.existsSync(outDir) ? fs.readdirSync(outDir).filter(f => f.endsWith('.js')) : [];
  console.log('📁 Artworks (newest first):');
  for (const a of artworks) {
    const when = new Date(a.mtime).toISOString().slice(0, 16).replace('T', ' ');
    console.log('  ' + when + '  ' + (a.domain || '?').padEnd(8) + '  ' + a.playable);
  }
  legacy.forEach(f => console.log('  ' + path.join(outDir, f)));
  if (artworks.length === 0 && legacy.length === 0) console.log('  (none yet)');
  process.exit(0);
}

if (cmd === 'fs' && cmdArgs[0] === 'artifacts') {
  const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');
  const refsDir = path.join(resolveSinterProjectRoot(), '.sinter', 'refs');
  // Ref names contain `/` (generate/<id>, gallery/<project>/...), so they nest on disk: walk, do not just list.
  const walk = (dir) => fs.existsSync(dir)
    ? fs.readdirSync(dir, { withFileTypes: true }).flatMap(d => d.isDirectory() ? walk(path.join(dir, d.name))
      : d.name.endsWith('.json') ? [path.join(dir, d.name)] : [])
    : [];
  const files = walk(refsDir);
  if (files.length === 0) {
    console.log('No artifacts found. Governed generates record here after an accepted piece; run `sinter generate` in this directory first.');
    process.exit(0);
  }
  console.log(`\n📦 Artifacts (${files.length}):\n`);
  for (const file of files) {
    const name = path.relative(refsDir, file).replace(/\.json$/, '');
    try {
      const ref = JSON.parse(fs.readFileSync(file, 'utf-8'));
      console.log(`  ${name}  ${ref.kind}  ${ref.hash ? ref.hash.slice(0, 12) : '????'}…`);
    } catch { console.log(`  ${name}  (unreadable ref)`); }
  }
  console.log('');
  process.exit(0);
}

if (cmd === 'self-improve') {
  try {
    const subCmd = cmdArgs[0] || 'gauntlet';
    if (subCmd === 'gauntlet') {
      // --live actually EXERCISES one bounded self-improvement pass through the
      // real runtime (improve run path: LLMModeSelfImprovementRuntime ->
      // createLLMModeAgent -> writeFile/applyEdit) inside a throwaway git
      // worktree sandbox, then verifies a real edit landed and removes the
      // sandbox. Without --live the gauntlet stays the static routing-contract
      // check, which is the default CI path.
      if (flags.live === true) {
        const exitCode = await runLiveSelfImproveGauntlet();
        process.exit(exitCode);
      }

      const { runSelfImprovementGauntlet } = await import('../dist/runtime-core/SelfImprovementReflexes.js');
      const report = runSelfImprovementGauntlet();
      console.log('');
      console.log('=== Self-improvement gauntlet ===');
      console.log(`Level: ${report.level}`);
      console.log(`Prompts: ${report.passed}/${report.total} passed`);
      console.log(`Organs: ${report.organsTouched.join(', ')}`);
      console.log('');
      for (const result of report.results) {
        console.log(`${result.status === 'pass' ? 'PASS' : 'FAIL'} ${result.id}`);
        console.log(`  domain=${result.domain} focus=${result.fileHint}`);
        console.log(`  reflex=${result.recommendedReflex.nextAction} organs=${result.organs.join(', ')}`);
      }
      if (flags.output) {
        fs.writeFileSync(flags.output, `${JSON.stringify(report, null, 2)}\n`, 'utf-8');
        console.log('');
        console.log(`Wrote gauntlet report: ${flags.output}`);
      }
      console.log('');
      process.exit(report.failed === 0 ? 0 : 1);
    }
    console.error('Usage: sinter self-improve gauntlet [--live] [--provider name] [--output report.json]');
    process.exit(1);
  } catch (err) {
    console.error(`Error: ${err.message}`);
    process.exit(1);
  }
}

if (cmd === 'domains') {
  const subCmd = cmdArgs[0] || 'gauntlet';
  if (subCmd === 'gauntlet') {
    const { runCreativeDomainGauntlet } = await import('../dist/runtime-core/CreativeDomainGauntlet.js');
    const report = runCreativeDomainGauntlet(repoRoot);
    console.log('');
    console.log('=== Creative domain gauntlet ===');
    console.log(`Domains: ${report.passed}/${report.total} passed`);
    for (const domain of report.domains) {
      console.log(`${domain.status === 'pass' ? 'PASS' : 'FAIL'} ${domain.label}`);
      console.log(`  prompt=${domain.prompt}`);
      console.log(`  verification=${domain.verification}`);
    }
    if (flags.output) {
      fs.writeFileSync(flags.output, `${JSON.stringify(report, null, 2)}\n`, 'utf-8');
      console.log('');
      console.log(`Wrote domain gauntlet report: ${flags.output}`);
    }
    console.log('');
    process.exit(report.ready ? 0 : 1);
  }
  if (subCmd === 'list') {
    const { PUBLIC_MEDIUMS, EXCLUDED_MEDIUMS, MEDIUM_LABELS, mediumCountWord } = await import('../dist/types/mediumNames.js');
    console.log(`${mediumCountWord()} mediums:`);
    for (const id of PUBLIC_MEDIUMS) console.log(`  ${id}  ${MEDIUM_LABELS[id]}`);
    if (flags.verbose) for (const [id, why] of Object.entries(EXCLUDED_MEDIUMS)) console.log(`  ${id}  ${why}`);
    process.exit(0);
  }
  console.error('Usage: sinter mediums <list|check> [--output report.json]');
  process.exit(1);
}

if (cmd === 'model') {
  const subCmd = cmdArgs[0] || 'audition';
  if (subCmd === 'audition') {
    const {
      runModelAssimilationGauntlet,
      runLiveModelAssimilationAudition,
    } = await import('../dist/runtime-core/ModelAssimilationGauntlet.js');
    // --live actually INVOKES the candidate model and derives each gauntlet
    // check from its real output. Without --live (the CI/default path) the
    // audition stays a dry-run contract check that is honestly labelled
    // "unverified" — it is never reported as a real promotion pass.
    const live = flags.live === true;
    const model = cmdArgs[1] || flags.model || (live ? undefined : 'dry-run-model');

    let report;
    if (live) {
      if (!model) {
        console.error('Live audition requires a candidate model: sinter model audition <model> --live --provider <name>');
        process.exit(1);
      }
      const providerKey = resolveCliProvider(flags.provider);
      if (!providerKey) {
        console.error(`Live audition requires a known --provider (one of: ${CLI_PROVIDER_NAMES.join(', ')}).`);
        process.exit(1);
      }
      const defaults = CLI_PROVIDER_DEFAULTS[providerKey];
      const baseUrl = flags.baseUrl || defaults.baseUrl;
      const apiKey = (defaults.apiKeyEnv && process.env[defaults.apiKeyEnv]) || flags.apiKey || undefined;
      if (defaults.requiresKey && !apiKey) {
        console.error(`Live audition of ${providerKey} requires an API key (set ${defaults.apiKeyEnv}).`);
        process.exit(1);
      }
      const { LLMClient } = await import('../dist/llm/LLMClient.js');
      const client = new LLMClient({ provider: providerKey, baseUrl, model, apiKey });
      const result = await runLiveModelAssimilationAudition(client, { model, provider: providerKey });
      report = result.report;
      if (result.error) {
        console.log('');
        console.log(`Live audition error: ${result.error}`);
      }
    } else {
      const provider = flags.provider || 'dry-run';
      report = runModelAssimilationGauntlet({ model, provider });
    }

    console.log('');
    console.log('=== Model assimilation audition ===');
    console.log(`Model: ${report.model}`);
    console.log(`Provider: ${report.provider}`);
    console.log(`Source: ${report.source}${report.source === 'dry-run' ? ' (UNVERIFIED — not a real promotion pass)' : ''}`);
    console.log(`Ready: ${report.ready ? 'YES' : 'NO'}`);
    for (const check of report.checks) {
      console.log(`${check.status === 'pass' ? 'PASS' : 'FAIL'} ${check.label}: ${check.evidence}`);
    }
    console.log(`Recommendation: ${report.recommendation}`);
    if (flags.output) {
      fs.writeFileSync(flags.output, `${JSON.stringify(report, null, 2)}\n`, 'utf-8');
      console.log('');
      console.log(`Wrote model audition report: ${flags.output}`);
    }
    console.log('');
    process.exit(report.ready ? 0 : 1);
  }
  if (subCmd === 'kind') {
    const model = cmdArgs[1] || flags.model;
    if (!model) {
      console.error('Usage: sinter model kind <model>');
      process.exit(1);
    }
    const { CapabilityRegistry } = await import('../dist/llm/CapabilityRegistry.js');
    const caps = CapabilityRegistry.getCapabilities(model);
    console.log(JSON.stringify({ model, kind: CapabilityRegistry.modelKind(model),
      inputModalities: caps.inputModalities ?? ['text'], outputModalities: caps.outputModalities ?? ['text'],
      maxContextTokens: caps.maxContextTokens }, null, 2));
    process.exit(0);
  }
  if (subCmd === 'decide') {
    // Ask a seat's decision model (Liquid AI d1) typed questions directly:
    // the seat's decisionHead, or the evaluator's own model when it is d1.
    const role = flags.role || 'evaluator';
    if (!['generator', 'evaluator', 'harness', 'studio'].includes(role) || !flags.state || !flags.questions) {
      console.error('Usage: sinter model decide --state <text> --questions <file.json> [--role seat] [--image frame.png]');
      process.exit(1);
    }
    try {
      const { loadRoleConfig } = await import('../dist/config/RoleConfig.js');
      const { CapabilityRegistry } = await import('../dist/llm/CapabilityRegistry.js');
      const { DecisionModelClient } = await import('../dist/llm/DecisionModelClient.js');
      const seat = (await loadRoleConfig(process.cwd()))[role];
      const head = seat.decisionHead
        ?? (CapabilityRegistry.isDecisionModel(seat.model)
          ? { baseUrl: seat.baseUrl, model: seat.model, timeout: seat.timeout } : undefined);
      if (!head) {
        console.error(`DECISION_HEAD_MISSING: role '${role}' has no decision model; set SINTER_${role.toUpperCase()}_DECISION_MODEL and SINTER_${role.toUpperCase()}_DECISION_BASE_URL`);
        process.exit(1);
      }
      const client = new DecisionModelClient({ baseUrl: head.baseUrl, model: head.model, timeoutMs: head.timeout });
      const images = (flags.images ?? []).map(file => ({
        mimeType: /\.jpe?g$/i.test(file) ? 'image/jpeg' : 'image/png', data: fs.readFileSync(file) }));
      const questions = JSON.parse(fs.readFileSync(flags.questions, 'utf-8'));
      const result = await client.decide({ state: flags.state, questions, images });
      console.log(JSON.stringify({ role, ...result }, null, 2));
      process.exit(0);
    } catch (error) {
      console.error(error instanceof Error ? error.message : String(error));
      process.exit(1);
    }
  }
  console.error('Usage: sinter model audition <model> [--provider name] [--live] [--output report.json]');
  console.error('       sinter model kind <model>');
  console.error('       sinter model decide --state <text> --questions <file.json> [--role seat] [--image frame.png]');
  process.exit(1);
}

// `market smoke`: one real provider call that must return usable p5 code, written as the receipt `market status`
// and the release gate read (.omx/proof/live-provider-smoke.json under --repo-root, default the current directory).
if (cmd === 'market' && cmdArgs[0] === 'smoke') {
  const smokeRoot = path.resolve(flags.repoRoot || process.cwd());
  const { LLMClient } = await import('../dist/llm/LLMClient.js');
  const { buildLiveProviderSmokeReceipt, writeLiveProviderSmokeReceipt } = await import('../dist/market/LiveProviderSmokeReceipt.js');
  const { runProductionCliProviderEffect } = await import('../dist/cli/LiminalProductionProviderEffect.js');
  const started = Date.now();
  const smokeClient = new LLMClient({ role: 'generator' });
  const smokeConfig = smokeClient.getConfig();
  try {
    const answer = await runProductionCliProviderEffect({
      idempotencyKey: 'production-market-smoke:' + randomUUID(),
      binding: { surface: 'cli-market-smoke', target: smokeRoot },
      maxGeneratorAttempts: 1,
      effect: () => smokeClient.generate(
        'You write p5.js sketches. Return raw p5.js code only, with setup() and createCanvas().',
        'Create a concise p5.js sketch of a luminous Sinter signal: flowing blue-green particles on a dark background.'),
    });
    const code = answer && answer.success && typeof answer.code === 'string' ? answer.code : '';
    const artifactAbs = path.join(smokeRoot, '.omx', 'proof', 'live-provider-smoke', 'p5.js');
    fs.mkdirSync(path.dirname(artifactAbs), { recursive: true });
    fs.writeFileSync(artifactAbs, code.trim() + '\n', 'utf8');
    const receipt = buildLiveProviderSmokeReceipt({
      repoRoot: smokeRoot, provider: smokeConfig.provider || 'unknown', model: smokeConfig.model || 'unknown',
      durationMs: Date.now() - started, artifactPath: path.relative(smokeRoot, artifactAbs), code,
    });
    const receiptPath = writeLiveProviderSmokeReceipt(smokeRoot, receipt);
    console.log('Live provider smoke ' + receipt.status + ': ' + receipt.provider + '/' + receipt.model);
    for (const blocker of receipt.blockers) console.log('  blocker: ' + blocker);
    console.log('Receipt: ' + receiptPath);
    process.exit(receipt.status === 'pass' ? 0 : 1);
  } catch (error) {
    console.error('Live provider smoke blocked: ' + (error && error.message ? error.message : error));
    process.exit(1);
  }
}

if (cmd === 'release') {
  const subCmd = cmdArgs[0] || 'gate';
  if (subCmd === 'gate') {
    if (flags.dryRun === true) {
      const { runLevel6ReleaseGate } = await import('../dist/runtime-core/Level6ReleaseGate.js');
      const report = runLevel6ReleaseGate({ repoRoot: flags.repoRoot ? path.resolve(flags.repoRoot) : repoRoot, candidate: true, includeMarketReadiness: false });
      console.log(JSON.stringify(report, null, 2));
      process.exit(report.ready ? 0 : 1);
    }
    const { collectWave7RepositoryReleaseTruth, formatWave7RepositoryReleaseTruth } = await import('../dist/runtime-core/Wave7RepositoryReleaseTruth.js');
    const report = collectWave7RepositoryReleaseTruth(flags.repoRoot ? path.resolve(flags.repoRoot) : repoRoot);
    console.log(formatWave7RepositoryReleaseTruth(report));
    if (flags.output) fs.writeFileSync(flags.output, `${JSON.stringify(report, null, 2)}\n`, { encoding: 'utf8', mode: 0o600 });
    process.exit(report.ownerReleaseReady ? 0 : 1);
  }
  if (subCmd === 'receipt') {
    const { collectWave7RepositoryReleaseTruth } = await import('../dist/runtime-core/Wave7RepositoryReleaseTruth.js');
    const report = collectWave7RepositoryReleaseTruth(repoRoot);
    const target = path.resolve(flags.output || '.quality/wave-7/release/terminal-receipt.json');
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, `${JSON.stringify({ terminal: true, generatedAt: new Date().toISOString(), ...report }, null, 2)}\n`, { encoding: 'utf8', mode: 0o600 });
    console.log(JSON.stringify(report, null, 2));
    console.log(`Terminal receipt: ${path.relative(process.cwd(), target) || target}`);
    process.exit(report.ownerReleaseReady ? 0 : 1);
  }
  console.error('Usage: sinter release <gate|receipt> [--output report.json]');
  process.exit(1);
}

if (cmd === 'organism') {
  const [subCmd, sessionId, action] = cmdArgs;
  if (!['inspect', 'react', 'context'].includes(subCmd) || !sessionId) {
    console.error('Usage: sinter organism <inspect SESSION|react SESSION pin|reject|context SESSION>');
    process.exit(2);
  }
  const { OwnerReactionCausality } = await import('../dist/runtime-core/OwnerReactionCausality.js');
  const authority = new OwnerReactionCausality({ persistPath: organismStatePath() });
  const snapshot = authority.snapshot(sessionId);
  if (!snapshot.session || !snapshot.artifact) {
    console.error(`No shared Studio organism state found for session ${sessionId}`);
    process.exit(1);
  }
  if (subCmd === 'react') {
    if (action !== 'pin' && action !== 'reject') {
      console.error('Reaction must be pin or reject');
      process.exit(2);
    }
    const { randomUUID } = await import('node:crypto');
    authority.record({ ownerSessionId: sessionId, nonce: snapshot.session.nonce,
      artifactId: snapshot.artifact.artifactId, action, source: 'cli',
      eventId: `cli-${randomUUID()}`, occurredAt: new Date().toISOString() });
  }
  const current = authority.snapshot(sessionId);
  if (subCmd === 'context') {
    const latest = current.reactions.at(-1);
    if (!latest) { console.error('No owner reaction recorded for this session'); process.exit(1); }
    console.log(JSON.stringify(authority.resolveNextCreateContext(sessionId, latest.reactionDigest), null, 2));
  } else {
    console.log(JSON.stringify(current, null, 2));
  }
  process.exit(0);
}

// Release truth must be observable without initializing providers or the
// general CLI. That keeps every terminal surface byte-for-byte consistent.
if ((cmd === 'market' || cmd === 'readiness') && (!cmdArgs[0] || cmdArgs[0] === 'status')) {
  const { collectWave7RepositoryReleaseTruth, formatWave7RepositoryReleaseTruth } = await import('../dist/runtime-core/Wave7RepositoryReleaseTruth.js');
  const report = collectWave7RepositoryReleaseTruth(repoRoot);
  console.log(formatWave7RepositoryReleaseTruth(report));
  process.exit(report.ownerReleaseReady ? 0 : 2);
}

// Keep improvement scans on a narrow startup path. The general CLI initializes
// provider config, guardrails, and the Meta-Harness; scan gates need to observe
// the repo without inheriting those runtime side effects.
if (cmd === 'improve') {
  if (flags.lineage) {
    const supportedLanes = new Set(['p5-tone', 'three-shader', 'strudel-p5']);
    if (!supportedLanes.has(flags.lane)) {
      console.error('Usage: sinter improve --lineage <lineage-id> --lane <p5-tone|three-shader|strudel-p5>');
      process.exit(1);
    }
    const { resumeWave6Lineage } = await import('../dist/quality/Wave6CreativeFlywheel.js');
    const resumed = await resumeWave6Lineage({
      lineageId: flags.lineage,
      lane: flags.lane,
    });
    if (!flags.validateOnly) {
      const { spawn } = await import('node:child_process');
      const override = process.env.SINTER_WAVE6_LANE_EXECUTOR;
      if (override && process.env.SINTER_WAVE6_ALLOW_EXECUTOR_OVERRIDE !== '1') {
        console.error('Wave 6 executor override requires SINTER_WAVE6_ALLOW_EXECUTOR_OVERRIDE=1');
        process.exit(1);
      }
      const executor = override
        ?? path.join(repoRoot, 'scripts', 'quality', 'wave6-lane.mjs');
      const requestedTimeout = Number(process.env.SINTER_WAVE6_EXECUTOR_TIMEOUT_MS);
      const timeoutMs = Number.isFinite(requestedTimeout) && requestedTimeout > 0
        ? Math.min(requestedTimeout, 30 * 60_000)
        : 30 * 60_000;
      const child = spawn(process.execPath, [
        executor,
        '--lane', resumed.lane,
        '--lineage', resumed.lineageId,
        '--live',
      ], {
        cwd: repoRoot,
        env: process.env,
        stdio: 'inherit',
      });
      const exitCode = await new Promise((resolve) => {
        let settled = false;
        let timedOut = false;
        let forceTimer;
        const finish = code => {
          if (settled) return;
          settled = true;
          clearTimeout(timeout);
          clearTimeout(forceTimer);
          resolve(code);
        };
        const timeout = setTimeout(() => {
          timedOut = true;
          child.kill('SIGTERM');
          forceTimer = setTimeout(() => {
            child.kill('SIGKILL');
            finish(124);
          }, 2_000);
        }, timeoutMs);
        child.once('error', () => finish(1));
        child.once('exit', code => finish(timedOut ? 124 : (code ?? 1)));
      });
      process.exit(exitCode);
    }
    if (flags.json) {
      const { artifactCode: _artifactCode, ...validated } = resumed;
      console.log(JSON.stringify({
        ...validated,
        continuationStatus: 'validated-only',
        nextAction: `pnpm wave6:lane -- --lane ${resumed.lane}`,
      }, null, 2));
    } else {
      console.log(`Validated ${resumed.lineageId} for Wave 6 lane ${resumed.lane}.`);
      console.log('No cognitive or Autoresearch stage was executed by this command.');
      console.log(`Recipe: ${resumed.recipeDigest}`);
      console.log(`Artifact: ${resumed.artifactPath}`);
    }
    process.exit(0);
  }
  const subCmd = cmdArgs[0] || 'scan';
  const {
    collectRepositoryOpportunityEvidence,
    formatOpportunityReport,
    scanGreenSystemOpportunities,
  } = await import('../dist/improvement/OpportunityScanner.js');
  const evidence = collectRepositoryOpportunityEvidence(process.cwd());
  if (flags.gatesPassed) {
    let verification = 'ASSERTED';
    let verificationDetail = 'caller asserted after running release gates';
    if (flags.gateReceipt) {
      const receiptPath = path.resolve(flags.gateReceipt);
      if (!fs.existsSync(receiptPath)) {
        console.error(`VERIFIED gate row refused: receipt does not exist: ${receiptPath}`);
        process.exit(2);
      }
      const age = Date.now() - fs.statSync(receiptPath).mtimeMs;
      if (age < 0 || age > 24 * 60 * 60 * 1000) {
        console.error(`VERIFIED gate row refused: receipt is stale: ${receiptPath}`);
        process.exit(2);
      }
      try { JSON.parse(fs.readFileSync(receiptPath, 'utf8')); } catch {
        console.error(`VERIFIED gate row refused: receipt is not valid JSON: ${receiptPath}`);
        process.exit(2);
      }
      verification = 'VERIFIED';
      verificationDetail = `fresh gate-run receipt: ${path.relative(repoRoot, receiptPath)}`;
    }
    evidence.gates = [
      { name: 'build', status: 'pass', verification, command: 'pnpm build', detail: verificationDetail },
      { name: 'lint', status: 'pass', verification, command: 'pnpm lint', detail: verificationDetail },
      { name: 'fast tests', status: 'pass', verification, command: 'pnpm test:ci:fast', detail: verificationDetail },
      { name: 'slow tests', status: 'pass', verification, command: 'pnpm test:ci:slow', detail: verificationDetail },
    ];
  }
  const report = scanGreenSystemOpportunities(evidence);

  if (subCmd === 'scan') {
    const outputText = formatOpportunityReport(report);
    console.log('');
    console.log(outputText);
    console.log('');
    if (flags.output) {
      fs.writeFileSync(flags.output, `${JSON.stringify(report, null, 2)}\n`, 'utf-8');
      console.log(`Wrote improvement report: ${flags.output}`);
    }
    process.exit(0);
  }

  if (subCmd === 'run') {
    const proposalId = cmdArgs[1];
    if (!proposalId) {
      console.error('Usage: sinter improve run <proposal-id>');
      process.exit(1);
    }

    const proposal = report.proposals.find((item) => item.id === proposalId);
    if (!proposal) {
      console.error(`Unknown proposal: ${proposalId}`);
      console.error('Run `sinter improve scan` to see current proposals.');
      process.exit(1);
    }

    const inWorktree = isIsolatedWorktree();
    if (!inWorktree && process.env.LIMINAL_ALLOW_MAIN_WORKTREE_IMPROVE !== '1') {
      console.error('Refusing to mutate the main worktree. Create an isolated worktree, then rerun this command there.');
      console.error('Override only for deliberate local experiments: LIMINAL_ALLOW_MAIN_WORKTREE_IMPROVE=1');
      process.exit(2);
    }

    const { LLMModeSelfImprovementRuntime } = await import('../dist/runtime-core/SelfImprovementRuntime.js');
    const { LLMClient } = await import('../dist/llm/LLMClient.js');
    const runtime = new LLMModeSelfImprovementRuntime();
    const llm = new LLMClient({ role: 'harness' });
    const description = [
      `Run type: ${report.runType}`,
      `Proposal: ${proposal.title}`,
      `Category: ${proposal.category}`,
      `Evidence: ${proposal.evidence.join('; ')}`,
      `Measurable target: ${proposal.measurableTarget}`,
      `Expected verification: ${proposal.expectedVerification.join(' && ')}`,
      'Produce a reviewable patch and verification report. Do not auto-merge.',
    ].join('\n');
    const result = await runtime.run({ llm, description });

    console.log('');
    console.log('=== Self-healing run complete ===');
    console.log(`  Task: ${result.taskId}`);
    console.log(`  Model: ${result.modelName}`);
    console.log(`  Status: ${result.session.status}`);
    console.log(`  Steps: ${result.session.stepCount}`);
    console.log('');
    process.exit(result.session.status === 'success' ? 0 : 1);
  }

  console.error('Usage: sinter improve <scan|run>');
  process.exit(1);
}


if (cmd === 'report' && cmdArgs[0] === 'cognition') {
  const { CognitiveArchitectureAtlas } = await import('../dist/reporting/index.js');
  const atlas = new CognitiveArchitectureAtlas();
  console.log('');
  console.log(atlas.format(atlas.build()));
  console.log('');
  process.exit(0);
}

