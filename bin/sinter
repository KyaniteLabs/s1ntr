}
else if (cmd === 'best-of') {
  // TOURNAMENT ORGAN (wayfinder #933): best-of-N over novelty islands.
  // Generates N salted, island-varied candidates sequentially (rotation env
  // inherited by children), scores each via the sss-score ensemble, keeps the
  // best by 4-axis mean, archives the rest. Selection lifts the mean (order
  // statistics); islands widen the max (EvoDiverse anti-collapse pattern).
  const nRaw = parseInt(cmdArgs[0], 10, 10);
  const N = Number.isFinite(nRaw) && nRaw >= 2 && nRaw <= 3 ? nRaw : 2;
  const rest = Number.isFinite(nRaw) && cmdArgs.length > 1 ? cmdArgs.slice(1) : (Number.isFinite(nRaw) ? [] : cmdArgs);
  const prompt = rest.join(' ').trim();
  if (!prompt) { console.error('usage: sinter best-of [N=2..3] <prompt>'); process.exit(1); }
  const ISLANDS = [
    'restrained, precise, quietly elegant composition',
    'bold, experimental, unusual structure and palette',
    'playful, kinetic, surprising transitions',
  ];
  const { execFileSync } = await import('node:child_process');
  const self = process.argv[1];
  const boLog = (line) => { try { fs.appendFileSync(path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'loop.log'), line + '\n'); } catch {} };
  const cands = [];
  boLog(`[best-of] tournament START n=${N} (failures now logged — stdout is discarded by the loop)`);
  for (let i = 0; i < N; i++) {
    const flavored = `${prompt} — tournament variant ${i + 1}/${N}, island direction: ${ISLANDS[i % ISLANDS.length]} — variation ${Date.now()}-${i}`;
    const __t0 = Date.now();
    boLog(`[best-of] variant ${i + 1}/${N} child START (lane ${process.env.SINTER_GENERATOR_MODEL || 'config-default'})`);
    try {
      // Forward the explicit domain to children (meta postmortem 2026-08-31):
      // the child re-invokes with the prompt only, so a tournament turn on a
      // rare domain lost the loop's --domain and died in the wrong validator.
      const childArgs = flags.domain ? [self, '--domain', String(flags.domain), flavored] : [self, flavored];
      const out = execFileSync('node', childArgs, { timeout: 900000, encoding: 'utf8', env: process.env, cwd: process.cwd(), maxBuffer: 16 * 1024 * 1024 });
      boLog(`[best-of] variant ${i + 1}/${N} child done in ${Math.round((Date.now() - __t0) / 1000)}s`);
      // FIXED 2026-08-30: the CLI prints "✅ Saved: <path>/source.txt" — the old
      // /^Saved:/ line-start anchor NEVER matched it, so every completed child
      // was dropped as unsaved: 29 tournaments fleet-wide, 0 winners, every
      // child artifact orphaned unscored. Match anywhere in the line instead.
      const saved = /Saved: (\S+)/m.exec(out)?.[1]?.trim()?.replace(/\/source\.txt$/, '');
      if (saved) { cands.push(saved); console.log(`[best-of] variant ${i + 1}: saved ${saved}`); boLog(`[best-of] variant ${i + 1}/${N} saved ${path.basename(saved)}`); }
      else { const tail = out.slice(-160).replace(/\n/g, ' ⏎ '); const msg = `[best-of] variant ${i + 1}/${N} completed WITHOUT Saved line — output tail: ${tail}`; console.log(msg); boLog(msg); }
    } catch (e) { const se = e && e.stderr ? ` | stderr: ${String(e.stderr).slice(-600).replace(/\n/g, ' ⏎ ')}` : ''; const msg = `[best-of] variant ${i + 1}/${N} FAILED after ${Math.round((Date.now() - __t0) / 1000)}s: ${String((e && e.message) || e).slice(0, 300)}${se}`; console.log(msg); boLog(msg); }
  }
  const scored = [];
  for (const dir of cands) {
    try {
      const scoreArgs = flags.domain ? [self, 'sss-score', '--domain', String(flags.domain), dir] : [self, 'sss-score', dir];
      const out = execFileSync('node', scoreArgs, { timeout: 300000, encoding: 'utf8', cwd: process.cwd(),
        env: { ...process.env, SINTER_NO_TREND_APPEND: '1' }, maxBuffer: 16 * 1024 * 1024 });
      const m = /\[sss\] ensemble D=([\d.]+) A=([\d.]+) R=([\d.]+) N=([\d.]+)/.exec(out);
      if (m) { const mean = (+m[1] + +m[2] + +m[3] + +m[4]) / 4; scored.push({ dir, mean }); console.log(`[best-of] ${path.basename(dir)} mean=${mean.toFixed(2)}`); }
    } catch (e) { console.log(`[best-of] score failed for ${path.basename(dir)}: ${String(e.message || e).slice(0, 80)}`); }
  }
  if (!scored.length) { boLog('[best-of] NO CANDIDATES completed — degrading to turn failure (plain retry rescues)'); console.error('BEST_OF_NO_CANDIDATES: nothing completed'); process.exit(4); }
  scored.sort((a, b) => b.mean - a.mean);
  const best = scored[0];
  const rejectDir = path.join(process.cwd(), '.omx', 'atelier', 'tournament-rejects');
  for (const loser of scored.slice(1)) {
    try { fs.mkdirSync(rejectDir, { recursive: true }); fs.renameSync(loser.dir, path.join(rejectDir, path.basename(loser.dir))); } catch {}
  }
  console.log(`[best-of] tournament of ${scored.length}: winner mean=${best.mean.toFixed(2)}${scored[1] ? `, runner-up ${scored[1].mean.toFixed(2)}` : ''}`);
  boLog(`[best-of] tournament of ${scored.length}: winner ${path.basename(best.dir)} mean=${best.mean.toFixed(2)}${scored[1] ? ` (runner-up ${scored[1].mean.toFixed(2)})` : ''}`);
  console.log(`Saved: ${best.dir}`);
}
else if (cmd === 'data') {
  // DATA-INTEGRITY CLI SURFACE (epic #991, internalization mandate):
  // snapshot | migrate | domains | rebuild | verify | retention | selftest
  const { execFileSync } = await import('node:child_process');
  try {
    // Run the packaged script: a scripts/ folder in the user's current
    // directory (a clone, a download) must never be executed.
    const out = execFileSync('python3', [path.join(repoRoot, 'scripts', 'data', 'sinter_data.py'), ...cmdArgs],
      { encoding: 'utf8', cwd: process.cwd(), timeout: 600000, maxBuffer: 16 * 1024 * 1024 });
    console.log(out.trim());
    process.exit(0);
  } catch (e) {
    console.error(String((e && e.stdout) || (e && e.message) || e).slice(0, 2000));
    process.exit(typeof e.status === 'number' ? e.status : 1);
  }
}
else if (cmd === 'budget') {
  // Provider budget ledger: hard USD caps per endpoint (DeepInfra $40 earmark).
  const { runBudgetCommand } = await import('../dist/cli/BudgetCli.js');
  await runBudgetCommand(cmdArgs);
}
else if (cmd === 'sss-score') {
  // SPU-2.0 literal scorecard (spu-2.0-literal-v1: 0..10 axes, two distinct judges minimum): levels are COMPUTED.
  const target = cmdArgs[0];
  if (!target) { console.error('usage: sinter sss-score <playable.html | artifact-dir>'); process.exit(1); }
  const fsx = fs.statSync(target).isDirectory() ? path.join(target, 'playable.html') : target;
  const requestedDomain = String(flags.domain || '');
  const provenancePath = path.join(path.dirname(fsx), 'provenance.txt');
  if (requestedDomain && fs.existsSync(provenancePath)) {
    let recordedDomain;
    try { recordedDomain = JSON.parse(fs.readFileSync(provenancePath, 'utf8')).domain; } catch { recordedDomain = null; }
    if (recordedDomain !== requestedDomain) {
      console.error(`SSS_SCORE_DOMAIN_MISMATCH: requested ${requestedDomain}, provenance ${recordedDomain || 'unreadable'}`);
      process.exit(6);
    }
  }
  const shot = path.join('/tmp', `sss-${Date.now()}.png`);
  const { capturePlayableScreenshot } = await import('../dist/render/capturePlayableScreenshot.js');
  let browserBootEvidence = true;
  let renderTimedOut = false;
  try {
    await capturePlayableScreenshot(fsx, shot);
  } catch (error) {
    browserBootEvidence = false;
    renderTimedOut = /timeout|timed out/i.test(String(error));
    console.error(`SCORE_CAPTURE_FAILED: ${renderTimedOut ? 'timeout' : 'browser'}`);
  }
  const imgB64 = fs.existsSync(shot) ? fs.readFileSync(shot).toString('base64') : '';
  const { scoreScreenshotGate } = await import('../dist/cli/ScoreScreenshotGate.js');
  const screenshotGate = await scoreScreenshotGate(fs.existsSync(shot) ? fs.readFileSync(shot) : Buffer.alloc(0));
  if (screenshotGate === 'blank') {
    console.error('SSS_SCORE_BLANK_ARTIFACT: screenshot is missing, invalid or visually empty');
    process.exit(2);
  }
  if (screenshotGate === 'dark') {
    console.error('SSS_SCORE_DARK_ARTIFACT: decoded pixels are visually empty');
    process.exit(5);
  }
  const sinterCfg = JSON.parse(fs.readFileSync(sinterConfigPath(), 'utf8'));
  const ev = sinterCfg.roles.evaluator;
  const judgePrompt = 'Judge this generative-art screenshot under the SPU-2.0 universal scale. Score axes 0.00-10.00 (10.00=masterpiece, 8.00=excellent, 6.00=competent, 4.00=weak, 2.00=broken): D craft, A artistic values, R reliability, N novelty. Be HONEST — 7.00 means good but not exceptional. List top 3 defects (element, defect, mechanical fix). Output STRICT JSON only: {"D":n,"A":n,"R":n,"N":n,"level":"your guess","defects":[{"element":"","defect":"","fix":""}]}. Note: your level guess is IGNORED — levels are computed from gate arithmetic.';
  const { buildScorecard, parseAxes, configuredJudgeIdentity, requireIndependentJudges, judgeEyePlan } = await import('../dist/atelier/SpuScorer.js');
  // DOMAIN-IDENTITY FIX (CEO-approved 2026-09-02, comorbidity H1+H2): the old
  // private toy detector matched the ENGLISH WORD "three" anywhere in the code
  // (a GLSL comment "three depths" stamped the piece as three.js BEFORE the
  // GLSL check ran) and knew only 6 of 14 domains. Use the CANONICAL detector
  // (CodeValidator.detectDomain: all domains, GLSL ordered correctly) — and
  // prefer the explicit --domain flag the loop passes: detection is a
  // fallback, never the primary identity.
  // OMNISWEEP ADVERSARY CATCH (2026-09-02): the global arg parser already
  // consumes --domain into flags.domain BEFORE positionals reach cmdArgs —
  // reading cmdArgs made the flag dead code (always -1). Read the parsed flag.
  const explicitDomainFlag = String(flags.domain || '');
  const { CodeValidator } = await import('../dist/core/CodeValidator.js');
  const detectDomain = (code) => CodeValidator.detectDomain(code);
  // AUDIBLE GATE: a piece that produces no sound events is not music — judges
  // never score a silent artifact as a performed piece (exit 3, distinct from
  // the visual blank guard's exit 2). Domain comes from the WRAPPER's page
  // title (authoritative) — source-sniffing misfires on visual code that
  // happens to contain stack(/Tone.
  let audioEvidence = null;
  {
    const srcPath = fs.statSync(target).isDirectory() ? path.join(target, 'source.txt') : path.join(path.dirname(target), 'source.txt');
    const playableHtml = fs.readFileSync(fsx, 'utf8');
    const title = /<title>([^<]*)<\/title>/i.exec(playableHtml)?.[1] ?? '';
    const isTone = /tone\.js/i.test(title);
    const isStrudel = /strudel/i.test(title);
    if ((isTone || isStrudel) && fs.existsSync(srcPath)) {
        const { probeAudio } = await import('../dist/atelier/AudioProbe.js');
        const audio = await probeAudio(path.resolve(fsx));
        audioEvidence = audio;
        console.log(`audio-probe: ${audio.events} events (clicked=${audio.clicked}${audio.error ? ` err=${audio.error}` : ''})`);
        if (audio.events === 0) {
          console.error(`SSS_SCORE_SILENT_ARTIFACT: ${isStrudel ? 'strudel' : 'tone'} piece produced no audio events — silent code cannot score as music`);
          process.exit(3);
        }
    }
  }
  // CLASSICAL PRE-JUDGE GATE: all obvious evidence failures are rejected before
  // any network/model call. The gate is deterministic and records the artifact
  // identity used to join judge events to the scorecard.
  const { preJudgeArtifact, appendJudgeEvent } = await import('../scripts/atelier/classical-prejudge.mjs');
  const artifactSourcePath = fs.statSync(target).isDirectory() ? path.join(target, 'source.txt') : path.join(path.dirname(target), 'source.txt');
  let validatorResult = { valid: true };
  try {
    const source = fs.existsSync(artifactSourcePath) ? fs.readFileSync(artifactSourcePath, 'utf8') : fs.readFileSync(path.resolve(fsx), 'utf8');
    validatorResult = CodeValidator.validate(source, explicitDomainFlag || detectDomain(source));
  } catch { validatorResult = { valid: false }; }
  const titleForAudio = /<title>([^<]*)<\/title>/i.exec(fs.readFileSync(fsx, 'utf8'))?.[1] ?? '';
  const needsAudio = /tone\.js|strudel/i.test(titleForAudio);
  const evidenceFrames = shot && fs.existsSync(shot) ? [shot] : [];
  const artifactDir = fs.statSync(target).isDirectory() ? target : path.dirname(target);
  for (const name of ['early-frame.png', 'late-frame.png']) {
    const frame = path.join(artifactDir, name);
    if (fs.existsSync(frame)) evidenceFrames.push(frame);
  }
  const preJudge = await preJudgeArtifact({
    artifactPath: path.resolve(fsx), validatorResult,
    framePaths: evidenceFrames, browserBootEvidence, timedOut: renderTimedOut,
    audioEvidence: { required: needsAudio, present: !needsAudio || (audioEvidence?.events ?? 0) > 0 },
  });
  if (!preJudge.pass) {
    console.error(`SSS_SCORE_PREJUDGE_REJECTED: ${preJudge.reasons.join(',')}`);
    process.exit(6);
  }
  const artifactIdentityHash = preJudge.artifactIdentity;
  const scorecardId = `score-${Date.now()}-${process.pid}`;
  const trendPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
  const judges = [];
  const evaluatorVendor = configuredJudgeIdentity(ev);
  // SECOND VISION EYE (config: sssScore.secondEye; default minimax-m3 — the
  // pre-2026-11-12 hardcode). MiniMax lanes sit behind a spend wall, so the
  // ensemble must be pointable at another vision model without a code change.
  // Resolution/request shape live in scripts/atelier/second-eye.mjs (testable,
  // no build step); this block stays wiring-only.
  const { resolveSecondEye, buildSecondEyeRequest } = await import('../scripts/atelier/second-eye.mjs');
  const secondEye = resolveSecondEye(sinterCfg);
  const secondEyeVendor = configuredJudgeIdentity(secondEye);
  const glmVendor = configuredJudgeIdentity({ provider: 'glm', model: 'glm-5.3-flash' });
  const glmTextVendor = configuredJudgeIdentity({ provider: 'glm', model: 'glm-5.3' });
  // A second eye that aliases the fixed glm-flash eye collapses the plan to one
  // judge (the plan dedupes by vendor) and the run dies on INSUFFICIENT_JUDGES
  // AFTER paying for a render. Refuse it up front with the config fix.
  if (secondEyeVendor && secondEyeVendor === glmVendor) {
    console.error(`SSS_SCORE_SECOND_EYE_DUPLICATE: sssScore.secondEye resolves to ${secondEyeVendor}, the same vendor as the fixed glm-flash eye — pick a distinct vision model`); process.exit(7);
  }
  const judgeFailures = [];
  const recordJudgeFailure = (vendor, failureClass) => judgeFailures.push(`${vendor || 'unknown'}:${failureClass}`);
  const callJudge = async (vendor, operation) => {
    const callId = `${scorecardId}:${vendor}:${Date.now()}`;
    appendJudgeEvent(trendPath, { phase: 'start', call_id: callId, artifact_id: artifactIdentityHash, scorecard_id: scorecardId, judge: vendor });
    try { return await operation(); }
    finally { appendJudgeEvent(trendPath, { phase: 'end', call_id: callId, artifact_id: artifactIdentityHash, scorecard_id: scorecardId, judge: vendor }); }
  };
  const classifyJudgeError = error => error instanceof TypeError ? 'transport' : 'runtime';
  // LEGACY JUDGE EVIDENCE (2026-09-08): a failed GLM reply was discarded on
  // parse — rc4 stopped the recalculation batch and the raw body (the only
  // evidence for the thinking-starvation hypothesis) was lost. Persist the
  // private reply (body/status/model) for future diagnosis. NEVER auth
  // headers, API keys or the request image. Best-effort by design.
  const persistJudgeEvidence = (vendor, model, status, failureClass, body) => {
    try {
      const dir = path.join(process.cwd(), '.omx', 'atelier', 'judge-evidence');
      fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
      const slug = String(vendor || 'unknown').replace(/[^A-Za-z0-9._-]/g, '_');
      const file = path.join(dir, `${slug}-${Date.now()}-${process.pid}-${randomUUID()}.json`);
      const bodyBytes = Buffer.from(String(body || ''), 'utf8');
      const retainedBody = bodyBytes.length <= 65536
        ? bodyBytes.toString('utf8')
        : bodyBytes.subarray(0, 65536).toString('utf8').replace(/\uFFFD$/, '');
      const evidence = { vendor, model, httpStatus: status, failureClass,
        body: retainedBody, capturedAt: new Date().toISOString() };
      fs.writeFileSync(file, JSON.stringify(evidence, null, 2), { mode: 0o600, flag: 'wx' });
    } catch { }
  };
  const readJudgeJson = async (vendor, res, model) => {
    if (!res.ok) {
      recordJudgeFailure(vendor, `http_${res.status}`);
      let errBody = '';
      try { errBody = await res.text(); } catch {}
      persistJudgeEvidence(vendor, model, res.status, `http_${res.status}`, errBody);
      return null;
    }
    try {
      const raw = await res.text();
      if (!raw.trim()) { recordJudgeFailure(vendor, 'empty'); persistJudgeEvidence(vendor, model, res.status, 'empty', raw); return null; }
      try {
        const payload = JSON.parse(raw);
        if (!payload || typeof payload !== 'object' || Array.isArray(payload)) { recordJudgeFailure(vendor, 'parse'); persistJudgeEvidence(vendor, model, res.status, 'parse', raw); return null; }
        return { payload, raw };
      } catch { recordJudgeFailure(vendor, 'parse'); persistJudgeEvidence(vendor, model, res.status, 'parse', raw); return null; }
    } catch { recordJudgeFailure(vendor, 'transport'); return null; }
  };
  const anthropicText = payload => Array.isArray(payload?.content)
    ? payload.content.map(block => typeof block?.text === 'string' ? block.text : '').join('') : '';
  const judgeText = payload => (typeof payload?.choices?.[0]?.message?.content === 'string'
    ? payload.choices[0].message.content : '') || anthropicText(payload);
  const acceptJudge = (vendor, text, context) => {
    if (!vendor) { recordJudgeFailure('evaluator', 'identity'); return; }
    const parsed = parseAxes(text);
    if (parsed) judges.push({ vendor, axes: parsed.axes, defects: parsed.defects });
    else {
      recordJudgeFailure(vendor, 'parse');
      // A valid HTTP 200 + JSON reply can still carry nothing scoreable
      // (thinking-only content blocks, token-stop mid-JSON, refusal prose).
      // The extracted text — often '' — cannot diagnose which; retain the
      // ORIGINAL envelope. Same privacy contract as every other
      // persistJudgeEvidence call: response body only, never auth headers,
      // API keys or the request image. Best-effort by design.
      persistJudgeEvidence(vendor, context?.model, context?.status, 'parse', context?.raw);
    }
  };
  // GENERATOR-FAMILY EXCLUSION (M-20261008-14, producer-requires-verifier):
  // wave-1 ran minimax-m3 output through the hardcoded minimax eye — "2
  // distinct judges but family self-overlap" on all three art hosts. The
  // artifact's own provenance names its generator; config roles.generator is
  // the fallback. Eyes sharing the generator family are withheld when >= 2
  // distinct alternates remain; a glm-5.3 TEXT eye (frame-descriptor text
  // contract — the flagship cannot see images, probe-receipted 2026-10-08)
  // reinforces the ensemble when the minimax eye drops. Grok is key-dead
  // fleet-wide (M-20261008-01 item 2) and is deliberately NOT a third family.
  let generatorIdentity = '';
  try {
    const prov = JSON.parse(fs.readFileSync(path.join(artifactDir, 'provenance.txt'), 'utf8'));
    if (typeof prov.identity === 'string') generatorIdentity = prov.identity;
  } catch { /* artifacts without provenance fall through to config */ }
  if (!generatorIdentity) {
    const gp = sinterCfg.roles?.generator ?? {};
    if (gp.model) generatorIdentity = `${gp.provider ?? ''}/${gp.model}`;
  }
  const { CapabilityRegistry } = await import('../dist/llm/CapabilityRegistry.js');
  const evVision = CapabilityRegistry.supportsVision(String(ev.model ?? ''));
  const eyePlan = judgeEyePlan({
    // `minimaxVendor` is judgeEyePlan's historical field name for the fixed
    // second eye; it now carries the config-resolved identity. The family
    // quorum logic itself is unchanged (SpuScorer.test.ts pins it).
    generatorIdentity, evaluatorVendor, minimaxVendor: secondEyeVendor, glmFlashVendor: glmVendor,
    glmTextVendor, evaluatorVisionCapable: evVision,
  });
  const runningEyes = eyePlan.eyes.filter(eye => !eye.skipReason);
  console.log(`[sss] eye plan: generator=${generatorIdentity || 'unknown'} family=${eyePlan.generatorFamily} run=[${runningEyes.map(e => e.vendor).join(',')}] skipped=[${eyePlan.eyes.filter(e => e.skipReason).map(e => `${e.vendor}(${e.skipReason})`).join(',') || 'none'}]`);
  // TEXT-JUDGE CONTRACT: measured frame descriptor + bounded source, for
  // judges that cannot see images (glm-5.3 flagship class). The descriptor
  // is computed from the rendered PNG only — never from the artifact source —
  // so the text judge's input is explicit about what it actually receives.
  const textJudgePrompt = judgePrompt.replace(/^Judge this generative-art screenshot under/,
    'You are a TEXT-ONLY judge: no image is attached. Judge this generative artwork (input: a measured frame descriptor of the rendered frame + the artifact source) under');
  const textJudgeContext = async () => {
    let descriptor = 'frame descriptor unavailable';
    if (imgB64) {
      try {
        const { frameDescriptorText } = await import('../dist/render/FrameDescriptor.js');
        descriptor = await frameDescriptorText(Buffer.from(imgB64, 'base64'));
      } catch (e) { descriptor = `frame descriptor unavailable: ${String(e).slice(0, 90)}`; }
    }
    let sourceText = '';
    try { sourceText = fs.readFileSync(artifactSourcePath, 'utf8'); } catch { /* no source beside artifact */ }
    const boundedSource = sourceText.length > 12000
      ? `${sourceText.slice(0, 12000)}\n…[source truncated, ${sourceText.length - 12000} chars omitted]`
      : sourceText;
    return `${descriptor}\n\nArtifact source:\n${boundedSource || '(source unavailable)'}`;
  };
  for (const eye of runningEyes) {
    try {
      if (eye.lane === 'evaluator') {
        // Configured evaluator lane — wire shape and input contract follow the
        // evaluator's own vision capability (text-only judges get the
        // frame-descriptor contract; sending them pixels is a silent lie).
        const evBase = `${(ev.baseUrl || 'https://api.kilo.ai/api/gateway').replace(/\/$/, '')}`;
        let url; let headers; let body;
        if (eye.textMode) {
          const ctx = await textJudgeContext();
          if (/\/anthropic/i.test(evBase)) {
            url = `${evBase.replace(/\/v1$/, '')}/v1/messages`;
            headers = { 'x-api-key': ev.apiKey, 'anthropic-version': '2023-06-01', 'Content-Type': 'application/json' };
            body = JSON.stringify({ model: ev.model, max_tokens: 4096, messages: [{ role: 'user', content: [{ type: 'text', text: `${textJudgePrompt}\n\n${ctx}` }] }], ...(ev.reasoning ? { reasoning: ev.reasoning } : {}) });
          } else {
            url = `${evBase}/chat/completions`;
            headers = { Authorization: `Bearer ${ev.apiKey}`, 'Content-Type': 'application/json' };
            body = JSON.stringify({ model: ev.model, messages: [{ role: 'user', content: `${textJudgePrompt}\n\n${ctx}` }], max_tokens: 4096, ...(ev.reasoning ? { reasoning: ev.reasoning } : {}) });
          }
        } else {
          url = `${evBase}/chat/completions`;
          headers = { Authorization: `Bearer ${ev.apiKey}`, 'Content-Type': 'application/json' };
          body = JSON.stringify({ model: ev.model, messages: [{ role: 'user', content: [
            { type: 'text', text: judgePrompt }, { type: 'image_url', image_url: { url: `data:image/png;base64,${imgB64}` } }] }], max_tokens: 1500, ...(ev.reasoning ? { reasoning: ev.reasoning } : {}) });
        }
        const res = await callJudge(eye.vendor, () => fetch(url, { method: 'POST', headers, body }));
        const d = await readJudgeJson(eye.vendor, res, ev.model);
        if (d?.payload) acceptJudge(eye.vendor, (typeof d.payload.choices?.[0]?.message?.content === 'string' ? d.payload.choices?.[0]?.message?.content : '') || anthropicText(d.payload), { model: ev.model, status: res.status, raw: d.raw });
      } else if (eye.lane === 'fixed-text') {
        // glm-5.3 flagship text eye — probe evidence 2026-10-08: paas/v4
        // rejects images (error 1210), anthropic wire delivers an image the
        // model cannot access. It judges the descriptor + source instead.
        const gm = sinterCfg.providers.glm;
        const ctx = await textJudgeContext();
        const res = await callJudge(eye.vendor, () => fetch('https://api.z.ai/api/anthropic/v1/messages', { method: 'POST',
          headers: { 'x-api-key': gm.apiKey, 'anthropic-version': '2023-06-01', 'Content-Type': 'application/json' },
          body: JSON.stringify({ model: 'glm-5.3', max_tokens: 4096, messages: [{ role: 'user', content: [
            { type: 'text', text: `${textJudgePrompt}\n\n${ctx}` }] }] }) }));
        const d = await readJudgeJson(eye.vendor, res, 'glm-5.3');
        if (d?.payload) acceptJudge(eye.vendor, anthropicText(d.payload), { model: 'glm-5.3', status: res.status, raw: d.raw });
      } else if (eye.vendor === secondEyeVendor) {
        // Eye 2: the configurable second vision eye (sssScore.secondEye;
        // default minimax-m3). Wire shape (anthropic content blocks vs OpenAI
        // image_url) follows the configured endpoint — see second-eye.mjs.
        const request = buildSecondEyeRequest({ eye: secondEye, imageB64: imgB64, prompt: judgePrompt });
        const res = await callJudge(secondEyeVendor, () => fetch(request.url, { method: 'POST', headers: request.headers, body: request.body }));
        const d = await readJudgeJson(secondEyeVendor, res, secondEye.model);
        if (d?.payload) acceptJudge(secondEyeVendor, judgeText(d.payload), { model: secondEye.model, status: res.status, raw: d.raw });
      } else if (eye.vendor === glmVendor) {
        // Eye C: glm-5.3-flash (vision-verified on this wire, 2026-10-08) — third opinion.
        const gm = sinterCfg.providers.glm;
        const res = await callJudge(glmVendor, () => fetch('https://api.z.ai/api/anthropic/v1/messages', { method: 'POST',
          headers: { 'x-api-key': gm.apiKey, 'anthropic-version': '2023-06-01', 'Content-Type': 'application/json' },
          body: JSON.stringify({ model: 'glm-5.3-flash', max_tokens: 1500, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: [
            { type: 'image', source: { type: 'base64', media_type: 'image/png', data: imgB64 } },
            { type: 'text', text: judgePrompt }] }] }) }));
        const d = await readJudgeJson(glmVendor, res, 'glm-5.3-flash');
        if (d?.payload) acceptJudge(glmVendor, anthropicText(d.payload), { model: 'glm-5.3-flash', status: res.status, raw: d.raw });
      }
    } catch (e) { recordJudgeFailure(eye.vendor || 'unknown', classifyJudgeError(e)); }
  }
  if (!evaluatorVendor) {
    recordJudgeFailure('evaluator', 'identity');
  } else if (!runningEyes.some(eye => eye.vendor === evaluatorVendor)) {
    recordJudgeFailure(evaluatorVendor, 'duplicate_lane');
  }
  try { requireIndependentJudges(judges); } catch {
    console.error(`SSS_SCORE_INSUFFICIENT_JUDGES: ${judgeFailures.join(',') || 'unknown'}`);
    process.exit(4);
  }
  // Temporal keystone: motion/flicker/jank evidence no still can show (CEO priority 1).
  let temporal = null;
  try {
    const { probeTemporal, temporalVerdict } = await import('../dist/atelier/TemporalProbe.js');
    const probe = await probeTemporal(path.resolve(fsx), { outDir: '/tmp' });
    temporal = { ...probe, verdict: temporalVerdict(probe) };
  } catch (e) { temporal = { error: String(e).slice(0, 90) }; }
  const card = { ...buildScorecard({ artifact: target, domain: explicitDomainFlag || detectDomain(fs.readFileSync(path.resolve(fsx), 'utf8')), judges }), temporal };
  const outDir = path.join(process.cwd(), '.omx', 'atelier', 'scorecards');
  fs.mkdirSync(outDir, { recursive: true });
  const outPath = path.join(outDir, `${scorecardId}.json`);
  fs.writeFileSync(outPath, JSON.stringify(card, null, 2));
  // ELO LADDER: pair this artifact against the domain's previous-best scorecard.
  // Head-to-head on total anchored quality; ladder = the noise-proof trend.
  try {
    const { EloTable, hasScoreContract, SPU_SCORING_CONTRACT } = await import('../dist/atelier/EloTable.js');
    const contract = { scoreScale: 10, scoringContract: SPU_SCORING_CONTRACT };
    const elo = new EloTable(path.join(process.cwd(), '.omx', 'atelier', 'elo.json'), { contract });
    const domain = explicitDomainFlag || detectDomain(fs.readFileSync(path.resolve(fsx), 'utf8'));
    const prevBestPath = path.join(process.cwd(), '.omx', 'atelier', 'best-per-domain.json');
    const prevBest = fs.existsSync(prevBestPath) ? JSON.parse(fs.readFileSync(prevBestPath, 'utf8')) : {};
    const mine = (card.ensemble.D + card.ensemble.A + card.ensemble.R + card.ensemble.N) / 4;
    const prior = prevBest[domain];
    const verifiedPrior = prior && hasScoreContract(prior)
      && typeof prior.id === 'string' && prior.id.length > 0
      && typeof prior.dir === 'string' && prior.dir.length > 0
      && Number.isFinite(prior.mean) && prior.mean >= 0 && prior.mean <= 10
      && fs.existsSync(path.join(prior.dir, 'playable.html')) ? prior : null;
    const sameArtifact = verifiedPrior && (String(card.artifact) === verifiedPrior.id
      || path.resolve(fsx) === path.resolve(verifiedPrior.dir, 'playable.html'));
    if (verifiedPrior && !sameArtifact) {
      // Previous best's stored mean anchors the comparison
      const priorMean = verifiedPrior.mean;
      if (Math.abs(mine - priorMean) > 0.05) {
        if (mine > priorMean) elo.record(card.artifact, prior.id);
        else elo.record(prior.id, card.artifact);
        elo.save();
      }
    }
    // BEST-TRACKER: only a REAL improvement replaces the entry — the old
    // unconditional write made this file "last-scored-per-domain", which
    // clobbered real bests (and silently un-grounded exemplars below the
    // mean>=2.5 gate) whenever a weak artifact was scored.
    const isImprovement = !verifiedPrior || mine > verifiedPrior.mean;
    let gatePassed = false;
    if (isImprovement) {
      const { execFileSync } = await import('node:child_process');
      const gateDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sinter-promotion-'));
      try {
        const eventPath = path.join(gateDir, 'event.json');
        const incumbentPath = path.join(gateDir, 'incumbent.json');
        fs.writeFileSync(eventPath, JSON.stringify({ artifact: card.artifact, judges: judges.map(j => j.vendor), ts: new Date().toISOString() }));
        if (verifiedPrior) fs.writeFileSync(incumbentPath, JSON.stringify(verifiedPrior));
        // Packaged gate only; never a gate script from the current directory.
        const gateArgs = [path.join(repoRoot, 'scripts/atelier/promotion-gate.py'), '--candidate', outPath, '--event', eventPath, '--config', path.join(repoRoot, 'scripts/atelier/promotion-gate.json')];
        if (verifiedPrior) gateArgs.push('--incumbent', incumbentPath);
        execFileSync('python3', gateArgs, { cwd: process.cwd(), encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
        gatePassed = true;
      } catch (error) {
        const reason = error?.stderr?.trim() || String(error).slice(0, 120);
        console.log(`[sss] promotion gate blocked: ${reason}`);
      } finally {
        fs.rmSync(gateDir, { recursive: true, force: true });
      }
    }
    if (isImprovement && gatePassed) {
      if (prior && fs.existsSync(prevBestPath)) {
        fs.copyFileSync(prevBestPath, `${prevBestPath}.archive-${Date.now()}-${process.pid}`);
      }
      prevBest[domain] = { id: card.artifact, dir: path.dirname(path.resolve(fsx)), mean: mine,
        elo: elo.rating(card.artifact), scoreScale: 10, scoringContract: SPU_SCORING_CONTRACT };
      const bestTmp = `${prevBestPath}.tmp-${process.pid}`;
      fs.writeFileSync(bestTmp, JSON.stringify(prevBest, null, 2));
      fs.renameSync(bestTmp, prevBestPath);
    }
    console.log(`[sss] elo: ${domain} ladder — this ${mine.toFixed(2)} vs prior ${verifiedPrior ? verifiedPrior.mean.toFixed(2) : (prior ? 'unverified' : 'none')}`);
  } catch (e) { console.log('[sss] elo skipped:', String(e).slice(0, 80)); }
  console.log(`[sss] LEVEL: ${card.level}`);
  console.log(`[sss] ensemble D=${card.ensemble.D.toFixed(2)} A=${card.ensemble.A.toFixed(2)} R=${card.ensemble.R.toFixed(2)} N=${card.ensemble.N.toFixed(2)} | judges: ${judges.map(j=>j.vendor).join('+')} | defects: ${card.defects.length}`);
  console.log(`[sss] temporal: ${card.temporal?.verdict ? card.temporal.verdict.notes + ' score=' + card.temporal.verdict.temporalScore.toFixed(2) : (card.temporal?.error ?? 'n/a')}`);
  console.log(`[sss] scorecard: ${outPath}`);
  // SINGLE TREND WRITER (DQ C1, 2026-08-31): sss-score appends the
  // artifact_scored event itself. Previously ONLY the loop appended trend —
  // every out-of-band scorer (salvage, sweeps) wrote scorecards+elo but no
  // trend row: the salvage had 60+ pieces scored into side stores with ZERO
  // authoritative-stream rows, and its skip-if-in-trend idempotency never
  // fired (re-runs re-scored everything). The loop now appends a separate
  // generation_context event at generation time; this row keeps the legacy
  // axes-bearing shape every current reader expects.
  if (process.env.SINTER_NO_TREND_APPEND) { process.exit(0); } // selection scoring: scorecards yes, stream events no
  try {
    const osMod = await import('node:os');
    const trendPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    const scoredDomain = explicitDomainFlag || (card.domain && !['auto', ''].includes(String(card.domain)) ? card.domain : '') || detectDomain(fs.readFileSync(path.resolve(fsx), 'utf8')) || 'unknown';
    const axesStr = `D=${card.ensemble.D.toFixed(2)} A=${card.ensemble.A.toFixed(2)} R=${card.ensemble.R.toFixed(2)} N=${card.ensemble.N.toFixed(2)} | judges: ${judges.map(j=>j.vendor).join('+')} | defects: ${card.defects.length}`;
    // Structured fields (kino envelope v0.1 + law 30), EMIT-TIME ONLY — no
    // historical backfill: judges[] comes from the in-scope array (never
    // re-parsed from axesStr); domains[] from the artifact's plate when one
    // exists (plates carry domains[] since #1017), else the scalar domain.
    const judgesArr = judges.map(j => j.vendor).filter(Boolean);
    // domains[] (law 30): plates are keyed `best:<domain>` and have NO
    // artifact pointer — the honest linkage is the champion map: if this
    // artifact IS the current domain best (best-per-domain.json), inherit
    // that domain's plate domains[] (layered champions carry layers).
    let domainsArr = [scoredDomain];
    try {
      const bpdPath = path.join(process.cwd(), '.omx', 'atelier', 'best-per-domain.json');
      if (fs.existsSync(bpdPath)) {
        const bpd = JSON.parse(fs.readFileSync(bpdPath, 'utf8'));
        const best = bpd[scoredDomain] || bpd[String(scoredDomain).toLowerCase()];
        if (best && String(best.id || '') === String(card.artifact || '')) {
          const platesPath = path.join(process.cwd(), '.omx', 'atelier', 'game', 'plates.json');
          if (fs.existsSync(platesPath)) {
            const plates = JSON.parse(fs.readFileSync(platesPath, 'utf8'));
            const plate = (Array.isArray(plates) ? plates : []).find(p => p && p.key === `best:${scoredDomain}`);
            if (plate && Array.isArray(plate.domains) && plate.domains.length > 1) domainsArr = plate.domains;
          }
        }
      }
    } catch {}
    const row = {
      event_type: 'artifact_scored', schema_version: 'sinter.trend/1.2',
      scoreScale: card.scoreScale, scoringContract: card.scoringContract,
      ts: new Date().toISOString(), domain: scoredDomain, level: card.level,
      axes: axesStr, artifact: path.resolve(fsx), scorecard: path.basename(outPath),
      host: osMod.hostname(), model: process.env.SINTER_GENERATOR_MODEL || 'unknown',
      artifact_identity_sha256: artifactIdentityHash, scorecard_id: scorecardId,
      judges: judgesArr, domains: domainsArr,
      // Library verdict (CEO deep-dive 2026-09-02): read the spine-persisted
      // declaration from the artifact's provenance — the burst machinery
      // watches this field; it was never emitted before.
      libraries: (() => {
        try {
          const prov = JSON.parse(fs.readFileSync(path.join(path.dirname(path.resolve(fsx)), 'provenance.txt'), 'utf8'));
          return Array.isArray(prov.libraries) && prov.libraries.length > 0 ? prov.libraries : undefined;
        } catch { return undefined; }
      })(),
    };
    fs.mkdirSync(path.dirname(trendPath), { recursive: true });
    fs.appendFileSync(trendPath, JSON.stringify(row) + '\n');
    console.log('[sss] trend: artifact_scored event appended');
  } catch (e) { console.log('[sss] trend append failed:', String(e).slice(0, 80)); }
  // Elixis Conductor adherence (PRD 2026-09-01 item E): judge the freshly
  // scored row against the last conductor plan. Best-effort — never fatal.
  try {
    const conductorTrend = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    if (fs.existsSync(path.join(process.cwd(), '.omx', 'atelier', 'game', 'conductor-last.json')) && fs.existsSync(conductorTrend)) {
      const rows = fs.readFileSync(conductorTrend, 'utf8').split('\n').filter(l => l.trim())
        .map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
      const lastRow = rows[rows.length - 1];
      const { checkIfPending } = await import('../dist/atelier/ConductorCheck.js');
      const verdict = checkIfPending(process.cwd(), lastRow);
      if (verdict) {
        console.log(`[sss] conductor adherence: ${verdict.adhered ? 'ADHERED' : 'MISSED'} declared=${JSON.stringify(verdict.declared)}`);
      }
    }
  } catch (e) { console.log('[sss] conductor adherence: skipped —', String(e).slice(0, 80)); }
  // Elixis recipe memory + diversity telemetry (PRD item C/G): re-derive
  // learned weights and distinct-domains-per-wave from the scored stream.
  try {
    const recipesTrend = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    const rows = fs.existsSync(recipesTrend)
      ? fs.readFileSync(recipesTrend, 'utf8').split('\n').filter(l => l.trim())
          .map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean)
      : [];
    const { updateFromTrend } = await import('../dist/atelier/RecipeBook.js');
    updateFromTrend(process.cwd(), rows);
  } catch (e) { console.log('[sss] recipes update: skipped —', String(e).slice(0, 80)); }
  process.exit(0);
}
else if (cmd === 'gui-evolve') {
  // Atelier Loop (PRD v5.1): recursive compounding GUI self-improvement.
  const sub = cmdArgs[0];
  const { GuiEvolution } = await import('../dist/atelier/GuiEvolution.js');
  const { HeadlessRendererAdaptor } = await import('../dist/atelier/HeadlessRendererAdaptor.js');
  const { LlmAtelierTransports } = await import('../dist/atelier/LlmAtelierTransports.js');
  const { CycleDriver } = await import('../dist/atelier/CycleDriver.js');
  const atelierRoot = path.join(process.cwd(), '.omx', 'atelier');
  if (sub === 'report') {
    const cyclesDir = path.join(atelierRoot, 'cycles');
    const reports = fs.existsSync(cyclesDir)
      ? fs.readdirSync(cyclesDir).map(d => {
          const p = path.join(cyclesDir, d, 'report.json');
          return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : null;
        }).filter(Boolean).sort((a, b) => a.cycle - b.cycle)
      : [];
    console.log(JSON.stringify({ cycles: reports.length, trend: reports.map(r => ({
      cycle: r.cycle, accepted: r.decision?.accepted, reason: r.decision?.reason,
      coverage: r.metrics?.coverage, findability: r.metrics?.findability })), }, null, 2));
    process.exit(0);
  }
  const n = Number(flags.n ?? 1);
  // Owner-approved metered evidence for the minimax second-opinion eye (CEO 2026-08-26).
  process.env.SINTER_METERED_APPROVED_USD_CEILING ||= '5';
  process.env.SINTER_METERED_PRICE_RECEIPT_DIGEST ||= 'ee309d73a5e4d63827a978bf4883be0018f4647b8305243ad6b6dba0f8cee838';
  const { LLMClient } = await import('../dist/llm/LLMClient.js');
  const { bootstrapProductionLiminalRuntime } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
  const runtime = await bootstrapProductionLiminalRuntime();
  const governedRun = (input) => runtime.port.runResearchProviderEffect({
    idempotencyKey: input.idempotencyKey, binding: input.binding,
    identity: input.identity, role: input.role, maxTransportAttempts: 1,
    effect: input.effect });
  const sinterConfig = readSinterConfig();
  const roleCfg = (name) => sinterConfig.roles?.[name] || {};
  const brain = new LLMClient({ role: 'harness', provider: roleCfg('harness').provider,
    baseUrl: roleCfg('harness').baseUrl, apiKey: roleCfg('harness').apiKey,
    model: roleCfg('harness').model, glmCodingPlanSeat: roleCfg('harness').glmCodingPlanSeat === true });
  const generator = new LLMClient({ role: 'generator', provider: roleCfg('generator').provider,
    baseUrl: roleCfg('generator').baseUrl, apiKey: roleCfg('generator').apiKey,
    model: roleCfg('generator').model });
  const eyeA = new LLMClient({ role: 'evaluator', provider: roleCfg('evaluator').provider,
    baseUrl: roleCfg('evaluator').baseUrl, apiKey: roleCfg('evaluator').apiKey,
    model: roleCfg('evaluator').model });
  const mm = sinterConfig.providers?.minimax || {};
  const eyeB = new LLMClient({ role: 'evaluator', provider: 'minimax',
    baseUrl: (sinterConfig.fallbacks?.evaluator || [{}])[0].baseUrl || 'https://api.minimax.io/anthropic',
    apiKey: mm.apiKey, model: 'minimax-m3' });
  const transports = new LlmAtelierTransports({ brain: brain, generator, eyes: [eyeA, eyeB], governedRun });
  const renderer = new HeadlessRendererAdaptor();
  const statePath = path.join(atelierRoot, 'evolution-state.json');
  const evolution = new GuiEvolution();
  if (fs.existsSync(statePath)) evolution.load?.(fs.readFileSync(statePath, 'utf8'));
  const baseHtml = fs.existsSync(path.join(atelierRoot, 'base.html'))
    ? fs.readFileSync(path.join(atelierRoot, 'base.html'), 'utf8')
    : '<!DOCTYPE html><html><body><main data-atelier-panel="create"></main></body></html>';
  const driver = new CycleDriver({
    rootDir: process.cwd(), brain: transports.brain, generator: transports.generator,
    eyes: transports.eyes, renderer, evolution, baseHtml,
    requiredControls: ['generate', 'status', 'gallery'],
    specBrief: 'Operator instrument for a multi-model generative-art agent. Task axes: every operator verb reachable, real state visible fast, honest error states, controls findable. Not a chat app.',
  });
  const withRetry = async (op) => { try { return await op(); } catch (e) { console.log(`[atelier] transport hiccup (${String(e.message).slice(0, 90)}), retrying…`); await new Promise(r => setTimeout(r, 15000)); return await op(); } };
  for (let i = 0; i < n; i += 1) {
    const cyclesDirSeen = fs.existsSync(path.join(process.cwd(), '.omx', 'atelier', 'cycles'))
      ? fs.readdirSync(path.join(process.cwd(), '.omx', 'atelier', 'cycles')).length : 0;
    const nextCycle = cyclesDirSeen + i + 1;
    console.log(`[atelier] cycle ${nextCycle} starting`);
    const report = await withRetry(() => driver.runCycle(nextCycle));
    console.log(`[atelier] cycle ${report.cycle}: ${report.decision?.accepted ? 'ADMITTED' : 'rejected'} (${report.decision?.reason}) coverage=${report.metrics?.coverage?.toFixed(2)} findability=${report.metrics?.findability?.toFixed(2)} bonus=${report.bonusObservations}`);
  }
  if (evolution.save) fs.writeFileSync(statePath, evolution.save());
  process.exit(0);
}
else if (cmd === 'ledger') {
  // `ledger query` is handled earlier (telemetry event ledger, before config/LLM init).
  const { SinterFS } = await import('../dist/fs/index.js');
  const { TaskLedger } = await import('../dist/ledger/index.js');
  const { parseArgs, execute } = await import('../dist/ledger/cli.js');

  const sinterFs = SinterFS.open(process.cwd());
  const taskLedger = new TaskLedger(sinterFs);

  try {
    const action = parseArgs(cmdArgs);
    await execute(action, taskLedger);
    process.exit(0);
  } finally {
    sinterFs.close();
  }
