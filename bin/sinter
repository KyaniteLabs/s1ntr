else if (cmd === 'garden' && cmdArgs[0] === 'start') {
  const mode = flags.mode || 'co-create';
  if (!['assist', 'co-create', 'autopilot'].includes(mode)) {
    console.error(`Error: Invalid mode "${mode}". Use assist, co-create, or autopilot.`);
    process.exit(1);
  }
  const { AutonomousGardener } = await import('../dist/autonomy/AutonomousGardener.js');
  const { DreamQueue } = await import('../dist/dreaming/DreamQueue.js');
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks } = await import('../dist/emergence/index.js');

  const sinterFs = SinterFS.open(process.cwd());
  const hooks = new EmergenceHooks(sinterFs);
  const axes = ['order-chaos', 'sparse-dense', 'symmetry-asymmetry', 'smooth-bursty', 'static-evolving', 'harmonic-dissonant'];

  // Persist in-cycle recombinations so this long-running gardener actually feeds
  // the dream→gen loop. Unlike `garden tend` (which runs its own separate
  // enqueue pass), `garden start` had no queue at all — its dreams were computed
  // and discarded as a count. Same persist path so the self-improve cycle consumes them.
  const { resolveDreamQueuePath, resolveGardenPidPath } = await import('../dist/dreaming/dreamQueuePath.js');
  const queuePath = resolveDreamQueuePath();
  const dreamQueue = new DreamQueue({ persistPath: queuePath });
  // Let `garden stop` (another shell) find and signal this process.
  const gardenPidPath = resolveGardenPidPath();
  fs.mkdirSync(path.dirname(gardenPidPath), { recursive: true });
  fs.writeFileSync(gardenPidPath, JSON.stringify({ pid: process.pid, startedAt: new Date().toISOString() }));
  process.on('exit', () => { try { fs.rmSync(gardenPidPath, { force: true }); } catch { /* best effort */ } });
  process.on('SIGTERM', () => { process.exit(0); });
  const gardener = new AutonomousGardener({ mode, totalBudget: 100, dreamQueue });
  // Hydrate the latest taste model so interactive replay bias actually steers
  // the loop — same block `garden tend` uses. Without it isModelLoaded() is false
  // and replay silently falls back to fertility ranking (the bug B16).
  try {
    const { TasteLearningService } = await import('../dist/learning/TasteLearningService.js');
    const weights = new TasteLearningService(sinterFs).loadLatestModel();
    if (weights) { gardener.loadTasteModel(weights); console.log('  taste model: loaded — replay bias ACTIVE'); }
    else { console.log('  taste model: none persisted yet — replay bias inactive'); }
  } catch (err) {
    console.log(`  taste model: hydration unavailable (${err?.message ?? err})`);
  }
  console.log('');
  console.log(`=== Garden Started (mode: ${mode}) ===`);
  console.log(`  Budget: 100 units  Press Ctrl+C to stop`);
  console.log('');

  let cycleCount = 0;
  gardener.start(
    () => { const a = hooks.getArchive(); return a.getAllCells(); },
    () => axes,
    (result) => {
      cycleCount++;
      const breakdown = result.taskBreakdown;
      const parts = [`actions=${result.actions}`, `health=${(result.health.healthScore * 100).toFixed(0)}%`, `budget=${result.budgetRemaining}`];
      if (breakdown) parts.push(`fresh=${breakdown.fresh} replay=${breakdown.replay} dream=${breakdown.dream}`);
      if (result.dreamResults?.length) parts.push(`dreamDescs=${result.dreamResults.length}`);
      if (result.tasteAlignedCount) parts.push(`tasteAligned=${result.tasteAlignedCount}`);
      console.log(`  [Cycle ${result.cycle}] ${parts.join(' ')}`);
      if (result.stagnation.isStagnant) {
        console.log(`    ⚠ Stagnation: ${(result.stagnation.severity * 100).toFixed(0)}%`);
      }
    },
  );

  process.on('SIGINT', () => {
    gardener.stop();
    sinterFs.close();
    console.log('');
    console.log(`  Garden stopped after ${cycleCount} cycles.`);
    process.exit(0);
  });
}
else if (cmd === 'garden' && cmdArgs[0] === 'experiment') {
  // A/B two garden policies from recorded metrics: { control, treatment, results:[{variantId,metric,value}], minSamples? }.
  const file = cmdArgs[1];
  if (!file) { console.error('Usage: sinter garden experiment <experiment.json>   ({ control, treatment, results: [{ variantId, metric, value }], minSamples? })'); process.exit(1); }
  try {
    const { PolicyExperimentRunner } = await import('../dist/autonomy/PolicyExperimentRunner.js');
    const spec = JSON.parse(fs.readFileSync(path.resolve(file), 'utf8'));
    if (!spec.control?.id || !spec.treatment?.id || !Array.isArray(spec.results)) throw new Error('needs control, treatment (each with an id) and a results array');
    const runner = new PolicyExperimentRunner(spec.minSamples ? { minSamples: Number(spec.minSamples) } : {});
    const id = runner.createExperiment(spec.control, spec.treatment);
    for (const r of spec.results) runner.recordResult(id, r.variantId, r.metric, Number(r.value));
    const outcome = runner.evaluate(id);
    console.log(`Policy experiment ${spec.control.label ?? spec.control.id} vs ${spec.treatment.label ?? spec.treatment.id}: ${outcome.winner} (confidence ${outcome.confidence.toFixed(2)})`);
    console.log(outcome.recommendation);
  } catch (error) {
    console.error(`Garden experiment failed: ${error.message}`);
    process.exit(1);
  }
  process.exit(0);
}
else if (cmd === 'garden' && cmdArgs[0] === 'stop') {
  // Real control operation: read the pid file the running gardener wrote, verify it is still a sinter garden, signal it.
  const { resolveGardenPidPath } = await import('../dist/dreaming/dreamQueuePath.js');
  const { spawnSync } = await import('node:child_process');
  const pidPath = resolveGardenPidPath();
  let record = null;
  try { record = JSON.parse(fs.readFileSync(pidPath, 'utf8')); } catch { /* none */ }
  const alive = (pid) => { try { process.kill(pid, 0); return true; } catch { return false; } };
  if (!record || !Number.isInteger(record.pid) || !alive(record.pid)) {
    try { fs.rmSync(pidPath, { force: true }); } catch { /* stale */ }
    console.log('No garden is running (no live pid file).');
    process.exit(0);
  }
  const cmdline = spawnSync('ps', ['-p', String(record.pid), '-o', 'command='], { encoding: 'utf8' }).stdout || '';
  if (!/garden/.test(cmdline) || !/sinter/.test(cmdline)) {
    console.error(`Refusing to signal pid ${record.pid}: it is not a sinter garden process.`);
    process.exit(1);
  }
  process.kill(record.pid, 'SIGINT');
  for (let i = 0; i < 50 && alive(record.pid); i += 1) await new Promise((r) => setTimeout(r, 100));
  if (alive(record.pid)) { console.error(`Garden pid ${record.pid} did not stop within 5s.`); process.exit(1); }
  console.log(`Garden pid ${record.pid} stopped.`);
  process.exit(0);
}
else if (cmd === 'garden' && cmdArgs[0] === 'tend') {
  // Bounded, non-interactive gardener pass for daemons/cron: runs cycles until
  // the budget is exhausted, then persists the dream plan so the next
  // self-improve cycle can generate from it (gardener → dreams → generations).
  const budget = Math.max(10, parseInt(cmdArgs[1] || '100', 10) || 100);
  const { AutonomousGardener } = await import('../dist/autonomy/AutonomousGardener.js');
  const { DreamPlanner } = await import('../dist/dreaming/DreamPlanner.js');
  const { DreamQueue } = await import('../dist/dreaming/DreamQueue.js');
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks } = await import('../dist/emergence/index.js');

  const sinterFs = SinterFS.open(process.cwd());
  try {
    const hooks = new EmergenceHooks(sinterFs);
    const axes = ['order-chaos', 'sparse-dense', 'symmetry-asymmetry', 'smooth-bursty', 'static-evolving', 'harmonic-dissonant'];
    const cells = hooks.getArchive().getAllCells();
    const gardener = new AutonomousGardener({ mode: 'co-create', totalBudget: budget });

    console.log('');
    console.log(`=== Garden Tend (bounded, budget ${budget}, ${cells.length} cells) ===`);
    // Hydrate the latest taste model so replay bias actually steers the
    // autonomous loop: it trains hourly, but without this load isModelLoaded()
    // is false in every daemon tend and the bias silently no-ops (the TUI
    // bridge was the only consumer).
    try {
      const { TasteLearningService } = await import('../dist/learning/TasteLearningService.js');
      const weights = new TasteLearningService(sinterFs).loadLatestModel();
      if (weights) { gardener.loadTasteModel(weights); console.log('  taste model: loaded — replay bias ACTIVE'); }
      else { console.log('  taste model: none persisted yet — replay bias inactive'); }
    } catch (err) {
      console.log(`  taste model: hydration unavailable (${err?.message ?? err})`);
    }
    let cycles = 0;
    let lastHealth = 0;
    let result;
    while ((result = gardener.cycle(cells, axes)) !== null) {
      cycles++;
      lastHealth = result.health.healthScore;
      const stag = result.stagnation.isStagnant ? `  stagnation=${(result.stagnation.severity * 100).toFixed(0)}%` : '';
      console.log(`  [cycle ${result.cycle}] actions=${result.actions} health=${(result.health.healthScore * 100).toFixed(1)}% budget=${result.budgetRemaining}${stag}`);
    }

    // Persist the dream plan from the same planner the gardener uses. The planner
    // is told which pairings are already in the queue (queued/completed/failed) so
    // it proposes FRESH recombinations from the unexplored pair space instead of
    // re-proposing completed pairs — which dedup to +0 and starve dreaming.
    const { resolveDreamQueuePath } = await import('../dist/dreaming/dreamQueuePath.js');
    const queuePath = resolveDreamQueuePath();
    const dreams = new DreamQueue({ persistPath: queuePath });
    const seen = new Set(dreams.getTasks().map((t) => `${t.strategy}:${t.sources.map((s) => s.id).sort().join('+')}`));
    // Reclaim queue slots held by FINISHED dreams (completed/failed). Without this
    // the queue saturates at maxQueueSize (50) with history and enqueue is blocked
    // forever (dreams: +0), so the gardener can never feed new recombinations to
    // the loop. `seen` was captured first so this plan still avoids re-proposing
    // already-tried pairings.
    const pruned = dreams.prune();
    const plan = new DreamPlanner().plan(cells, axes, { excludeKeys: seen });
    let enqueued = 0;
    for (const t of plan.tasks) {
      if (dreams.enqueue(t.strategy, t.sources, t.priority)) { enqueued++; }
    }
    if (pruned > 0) console.log(`  pruned ${pruned} finished dream(s) to free queue slots`);
    const status = dreams.getStatus();
    console.log(`  done: cycles=${cycles} finalHealth=${(lastHealth * 100).toFixed(1)}%`);
    console.log(`  dreams: +${enqueued} new (queued=${status.queued} completed=${status.completed}) → ${queuePath}`);
  } finally {
    sinterFs.close();
  }
  process.exit(0);
}
else if (cmd === 'ship' && (cmdArgs[0] === 'garden' || cmdArgs[0] === 'rollback')) {
  // Garden promotion tier, backed by an on-disk PolicyChangeManifest
  // (.sinter/garden/policy-manifest.json, or SINTER_GARDEN_MANIFEST_PATH).
  const { mutatePolicyManifest, loadPolicyManifest, policyManifestPath } = await import('../dist/release/PolicyManifestStore.js');
  const { GardenPromotionGate } = await import('../dist/release/GardenPromotionGate.js');
  const { GardenRollbackController } = await import('../dist/release/GardenRollbackController.js');
  const { CreativeRuntimeCandidateBuilder } = await import('../dist/release/CreativeRuntimeCandidateBuilder.js');
  const manifestFile = policyManifestPath();
  const parseMetrics = (text) => {
    const out = {};
    for (const pair of String(text || '').split(',').filter(Boolean)) {
      const [k, v] = pair.split('=');
      const n = Number(v);
      if (!k || v === undefined || v === '' || !Number.isFinite(n)) throw new Error(`Bad metric "${pair}" (expected name=number)`);
      out[k] = n;
    }
    return out;
  };
  const shipArgs = leafArgv();
  const flag = (name) => { const i = shipArgs.indexOf(name); return i >= 0 ? shipArgs[i + 1] : undefined; };
  const positional = shipArgs.slice(1).filter((a, i, arr) => !a.startsWith('--') && !(i > 0 && arr[i - 1].startsWith('--')));
  const usage = () => {
    console.error('Usage:');
    console.error('  sinter ship garden                                   list tracked policy changes');
    console.error('  sinter ship garden stage <policyKind> <description> --before name=n[,name=n]');
    console.error('  sinter ship garden promote <changeId> --after name=n[,name=n]   (gated: blocks on regressions)');
    console.error('  sinter ship rollback <changeId> [--reason text]');
    console.error('  sinter ship rollback --since <ISO timestamp> [--reason text]');
    process.exit(2);
  };
  try {
    if (cmdArgs[0] === 'garden') {
      const sub = positional[0];
      if (!sub) {
        const manifest = await loadPolicyManifest(manifestFile);
        const all = manifest.getAll();
        if (all.length === 0) console.log(`No policy changes tracked (${manifestFile}).`);
        for (const r of all) console.log(`${r.id}  ${r.status.padEnd(11)} ${r.policyKind}  ${r.changeDescription}`);
      } else if (sub === 'stage') {
        const [, kind, ...desc] = positional;
        if (!kind || desc.length === 0) usage();
        const rec = await mutatePolicyManifest((m) => m.stage(kind, desc.join(' '), parseMetrics(flag('--before'))), manifestFile);
        console.log(`Staged ${rec.id} (${kind}). Promote with: sinter ship garden promote ${rec.id} --after name=n`);
      } else if (sub === 'promote') {
        const id = positional[1];
        if (!id) usage();
        const after = parseMetrics(flag('--after'));
        const outcome = await mutatePolicyManifest((m) => {
          const rec = m.getRecord(id);
          if (!rec) return { ok: false, summary: `Change ${id} not found` };
          if (rec.status !== 'staged') return { ok: false, summary: `Change ${id} is ${rec.status}, not staged` };
          // Judge the change as it would look once promoted, before touching the manifest.
          const provisional = { ...rec, metricsAfter: after, status: 'promoted' };
          const candidate = new CreativeRuntimeCandidateBuilder().build([provisional], rec.changeDescription);
          const verdict = new GardenPromotionGate().check(candidate);
          if (!verdict.passed) return { ok: false, summary: verdict.summary, regressions: verdict.regressions };
          m.promote(id, after);
          return { ok: true, summary: verdict.summary, improvements: verdict.improvements };
        }, manifestFile);
        if (!outcome.ok) {
          console.error(`Not promoted: ${outcome.summary}`);
          for (const r of outcome.regressions || []) console.error(`  regression ${r}`);
          process.exit(1);
        }
        console.log(`Promoted ${id}: ${outcome.summary}`);
        for (const i of outcome.improvements || []) console.log(`  improved ${i}`);
      } else {
        usage();
      }
    } else {
      const reason = flag('--reason') || 'manual rollback via sinter ship rollback';
      const since = flag('--since');
      const id = positional[0];
      if (!id && !since) usage();
      const results = await mutatePolicyManifest((m) => {
        const controller = new GardenRollbackController(m);
        return since ? controller.rollbackSince(since, reason) : [controller.rollback(id, reason)];
      }, manifestFile);
      let failed = 0;
      for (const r of results) {
        if (r.rolledBack) console.log(`Rolled back ${r.changeId}${r.rollbackTargetId ? ` (restore ${r.rollbackTargetId})` : ''}: ${r.reason}`);
        else { failed++; console.error(`Not rolled back ${r.changeId}: ${r.reason}`); }
      }
      if (results.length === 0) { console.error('No promoted changes match.'); process.exit(1); }
      if (failed > 0) process.exit(1);
    }
  } catch (err) {
    console.error(`ship failed: ${err instanceof Error ? err.message : String(err)}`);
    process.exit(1);
  }
}
else if (cmd === 'demo' && cmdArgs[0] === 'creative-codex') {
  const { DemoScenarioRunner } = await import('../dist/product/DemoScenarioRunner.js');

  const runner = new DemoScenarioRunner();
  const result = runner.runCreativeCodex();

  console.log('');
  console.log('=== Creative Codex Demo ===');
  console.log(`  Scenario: ${result.scenarioName}`);
  console.log(`  Steps: ${result.totalSteps}  Passed: ${result.passed}  Duration: ${result.durationMs}ms`);
  console.log('');

  for (const step of result.steps) {
    console.log(`  ${step.step}. ${step.label}`);
    console.log(`     ${step.description}`);
    const keys = Object.keys(step.data);
    if (keys.length > 0) {
      const summary = keys.map(k => `${k}=${JSON.stringify(step.data[k])}`).join(', ');
      console.log(`     Data: ${summary}`);
    }
  }
  console.log('');
  process.exit(0);
}
else if (cmd === 'prompt' && cmdArgs[0] === 'synthesize') {
  const inputPath = flags.input;
  if (!inputPath) {
    console.error('Usage: sinter prompt synthesize --input <graph.json> [--output <output.md>]');
    process.exit(1);
  }

  const { synthesizePrompt } = await import('../dist/nodeprompt/index.js');

  try {
    const graphJson = fs.readFileSync(inputPath, 'utf-8');
    const graph = JSON.parse(graphJson);
    if (!graph.nodes || !graph.edges || !graph.originalPrompt) {
      console.error('Graph JSON must contain: { nodes, edges, originalPrompt }');
      process.exit(1);
    }

    const result = synthesizePrompt(graph.originalPrompt, graph.nodes, graph.edges);
    const outputPath = flags.output;
    if (outputPath) {
      fs.writeFileSync(outputPath, result);
      console.log(`Synthesized prompt written to: ${outputPath}`);
    } else {
      console.log(result);
    }
    process.exit(0);
  } catch (err) {
    console.error('Prompt synthesis failed:', err.message);
    process.exit(1);
  }
}
else if (cmd === 'taste') {
  // `taste` requires a subcommand; print usage instead of the generic
  // "Unknown command" error (which falsely implies `taste` is not a command).
  console.error('Usage: sinter taste <train|eval|ingest>');
  process.exit(1);
}
else if (cmd === 'dream') {
  console.error('Usage: sinter dream <run>');
  process.exit(1);
}
else if (cmd === 'demo') {
  console.error('Usage: sinter demo <creative-codex>');
  process.exit(1);
}

else if (cmd === 'image' && (cmdArgs[0] === 'validate' || cmdArgs[0] === 'attach')) {
  try {
    await import('../dist/media/ImageAttachment.js').then(async (m) => {
      const imgPath = cmdArgs[1];
      if (!imgPath) {
        console.error('usage: sinter image validate <path>');
        process.exit(2);
      }
      const source = leafArgv().includes('--studio') ? 'studio' : 'cli';
      let att;
      if (source === 'studio') {
        const studio = await import('../dist/media/studioImageUpload.js');
        att = studio.acceptStudioImageUpload({ filePath: imgPath }, { cwd: process.cwd() }).attachment;
      } else {
        att = m.loadImageAttachment(imgPath, { source: 'cli', role: 'reference', allowRoots: [repoRoot, process.cwd()] });
      }
      console.log(JSON.stringify(m.attachmentReceipt(att, { cli: true }), null, 2));
    }).catch(async (e) => {
      const missingBuild = e?.code === 'ERR_MODULE_NOT_FOUND' && String(e.message).includes('/dist/media/');
      console.error(missingBuild
        ? `image validate requires pnpm build (dist/media/ImageAttachment.js): ${e.message}`
        : `image validate: ${e?.message || e}`);
      process.exit(1);
    });
  } catch (err) {
    console.error(err);
    process.exit(1);
  }
}
else if ((cmd === 'mece' || cmd === 'rotation') && !fs.existsSync(path.join(repoRoot, 'scripts', cmd, 'cli.mjs'))) {
  // npm ships only scripts/packaging; these tools live in the source repo.
  console.error(`sinter ${cmd} is only available in a source checkout of S1NTR, not in the npm package.`);
  process.exit(2);
}
else if (cmd === 'mece') {
  try {
    const { spawnSync } = await import('node:child_process');
    const r = spawnSync(process.execPath, [path.join(repoRoot, 'scripts/mece/cli.mjs'), ...leafArgv()], {
      stdio: 'inherit',
      cwd: repoRoot,
      env: process.env,
    });
    process.exit(r.status ?? 1);
  } catch (err) {
    console.error(`mece error: ${err instanceof Error ? err.message : err}`);
    process.exit(1);
  }
}
else if (cmd === 'rotation') {
  // Standing per-seat batteries for model rotation (#401). Script lives under
  // scripts/rotation and reuses audition-379 helpers — not a clone.
  try {
    const { main: rotationMain } = await import('../scripts/rotation/cli.mjs');
    const code = await rotationMain(leafArgv(), {
      model: flags.model || null,
      dryRun: flags.dryRun === true,
      live: flags.live === true,
      mock: process.env.LIMINAL_CI_FAST === '1' && flags.live !== true,
    });
    process.exit(code ?? 0);
  } catch (err) {
    console.error(`rotation error: ${err instanceof Error ? err.message : err}`);
    process.exit(1);
  }
}

else {
  console.error('');
  if (cmd) {
    console.error(`Unknown command or subcommand: ${[cmd, ...cmdArgs].join(' ')}`);
    console.error('Run "sinter --help" to see available commands and subcommands.');
  } else {
    console.error('Run "sinter --help" for usage, or: sinter "your idea"');
  }
  process.exit(1);
}
