      console.error('No preference data available. Pin, favorite, or compare artifacts first.');
      process.exit(1);
    }

    console.log(`Building taste model from ${dataset.pairs.length} preference pairs (${dataset.stats.uniqueArtifacts} artifacts)...`);

    const trainer = new TasteModelTrainer();
    const model = trainer.train(dataset.pairs);

    console.log('');
    console.log('=== Taste Model Training ===');
    console.log(`  Pairs: ${model.pairCount}`);
    console.log(`  Training agreement: ${(model.trainingAgreement * 100).toFixed(1)}%`);
