if (cmd === 'judgment' && cmdArgs[0] === 'compare') {
  if (!flags.input) {
    console.error('Usage: sinter judgment compare --input <rendered-set.json>');
    process.exit(1);
  }
  try {
    const { LLMClient } = await import('../dist/llm/LLMClient.js');
    const { compareRenderedJudgment } = await import('../dist/learning/RenderedJudgmentComparison.js');
    const inputPath = path.resolve(flags.input);
    const inputRoot = path.dirname(inputPath);
    const input = JSON.parse(fs.readFileSync(inputPath, 'utf8'));
    const candidates = input.candidates.map((candidate) => ({
      id: candidate.id,
      evidenceDigest: candidate.evidenceDigest,
      early: { mimeType: 'image/png', dataBase64: fs.readFileSync(path.resolve(inputRoot, candidate.earlyPath)).toString('base64') },
      late: { mimeType: 'image/png', dataBase64: fs.readFileSync(path.resolve(inputRoot, candidate.latePath)).toString('base64') },
    }));
    // One product mechanism: the cycle grant installs a per-call evaluator scope; compareRenderedJudgment's
    // provider call runs through evaluatorCall, so it gets its own receipted evaluator grant.
    const { runProductionCliCycleEffect } = await import('../dist/cli/LiminalProductionProviderEffect.js');
    const evaluator = new LLMClient({ role: 'evaluator' });
    const result = await runProductionCliCycleEffect({
      idempotencyKey: `judgment-compare-${Date.now()}-${process.pid}`,
      binding: { surface: 'judgment-compare', purpose: 'compare' },
      maxGeneratorAttempts: 0,
      effect: () => compareRenderedJudgment(candidates, evaluator),
    });
    console.log(JSON.stringify(result, null, 2));
    process.exit(0);
  } catch (error) {
    console.error('Rendered judgment comparison failed: ' + (error.message || error));
    process.exit(1);
  }
}

if (cmd === 'judgment' && cmdArgs[0] === 'learn') {
  console.error('judgment learn is retired; use digest-bound Dream activation.');
  process.exit(2);
}

if (cmd === 'campaign-continue') {
