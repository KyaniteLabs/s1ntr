      console.log('');
      console.log('=== Taste Model ===');
      if (!model) {
        console.error('  No persisted taste model found. Run `sinter preferences train` first.');
        console.log('');
        exitCode = 1;
      } else {
        console.log(`  Trained at: ${model.trainedAt}`);
        console.log(`  Pair count: ${model.pairCount}`);
        console.log(`  Training agreement: ${(model.trainingAgreement * 100).toFixed(1)}%`);
        console.log(`  Quality weight: ${model.qualityWeight.toFixed(3)}`);
        console.log(`  Axis weights: ${model.axisWeights.map((w, i) => `[${i}]${w.toFixed(3)}`).join(' ')}`);
        console.log('');
      }
    } else {
      console.error('Usage: sinter preferences <export|stats|train|model> [--session <id>]');
      exitCode = 1;
    }
  } catch (err) {
    console.error(`Error: ${err.message}`);
    exitCode = 1;
  } finally {
    sinterFs.close();
  }
  process.exit(exitCode);
}
else if (cmd === 'emergence') {
  const subCmd = cmdArgs[0];

  if (subCmd === 'score') {
    const { EmergenceCritic, BehaviorDescriptorExtractor } = await import('../dist/emergence/index.js');
    const { EmergenceScorecard } = await import('../dist/evaluation/EmergenceScorecard.js');

    const output = cmdArgs[1] ? String(cmdArgs[1]) : null;
    if (!output) {
      console.error('Usage: sinter emergence score <text-or-file-path>');
      process.exit(1);
    }

    // Check if it's a file path
    let text = output;
    try {
      const { readFileSync } = await import('fs');
      text = readFileSync(output, 'utf-8');
    } catch { /* not a file path, use as raw text */ }

    const extractor = new BehaviorDescriptorExtractor();
    const critic = new EmergenceCritic();
    const scorecard = new EmergenceScorecard();

    const descriptor = extractor.extract(text);
    const result = critic.evaluateQuick({
      descriptor,
      qualityScore: 0.5,
      archive: [],
      output: text,
    });

    const card = scorecard.score(result.signals, result.composite);
    console.log('');
    console.log(scorecard.format(card));
  } else if (subCmd === 'probe') {
    const { PerturbationProbe, BehaviorDescriptorExtractor } = await import('../dist/emergence/index.js');

    const output = cmdArgs[1] ? String(cmdArgs[1]) : null;
    if (!output) {
      console.error('Usage: sinter emergence probe <text-or-file-path> [--magnitude 0.1]');
      process.exit(1);
    }

    let text = output;
    try {
      const { readFileSync } = await import('fs');
      text = readFileSync(output, 'utf-8');
    } catch { /* not a file path, use as raw text */ }

    const extractor = new BehaviorDescriptorExtractor();
    const probe = new PerturbationProbe();

    const descriptor = extractor.extract(text);
    const result = probe.probe(text, descriptor, (t) => extractor.extract(t));

    console.log('');
    console.log(`Perturbation Resilience: ${result.resilience.toFixed(3)} [${result.classification}]`);
    for (const p of result.perturbations) {
      console.log(`  ${p.type}: ${p.score.toFixed(3)}`);
    }
    console.log('');
  } else {
    console.error('Usage: sinter emergence <score|probe> <text-or-file-path>');
    process.exit(1);
  }
  process.exit(0);
}
else if (cmd === 'report' && cmdArgs[0] === 'provenance') {
  const { ProvenanceNarrativeBuilder } = await import('../dist/reporting/index.js');
  const { loadPolicyManifest } = await import('../dist/release/PolicyManifestStore.js');
  const { CreativeWeaknessEmitter } = await import('../dist/autonomy/CreativeWeaknessEmitter.js');
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks } = await import('../dist/emergence/index.js');

  const sinterFs = SinterFS.open(process.cwd());
  try {
    // The same on-disk manifest `sinter ship garden|rollback` writes, so the narrative follows real changes.
    const manifest = await loadPolicyManifest();
    const changes = manifest.getAll();
    const emitter = new CreativeWeaknessEmitter();
    const builder = new ProvenanceNarrativeBuilder();

    const weaknesses = emitter.getEmitted();
    const narrative = builder.build(changes, weaknesses);

    console.log('');
    console.log('=== Provenance Report ===');
    console.log(`  ${narrative.title}`);
    console.log(`  ${narrative.summary}`);
    console.log(`  Generated: ${narrative.generatedAt}`);
    if (narrative.sections.length > 0) {
      console.log('');
      for (const section of narrative.sections) {
        console.log(`  ${section.heading}:`);
        console.log(`    ${section.body}`);
      }
    }
    console.log('');
  } finally {
    sinterFs.close();
  }
  process.exit(0);
}
else if (cmd === 'report' && cmdArgs[0] === 'archive') {
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks } = await import('../dist/emergence/index.js');
  const { EmergenceScorecard } = await import('../dist/evaluation/EmergenceScorecard.js');
  const { NicheQuotaPolicy } = await import('../dist/autonomy/NicheQuotaPolicy.js');

  const sinterFs = SinterFS.open(process.cwd());
  try {
    const hooks = new EmergenceHooks(sinterFs);
    const archive = hooks.getArchive();
    const stats = archive.getStats();
    const elites = archive.getAllElites();
    const cells = archive.getAllCells();
    const scorecard = new EmergenceScorecard();
    const nichePolicy = new NicheQuotaPolicy();

    console.log('');
    console.log('=== Archive Report ===');
    console.log(`  Cells: ${stats.totalCells}  Elites: ${stats.totalElites}  Near-elites: ${stats.totalNearElites}`);
    console.log(`  Average quality: ${stats.avgQuality.toFixed(3)}`);

    const balance = nichePolicy.getBalanceScore(cells);
    console.log(`  Niche balance: ${(balance * 100).toFixed(1)}%`);

    if (elites.length > 0) {
      console.log('');
      console.log('  Top artifacts by quality:');
      const sorted = [...elites].sort((a, b) => b.qualityScore - a.qualityScore).slice(0, 5);
      for (const e of sorted) {
        const card = scorecard.score(e.signals);
        console.log(`    ${e.id}  q=${e.qualityScore.toFixed(2)}  composite=${card.overall.score.toFixed(2)} [${card.overall.grade}]  ${e.lineage.provenance}`);
      }

      console.log('');
      console.log('  Signal averages:');
      const avgNovelty = elites.reduce((s, e) => s + e.signals.novelty, 0) / elites.length;
      const avgStructure = elites.reduce((s, e) => s + e.signals.structure, 0) / elites.length;
      const avgTemporal = elites.reduce((s, e) => s + e.signals.temporalRichness, 0) / elites.length;
      const avgFertility = elites.reduce((s, e) => s + e.signals.fertility, 0) / elites.length;
      console.log(`    Novelty: ${avgNovelty.toFixed(3)}  Structure: ${avgStructure.toFixed(3)}  Temporal: ${avgTemporal.toFixed(3)}  Fertility: ${avgFertility.toFixed(3)}`);
    }
    console.log('');
  } finally {
    sinterFs.close();
  }
  process.exit(0);
}
else if (cmd === 'runtime' && cmdArgs[0] === 'import-projections') {
  // Batches run with -o per run keep their Create projection in the run dir only. Bring each missing
  // Create into the shared runtime root (SINTER_LIMINAL_RUNTIME_ROOT) so dream can see it. Never overwrites.
  const root = process.env.SINTER_LIMINAL_RUNTIME_ROOT;
  const dirs = cmdArgs.slice(1);
  if (!root || !path.isAbsolute(root) || !dirs.length) { console.error('Usage: SINTER_LIMINAL_RUNTIME_ROOT=<abs shared root> sinter runtime import-projections <run-dir>...'); process.exit(1); }
  const { FileLiminalProductCommandStore } = await import('../dist/runtime-core/LiminalProductCommandPort.js');
  const store = new FileLiminalProductCommandStore(path.join(root, 'product-projections.json'));
  let imported = 0, present = 0, skipped = 0;
  for (const dir of dirs) {
    let doc; try { doc = JSON.parse(fs.readFileSync(path.join(path.resolve(dir), 'product-projections.json'), 'utf8')); } catch { skipped += 1; continue; }
    for (const [key, value] of Object.entries(doc)) {
      if (value?.kind !== 'create') continue;
      if (await store.read(key)) { present += 1; continue; }
      await store.write(key, value); imported += 1;
    }
  }
  console.log(`Runtime import-projections: imported=${imported} present=${present} unreadable-run-dirs=${skipped}`);
  process.exit(0);
}
else if (cmd === 'judge-evidence') {
  // Read-only: judge/scoring evidence for finished governed Creates (no owner key involved).
  const argv = cmdArgs.slice(0);
  const dirs = []; let negatives; let acceptedSourcesPath; let stateRoot; let trainingFilter;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--write-negatives') negatives = path.resolve(argv[++i] ?? '');
    else if (argv[i] === '--accepted-sources-out') acceptedSourcesPath = path.resolve(argv[++i] ?? '');
    else if (argv[i] === '--state-root') stateRoot = path.resolve(argv[++i] ?? '');
    else if (argv[i] === '--training-filter') trainingFilter = JSON.parse(fs.readFileSync(argv[++i], 'utf8'));
    else dirs.push(path.resolve(argv[i]));
  }
  if (!dirs.length) { console.error('Usage: sinter judge-evidence <run-dir>... [--write-negatives <judge-negatives.jsonl>] [--accepted-sources-out <file>] [--state-root <dir>] [--training-filter <file>]'); process.exit(1); }
  const { createProductionLiminalRuntime } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
  const { judgeNegativeRow } = await import('../dist/learning/JudgeNegativeRow.js');
  const { createHash } = await import('node:crypto');
  const acceptedSources = [];
  const allowedCreates = new Map(trainingFilter?.creates.map(({ run_dir, create_key, source_sha256 }) =>
    [JSON.stringify([run_dir, create_key]), source_sha256]));
  const holdoutDigests = new Set(trainingFilter?.holdout_digests);
  const needsBoundSource = Boolean(acceptedSourcesPath || negatives);
  let accepted = 0, rejected = 0, gray = 0, invalid = 0; const rows = [];
  for (const dir of dirs) {
    let keys = [];
    try { keys = Object.entries(JSON.parse(fs.readFileSync(path.join(dir, 'product-projections.json'), 'utf8'))).filter(([, v]) => v?.kind === 'create').map(([k]) => k); } catch { invalid += 1; continue; }
    if (!keys.length) continue;
    const root = fs.existsSync(path.join(dir, 'operation-journal.json')) ? dir : (stateRoot ?? dir);
    if (needsBoundSource && !fs.existsSync(path.join(root, 'operation-journal.json'))) continue;
    const runtime = await createProductionLiminalRuntime({ root, artifactRoot: dir });
    try {
      for (const key of keys) {
        try {
          const allowedSource = allowedCreates.get(JSON.stringify([dir, key]));
          if (trainingFilter && !allowedSource) continue;
          if (!needsBoundSource) {
            const evidence = await runtime.port.judgeScoringEvidence(key);
            if (evidence.decision === 'accepted') accepted += 1; else rejected += 1;
            continue;
          }
          const { evidence, source, rendererEnvironmentDigest } = await runtime.port.readBoundJudgeSource(key);
          const sourceSha = createHash('sha256').update(source).digest('hex');
          if ((trainingFilter && allowedSource !== sourceSha) || holdoutDigests.has(sourceSha)
            || holdoutDigests.has(evidence.artifactDigest)) continue;
          if (evidence.decision === 'accepted') {
            accepted += 1;
            if (acceptedSourcesPath) acceptedSources.push({
              run_dir: dir, create_key: key, artifact_digest: evidence.artifactDigest,
              source_sha256: sourceSha, create_receipt_digest: evidence.createReceiptDigest,
              renderer_environment_digest: rendererEnvironmentDigest,
              domain: evidence.domain, score: evidence.score, state_root: root,
            });
          } else {
            rejected += 1;
            if (negatives) {
              const row = judgeNegativeRow(evidence);
              if (row) rows.push(row);
            }
          }
        } catch (error) { if (error?.message === 'LIMINAL_JUDGE_EVIDENCE_GRAY_ZONE') gray += 1; else invalid += 1; }
      }
    } finally { await runtime.close(); }
  }
  if (negatives && rows.length) {
    // A replay must not append the same evidence twice (F08): skip ids already on file.
    const have = new Set();
    try { for (const line of fs.readFileSync(negatives, 'utf8').split('\n')) { try { have.add(JSON.parse(line).id); } catch { /* corrupt line: reported by the growth queue */ } } } catch { /* first write */ }
    const fresh = rows.filter(row => !have.has(row.id));
    if (fresh.length) fs.appendFileSync(negatives, fresh.map(row => JSON.stringify(row)).join('\n') + '\n');
  }
  if (acceptedSourcesPath) fs.writeFileSync(acceptedSourcesPath, JSON.stringify(acceptedSources), { mode: 0o600 });
  console.log(`Judge evidence: accepted=${accepted} rejected=${rejected} gray=${gray} not-admissible=${invalid} (judge-score-floor-v2-simon40: positive >=0.3, hard negative <0.2)`);
  process.exit(0);
}
else if (cmd === 'legacy-backfill') {
  // Legacy pieces with no Create receipt: sealed reduced-weight labels bound to the file digest.
  const argv = cmdArgs.slice(0); let input; let out; let negatives; let holdout; let live = 0;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--out') out = path.resolve(argv[++i] ?? '');
    else if (argv[i] === '--write-negatives') negatives = path.resolve(argv[++i] ?? '');
    else if (argv[i] === '--holdout') holdout = path.resolve(argv[++i] ?? '');
    else if (argv[i] === '--live-count') live = Number(argv[++i]);
    else input = path.resolve(argv[i]);
  }
  if (!input || !out || !Number.isInteger(live) || live < 0) { console.error('Usage: sinter legacy-backfill <scored.jsonl> --out <rows.jsonl> --live-count <n> [--holdout <file-digests.txt>] [--write-negatives <judge-negatives.jsonl>]\n  scored.jsonl rows: {path, render_digest, judge, judge_version, score}'); process.exit(1); }
  const { createProductionLiminalRuntime } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
  const { selectLegacyBackfill, legacyNegativeRow } = await import('../dist/learning/LegacyBackfill.js');
  const runtime = await createProductionLiminalRuntime({ root: path.dirname(out), artifactRoot: path.dirname(out) });
  let built = []; let unscored = 0;
  try {
    for (const line of fs.readFileSync(input, 'utf8').split('\n').filter(Boolean)) {
      try {
        const r = JSON.parse(line);
        built.push(runtime.port.legacyBackfillRow({ sourceBytes: fs.readFileSync(r.path), renderDigest: r.render_digest,
          judge: r.judge, judgeVersion: r.judge_version, score: r.score }));
      } catch { unscored += 1; }
    }
  } finally { await runtime.close(); }
  const holdoutSet = new Set(holdout ? fs.readFileSync(holdout, 'utf8').split('\n').map(s => s.trim()).filter(Boolean) : []);
  const sel = selectLegacyBackfill(built, { liveCount: live, holdoutFileDigests: holdoutSet });
  fs.writeFileSync(out, sel.admitted.map(r => JSON.stringify(r)).join('\n') + (sel.admitted.length ? '\n' : ''));
  const neg = sel.admitted.map(legacyNegativeRow).filter(Boolean);
  if (negatives && neg.length) fs.appendFileSync(negatives, neg.map(r => JSON.stringify(r)).join('\n') + '\n');
  console.log(`Legacy backfill: admitted=${sel.admitted.length} holdout-excluded=${sel.excludedHoldout} duplicates=${sel.duplicates} over-cap=${sel.droppedForCap} unscored=${unscored} negatives=${neg.length}`);
  process.exit(0);
}
else if (cmd === 'taste' && cmdArgs[0] === 'ingest') {
  // Import batch output observations. Training uses the signed-label gate.
  const corpus = cmdArgs[1];
  if (!corpus) { console.error('Usage: sinter taste ingest <corpus.jsonl>'); process.exit(1); }
  const { ingestGovernedOutputs } = await import('../dist/emergence/GovernedOutputIngest.js');
  const likesIdx = cmdArgs.indexOf('--likes');
  const likesFile = likesIdx > 0 ? cmdArgs[likesIdx + 1] : undefined; const scanDirs = [];
  for (let i = 0; i < cmdArgs.length; i++) if (cmdArgs[i] === '--scan') scanDirs.push(cmdArgs[i + 1]);
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks } = await import('../dist/emergence/index.js');
  const rows = fs.readFileSync(path.resolve(corpus), 'utf8').split('\n').filter(Boolean)
    .map(line => { try { return JSON.parse(line); } catch { return null; } }).filter(Boolean);
  const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');
  const projectRoot = resolveSinterProjectRoot();
  const ledgerPath = path.join(projectRoot, '.sinter', 'governed-ingest.json');
  let seen = [];
  try { seen = JSON.parse(fs.readFileSync(ledgerPath, 'utf8')); } catch { /* first run */ }
  const sinterFs = SinterFS.open(projectRoot);
  try {
    const hooks = new EmergenceHooks(sinterFs, { minQuality: 0 });
    const result = await ingestGovernedOutputs(hooks, rows, new Set(seen),
      file => fs.readFileSync(file, 'utf8'));
    fs.mkdirSync(path.dirname(ledgerPath), { recursive: true });
    fs.writeFileSync(ledgerPath, JSON.stringify([...seen, ...result.ingested]));
    console.log(`Taste ingest: +${result.ingested.length} archived, ${result.skipped} not eligible, ${result.failed} unreadable (${rows.length} rows)`);
    if (likesFile) {
      const { ingestOwnerLikes } = await import('../dist/learning/OwnerLikeIngest.js');
      const { TasteLearningService } = await import('../dist/learning/TasteLearningService.js');
      const seenNow = new Set([...seen, ...result.ingested]);
      const liked = await ingestOwnerLikes({
        hooks, service: new TasteLearningService(sinterFs), likesFile, scanDirs, seen: seenNow,
      });
      fs.writeFileSync(ledgerPath, JSON.stringify([...seenNow, ...liked.ingested]));
      console.log(`Taste ingest likes: +${liked.ingested.length} labelled, ${liked.unbound} not bindable`);
    }
  } finally { sinterFs.close(); }
  process.exit(0);
}
else if (cmd === 'taste' && cmdArgs[0] === 'eval') {
  const { PreferenceDatasetBuilder, TasteModelTrainer, TasteModelEvaluator } = await import('../dist/learning/index.js');
  const { SinterFS } = await import('../dist/fs/index.js');
  const { EmergenceHooks } = await import('../dist/emergence/index.js');

  const sinterFs = SinterFS.open(process.cwd());
  try {
    const hooks = new EmergenceHooks(sinterFs);
    const archive = hooks.getArchive();
    const elites = archive.getAllElites();

    if (elites.length < 4) {
      console.error('Not enough data for evaluation (need ≥4 archived entries).');
      process.exit(1);
    }

    const builder = new PreferenceDatasetBuilder();
    const dataset = builder.build(elites);

    const trainer = new TasteModelTrainer();
    const model = trainer.train(dataset.pairs);

    const evaluator = new TasteModelEvaluator();
    const result = evaluator.evaluate(dataset.pairs, model);

    console.log('');
    console.log('=== Taste Model Evaluation ===');
    console.log(`  Agreement: ${(result.agreement * 100).toFixed(1)}%`);
    console.log(`  Kendall tau: ${result.kendallTau.toFixed(3)}`);
    console.log(`  Calibration: ${(result.calibration * 100).toFixed(1)}%`);
    console.log(`  Pairs evaluated: ${result.pairCount}`);
    console.log(`  Beats baseline: ${result.beatsBaseline ? 'YES' : 'NO'}`);
    console.log('');
  } finally {
    sinterFs.close();
  }
}
else if (cmd === 'dream' && cmdArgs[0] === 'autoseal') {
  // Score-based owner seal: top judge-scored accepted Creates (plus owner likes) become Dream parent groups.
  const opts = (name) => cmdArgs.flatMap((a, i) => a === name ? [cmdArgs[i + 1]] : []);
  const opt = (name, fallback) => opts(name)[0] ?? fallback;
  const outDir = opt('--out'); const judgeId = opt('--judge');
  const scanDirs = opts('--scan'); const storeFiles = opts('--store');
  const mergeInto = opt('--merge-into'); const likesFile = opt('--likes');
  if (!outDir || !judgeId || (!scanDirs.length && !storeFiles.length)) {
    console.error('Usage: sinter dream autoseal --judge <evaluator identity> --out <dir> (--scan <dir of seat/piece/product-projections.json> | --store <file>)... [--merge-into <runtime root>] [--exclude <exclusion manifest>] [--likes likes.jsonl] [--min-score 0.5] [--top-per-domain 4] [--groups 2]');
    process.exit(2);
  }
  const { selectScoreSealedParents, candidatesFromProductStore, mergeProductStores, applyLikes,
    DEFAULT_SCORE_SEAL_POLICY, skipUnverifiable } = await import('../dist/learning/ScoreSeal.js');
  const runs = [];
  for (const dir of scanDirs) for (const seat of fs.readdirSync(dir)) {
    const seatDir = path.join(dir, seat);
    if (!fs.statSync(seatDir).isDirectory()) continue;
    for (const id of fs.readdirSync(seatDir)) {
      const file = path.join(seatDir, id, 'product-projections.json');
      if (!fs.existsSync(file)) continue;
      try { runs.push({ seat, id, store: JSON.parse(fs.readFileSync(file, 'utf8')) }); } catch { /* unreadable run */ }
    }
  }
  for (const file of storeFiles) runs.push({ seat: 'store', id: path.basename(path.dirname(path.resolve(file))), store: JSON.parse(fs.readFileSync(file, 'utf8')) });
  const likes = likesFile && fs.existsSync(likesFile)
    ? fs.readFileSync(likesFile, 'utf8').split('\n').filter(Boolean).map(l => JSON.parse(l))
        .reduce((m, l) => (l.liked === false ? m.delete(`${l.seat}/${l.id}`) : m.set(`${l.seat}/${l.id}`, l)), new Map()).values()
    : [];
  const likeList = [...likes];
  const authFilter = opt('--authority-key');
  // Frozen exclusion manifest (scripts/learning/exclusion-manifest.py): held-out pieces/digests never become parents. Unreadable or
  // digest-mismatched manifests abort; the filter runs BEFORE the merge so a held-out run cannot win a shared create key either.
  let exclusion;
  const excludeFile = opt('--exclude');
  if (excludeFile) {
    try {
      const m = JSON.parse(fs.readFileSync(excludeFile, 'utf8'));
      const { createHash: h } = await import('node:crypto');
      const want = h('sha256').update(JSON.stringify({ digests: m.digests, pieces: m.pieces, schema: m.schema })).digest('hex');
      if (m.schema !== 'sinter.learning-exclusion' || !Array.isArray(m.pieces) || !Array.isArray(m.digests) || want !== m.digest) throw new Error('digest mismatch or malformed manifest');
      exclusion = { digest: m.digest, pieces: new Set(m.pieces), digests: new Set(m.digests) };
    } catch (error) { console.error(`dream autoseal: EXCLUSION_MANIFEST_INVALID ${error?.message || error}`); process.exit(2); }
    for (let i = runs.length - 1; i >= 0; i--) if (exclusion.pieces.has(runs[i].id)) runs.splice(i, 1);
    for (const r of runs) r.store = Object.fromEntries(Object.entries(r.store).filter(([, v]) => !exclusion.digests.has(String(v?.result?.receipt?.artifactDigest ?? ''))));
  }
  const { merged, sources } = mergeProductStores(authFilter ? runs.map(r => ({ ...r, store: Object.fromEntries(Object.entries(r.store).filter(([, v]) => String(v?.result?.receipt?.authorityKeyDigest ?? '').startsWith(authFilter))) })) : runs, new Set(likeList.map(l => `${l.seat}/${l.id}`)), new Map(likeList.filter(l => l.artifactDigest).map(l => [`${l.seat}/${l.id}`, l.artifactDigest])));
  const authKey = opt('--authority-key');
  const { kept: verifiable, skipped: skippedUnverifiable } = skipUnverifiable(candidatesFromProductStore(merged, sources));
  const legacyUnbound = verifiable.filter(c => c.evaluationBinding === 'legacy-unbound').length;
  console.error(`autoseal: ${verifiable.length} creates eligible for dream (${legacyUnbound} legacy-unbound), ${skippedUnverifiable} skipped (receipt fails its own scheme)`);
  const result = selectScoreSealedParents(applyLikes(verifiable, likeList)
    .filter(item => !authKey || item.authorityKeyDigest?.startsWith(authKey)),
    { ...DEFAULT_SCORE_SEAL_POLICY, judge: judgeId,
      minScore: Number(opt('--min-score', DEFAULT_SCORE_SEAL_POLICY.minScore)),
      topPerDomain: Number(opt('--top-per-domain', DEFAULT_SCORE_SEAL_POLICY.topPerDomain)),
      groups: Number(opt('--groups', DEFAULT_SCORE_SEAL_POLICY.groups)) });
  fs.mkdirSync(outDir, { recursive: true });
  if (mergeInto) {
    // Never overwrite an existing runtime's projections: union, existing keys win; atomic replace.
    fs.mkdirSync(mergeInto, { recursive: true });
    const target = path.join(mergeInto, 'product-projections.json');
    let existing = {};
    if (fs.existsSync(target)) { try { existing = JSON.parse(fs.readFileSync(target, 'utf8')); } catch { console.error(`dream autoseal: MERGE_TARGET_UNREADABLE ${target}`); process.exit(2); } }
    fs.writeFileSync(`${target}.tmp-${process.pid}`, JSON.stringify({ ...merged, ...existing }));
    fs.renameSync(`${target}.tmp-${process.pid}`, target);
  }
  fs.writeFileSync(path.join(outDir, 'seal-provenance.json'), JSON.stringify({ ...result.provenance, runsScanned: runs.length, likes: likeList.length,
    ...(exclusion ? { exclusion: { digest: exclusion.digest, pieces: exclusion.pieces.size, digests: exclusion.digests.size } } : {}) }, null, 2) + '\n');
  result.groups.forEach((g, i) => fs.writeFileSync(path.join(outDir, `dream-run-${i}.json`), JSON.stringify(g.command, null, 2) + '\n'));
  console.log(JSON.stringify({ sealed: result.sealed, reason: result.reason, groups: result.groups.length, runs: runs.length, creates: Object.keys(merged).length, eligible: verifiable.length, legacyUnbound, skippedUnverifiable, likes: likeList.length }));
  process.exit(result.sealed ? 0 : 3);
}
else if (cmd === 'dream' && cmdArgs[0] === 'guard') {
  // Fail-closed promotion gate. Exit 0 = promote, 4 = keep incumbent, 5 = error (incumbent stays live).
  // --scheduled <json array of prompt ids> --incumbent <scores.json> --candidate <scores.json> [--min-gain 0.03]
  const opt = (name) => { const i = cmdArgs.indexOf(name); return i > 0 ? cmdArgs[i + 1] : undefined; };
  const { promotionGate, DEFAULT_MIN_GAIN } = await import('../dist/learning/HoldoutGuard.js');
  let verdict;
  try {
    const read = (name) => JSON.parse(fs.readFileSync(opt(name), 'utf8'));
    verdict = promotionGate(read('--scheduled'), read('--incumbent'), read('--candidate'),
      { minGain: Number(opt('--min-gain') ?? DEFAULT_MIN_GAIN) });
  } catch (error) {
    verdict = { decision: 'error', reason: `GATE_INPUT_UNREADABLE:${error?.message || error}` };
  }
  console.log(JSON.stringify(verdict));
  process.exit(verdict.decision === 'promote' ? 0 : verdict.decision === 'error' ? 5 : 4);
}
else if (cmd === 'dream' && cmdArgs[0] === 'renderer-digest') {
  // The identity the observer will demand, from the real browser (F07). Exit 6 when none can launch.
  try {
    const { HeadlessRenderer } = await import('../dist/render/HeadlessRenderer.js');
    console.log(await HeadlessRenderer.probeRendererEnvironmentDigest());
    process.exit(0);
  } catch (error) {
    console.error(`DREAM_RENDERER_DIGEST_UNAVAILABLE: ${error?.message || String(error)}`);
    process.exit(6);
  }
}
else if (cmd === 'dream' && cmdArgs[0] === 'run') {
  const commandPath = cmdArgs[1];
  if (!commandPath) {
    console.error('Usage: sinter dream run <governed-command.json>');
    process.exit(1);
  }
  const command = JSON.parse(fs.readFileSync(path.resolve(commandPath), 'utf8'));
  const { bootstrapProductionDreamRuntime } = await import(
    '../dist/runtime-core/ProductionLiminalRuntime.js');
  const liminalRuntime = await bootstrapProductionDreamRuntime();
  try {
    if (!liminalRuntime.dream) throw new Error('DREAM_PRODUCT_RUNTIME_NOT_CONFIGURED');
    const result = await liminalRuntime.dream.run(command);
    console.log('');
    console.log('=== Governed Dream Research Completed ===');
    console.log(`  Plan: ${result.researchPlan.planDigest}`);
    console.log(`  Outcome: ${result.outcome}`);
    console.log(`  State: ${result.state}`);
    console.log('');
  } catch (error) {
    console.error(`Dream research failed: ${error?.message || String(error)}`);
    process.exitCode = 1;
  } finally {
    await liminalRuntime.close();
  }
  if (!process.exitCode) process.exit(0);
}
else if (cmd === 'dream' && cmdArgs[0] === 'rollback') {
  // Governed retraction of an activated lesson: `sinter dream rollback <snapshotDigest> <reason...>` (F14).
  // The snapshot stays on record but is never taught again; `generate --teach` falls back to the previous active snapshot.
  const digest = cmdArgs[1];
  const reason = cmdArgs.slice(2).join(' ');
  if (!digest || !reason.trim()) {
    console.error('Usage: sinter dream rollback <snapshotDigest> <reason...>');
    process.exit(1);
  }
  try {
    const { FileActivatedKnowledgeStore } = await import('../dist/dreaming/research/DreamKnowledgeActivation.js');
    const { defaultSharedRuntimeRoot } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
    const root = process.env.SINTER_LIMINAL_KNOWLEDGE_ROOT || defaultSharedRuntimeRoot();
    const store = new FileActivatedKnowledgeStore(path.join(root, 'activated-knowledge.json'));
    store.rollback(digest, reason);
    console.log(JSON.stringify({ rolledBack: digest, reason, store: store.path }));
    process.exit(0);
  } catch (error) {
    console.error(`Dream rollback failed: ${error?.message || String(error)}`);
    process.exit(1);
  }
