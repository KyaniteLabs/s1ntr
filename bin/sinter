    console.log(`  Entries: ${health.archiveSize}  Occupancy: ${(health.nicheOccupancy * 100).toFixed(1)}%`);
    console.log(`  Fertility: ${health.fertilityYield.toFixed(3)}  Lineage depth: ${health.avgLineageDepth.toFixed(1)}`);
    console.log(`  Stagnation: ${stag.isStagnant ? `YES (${(stag.severity * 100).toFixed(0)}%)` : 'NO'}`);

    if (decisions.length > 0) {
      console.log('');
      console.log('  Next actions:');
      for (const d of decisions.slice(0, 5)) {
        console.log(`    ${d.action} (priority ${d.priority.toFixed(1)}) — ${d.reason}`);
