  console.log('  --swarm-mode blended = --swarm-mode hybrid');
  console.log('');
  console.log('COMMANDS:');
  console.log('  <prompt>                    Natural-language creative request (no magic verb required)');
  console.log('  generate, gen, g <prompt>   Create art/code from prompt');
  console.log('  bridge [port]               Start TUI bridge server (default: 3000)');
  console.log('  studio                     Launch GUI workbench (backend + browser app)');
  console.log('  provider <help|list|status> Show provider setup and missing key diagnostics');
  console.log('  serve, s [port]             Start preview server (default: 3456)');
  console.log('  list, ls                    Show saved sketches');
  console.log('  compost <subcommand>        Compost Mill: add, digest, soup, seeds, status');
  console.log('  swarm <run|sessions|label>  Swarm runs + human gold labels (calibrates voter weights)');
  console.log('  composite                   Analyze composition spec and generate layer plan');
  console.log('  compose --prompt "<idea>"     Assemble layers; --regenerate-layer <id> replaces one');
  console.log('  campaign-owner-decision-start  Start a host-sealed governed revision comparison');
  console.log('  campaign-owner-decision        Finalize a completed governed owner decision');
  console.log('  campaign-continue              Resume the server-owned governed campaign continuation');
  console.log('  live-music                  Generate a live AV set (Strudel music + Hydra visuals)');
  console.log('  chat reflect                Distill persisted Studio chats into lessons (interactive chat was retired: use sinter studio)');
