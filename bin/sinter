  const { runAuthoritativeC0 } = await import('../dist/cli/LiminalAuthoritativeCreate.js');
  try {
    const completed = await runAuthoritativeC0(path.resolve(flags.authority));
    console.log(JSON.stringify(completed, null, 2));
    process.exit(completed.result.evaluation.admissionEligible ? 0 : 2);
  } catch (error) {
    console.error(`Authoritative Create failed: ${error instanceof Error ? error.message : String(error)}`);
    process.exit(1);
  }
}

if (cmd === 'rescore') {
  const { spawnSync } = await import('node:child_process');
  const script = fileURLToPath(new URL('../scripts/quality/rescore-tops.mjs', import.meta.url));
  const forwarded = leafArgv();
  if (flags.maxProviderCalls !== undefined && !forwarded.includes('--max-provider-calls')) {
    forwarded.push('--max-provider-calls', String(flags.maxProviderCalls));
  }
  if (flags.domain && !forwarded.includes('--domain')) forwarded.push('--domain', flags.domain);
  const child = spawnSync(process.execPath, [script, ...forwarded], { stdio: 'inherit' });
  if (child.error) console.error(child.error.message);
  process.exit(child.status ?? 1);
}

if (cmd === 'authoritative-reevaluate') {
