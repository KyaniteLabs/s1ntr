const retirementMessage = retiredCliCommandMessage(cmd, cmdArgs);
if (retirementMessage) {
  console.error(retirementMessage);
  process.exit(1);
}

const naturalLanguagePrompt = inferNaturalLanguagePrompt(cmd, cmdArgs);
if (naturalLanguagePrompt && flags.prompt === undefined) {
  // Command-shaped near-misses must not silently become PAID generations
  // (audit F8): a typo'd command or a quoted "command subcommand" phrase gets
  // a did-you-mean error with an explicit escape hatch instead.
  const typo = suggestCommandForTypo(cmd, cmdArgs);
  if (typo) {
    if (typo.reason === 'quoted-phrase') {
      console.error(`"${cmd}" looks like the "${typo.command}" command quoted as one argument.`);
      console.error(`Did you mean: sinter ${cmd}  (without quotes)?`);
    } else if (typo.reason === 'bare-word') {
      console.error(`"${cmd}" is not a sinter command. Run "sinter help" to see the commands.`);
    } else {
      console.error(`Unknown command "${cmd}" — did you mean "${typo.command}"?`);
    }
    console.error(`To generate art from this text instead, run: sinter --prompt ${JSON.stringify(naturalLanguagePrompt)}`);
    process.exit(1);
  }
  flags.prompt = naturalLanguagePrompt;
}

if (naturalLanguagePrompt && flags.prompt && isSelfImprovementPrompt(flags.prompt)) {
  const { LLMModeSelfImprovementRuntime } = await import('../dist/runtime-core/SelfImprovementRuntime.js');
  const outDir = flags.output || path.join('.omx', 'self-improvement', new Date().toISOString().replace(/[:.]/g, '-'));
  fs.mkdirSync(outDir, { recursive: true });

  const runtime = new LLMModeSelfImprovementRuntime();
  const llm = new LLMClient({ role: 'harness' });
  const prepared = runtime.prepare({ llm, description: flags.prompt });
  // F1: resolve seat model before printing so receipts never say Model: auto.
  let resolvedModelName = prepared.modelName;
  try {
    if (typeof llm.resolveEffectiveModel === 'function') {
      resolvedModelName = await llm.resolveEffectiveModel();
    }
  } catch {
    resolvedModelName = llm.getConfig().model || prepared.modelName;
  }
  prepared.modelName = resolvedModelName;
  const taskJsonPath = path.join(outDir, 'self-improvement-task.json');
  const taskMdPath = path.join(outDir, 'self-improvement-task.md');
  fs.writeFileSync(taskJsonPath, `${JSON.stringify(prepared.task, null, 2)}\n`, 'utf-8');
  fs.writeFileSync(taskMdPath, [
    '# Sinter Self-Improvement Task Packet',
    '',
    `Task: ${prepared.task.title}`,
    `Task ID: ${prepared.taskId}`,
    `Model: ${resolvedModelName}`,
    `Domain: ${prepared.task.domain}`,
    `Focus file: ${prepared.task.fileHint}`,
    '',
    '## Working set',
    ...prepared.task.workingSet.map((file) => `- ${file}`),
    '',
    '## Verification targets',
    ...prepared.task.verificationTargets.map((target) => `- ${target.tool}${target.pattern ? ` (${target.pattern})` : ''}: ${target.reason}`),
    '',
    '## Description',
    '',
    prepared.task.description,
    '',
  ].join('\n'), 'utf-8');

  console.log('');
  console.log('🛠️ Sinter: Self-improvement request');
  console.log('✅ Routed to self-improvement task preparation, not creative generation.');
  console.log(`📁 Output: ${outDir}`);
  console.log(`✅ Task JSON: ${taskJsonPath}`);
  console.log(`✅ Task Markdown: ${taskMdPath}`);
  console.log(`🎯 Focus file: ${prepared.task.fileHint}`);
  console.log(`🧪 Verification: ${prepared.task.verificationTargets.map((target) => target.tool).join(', ')}`);

  const executeRequested = flags.confirm === 'auto' || flags.force === true;
  if (!executeRequested) {
    console.log('ℹ️  Add --confirm auto to execute this bounded self-improvement task in an isolated worktree.');
    console.log('');
    process.exit(0);
  }

  if (!isIsolatedWorktree() && process.env.LIMINAL_ALLOW_MAIN_WORKTREE_IMPROVE !== '1') {
    console.error('❌ Refusing to execute self-improvement in the main worktree.');
    console.error('   Create an isolated worktree, then rerun with --confirm auto.');
    process.exit(2);
  }

  prepared.task.requiresMutation = true;
  console.log('🚀 Executing bounded self-improvement task...');
  const result = await prepared.execute();
  const sessionSummary = summarizeSession(result);
  const sessionJsonPath = path.join(outDir, 'self-improvement-session.json');
  const sessionMdPath = path.join(outDir, 'self-improvement-session.md');
  fs.writeFileSync(sessionJsonPath, `${JSON.stringify(sessionSummary, null, 2)}\n`, 'utf-8');
  fs.writeFileSync(sessionMdPath, [
    '# Sinter Self-Improvement Session',
    '',
    `Status: ${sessionSummary.status}`,
    `Exit reason: ${sessionSummary.exitReason || 'n/a'}`,
    `Steps: ${sessionSummary.stepCount}`,
    `Mutated files: ${sessionSummary.mutatedFiles.length > 0 ? sessionSummary.mutatedFiles.join(', ') : 'none'}`,
    `Successful mutated files: ${sessionSummary.successfulMutatedFiles.length > 0 ? sessionSummary.successfulMutatedFiles.join(', ') : 'none'}`,
    '',
    `Session JSON: ${sessionJsonPath}`,
    '',
  ].join('\n'), 'utf-8');
  console.log(`✅ Session JSON: ${sessionJsonPath}`);
  console.log(`✅ Session Markdown: ${sessionMdPath}`);
  console.log(`📊 Status: ${sessionSummary.status}`);
  console.log(`📊 Steps: ${sessionSummary.stepCount}`);
  console.log(`✏️  Mutated files: ${sessionSummary.mutatedFiles.length > 0 ? sessionSummary.mutatedFiles.join(', ') : 'none'}`);
  console.log('');
  process.exit(sessionSummary.status === 'success' ? 0 : 1);
}

const hasOutputFlag = flags.output !== undefined;
const hasPromptFlag = flags.prompt !== undefined;
const isLiveMusic = flags.mode === 'live-music' || cmd === 'live-music';

if (hasOutputFlag && !hasPromptFlag && !cmd && !isLiveMusic) {
  console.error('Error: --prompt is required');
  process.exit(1);
}

// --- live-music mode: generateMusic + optional generateVisuals, write to --output, print paths ---
if (isLiveMusic) {
  const livePrompt = commandPrompt(flags.prompt, cmdArgs);
  // Guard empty AND whitespace-only prompts: a blank prompt silently fabricates
  // a generic template set (no real generation), so reject it loudly instead.
  if (!livePrompt || livePrompt.trim().length === 0) {
    console.error('Error: --prompt is required for live-music');
    process.exit(1);
  }
  const liveOutDir = flags.output || path.join(process.env.HOME || '/tmp', '.sinter', 'output');
  fs.mkdirSync(liveOutDir, { recursive: true });

  // Project `live` settings (syncMode, oscHost): validated, then threaded into BOTH generators as one sync contract.
  const { liveSettingsFromProjectConfig, withLiveSync } = await import('../dist/music/liveSyncContract.js');
  let liveOpts = {};
  try {
    liveOpts = liveSettingsFromProjectConfig(await loadProjectConfig(process.cwd()));
  } catch (e) {
    console.error('Error: ' + e.message);
    process.exit(1);
  }
  const liveSyncPrompt = (base) => withLiveSync(base, liveOpts);

  console.log('');
  console.log('🎵 Sinter: Live AV');
  console.log('📝 Prompt: "' + livePrompt + '"');
  console.log('📁 Output: ' + liveOutDir);
  if (liveOpts.oscHost || liveOpts.syncMode) {
    console.log('🔧 Live config: oscHost=' + (liveOpts.oscHost || '-') + ', syncMode=' + (liveOpts.syncMode || '-'));
  }
  console.log('');

  try {
    // generateMusic takes a single GenerateMusicOptions object — passing the
    // prompt as the first positional arg made `options.prompt` undefined, so the
    // strudel path ran on an empty prompt and fabricated a generic template.
    // Mirror the GUI call shape (gui/server.js): { prompt, platform: 'strudel' }.
    // Provider transport needs a journal-reserved generator grant (#710): run
    // both generations inside one governed effect, the same path compose uses.
    // The key is unique per run so a repeat prompt regenerates instead of
    // replaying the journaled result.
    const { runProductionCliProviderEffect } =
      await import('../dist/cli/LiminalProductionProviderEffect.js');
    const { musicResult, visualResult, linkedBpm } = await runProductionCliProviderEffect({
      idempotencyKey: 'production-live-music:' + randomUUID(),
      binding: { surface: 'cli-live-music', prompt: livePrompt },
      maxGeneratorAttempts: 2,
      effect: async () => {
        if (flags.musicToVisual) {
          // Visuals follow the music: the picture is generated from the measured tempo and spectrum of the music.
          const { generateMusicToVisual } = await import('../dist/musicToVisual/generateMusicToVisual.js');
          const linked = await generateMusicToVisual(liveSyncPrompt(livePrompt), { musicPlatform: 'strudel', visualPlatform: 'hydra' });
          return {
            musicResult: { code: linked.musicCode, source: 'deterministic' },
            visualResult: { code: linked.visualCode },
            linkedBpm: linked.audioInput?.bpm,
          };
        }
        return {
          musicResult: await generateMusic({ prompt: liveSyncPrompt(livePrompt), sourcePrompt: livePrompt, platform: 'strudel', ...(flags.theory ? { theoryBrief: true } : {}) }),
          visualResult: await generateVisuals({ prompt: liveSyncPrompt(livePrompt), platform: 'hydra' }),
        };
      },
    });
    const strudelPath = path.join(liveOutDir, 'strudel.js');
    fs.writeFileSync(strudelPath, musicResult.code, 'utf-8');
    // A built-in pattern is not model output; say so.
    console.log(musicResult.source === 'template'
      ? '⚠️  Music: ' + strudelPath + ' (built-in pattern, not written by the model)'
      : '✅ Music: ' + strudelPath);

    const hydraPath = path.join(liveOutDir, 'hydra.js');
    fs.writeFileSync(hydraPath, visualResult.code, 'utf-8');
    console.log('✅ Visuals: ' + hydraPath);
    if (linkedBpm) console.log('🔗 Visuals follow the music (measured tempo ' + linkedBpm + ' BPM)');
    console.log('');
  } catch (err) {
    console.error('❌ Error:', err.message);
    process.exit(1);
  }
  process.exit(0);
}

if (cmd === 'site') {
  const { runSiteEvolve, runSiteSeed } = await import('../dist/cli/SiteCommand.js');
  const subCmd = cmdArgs[0];

  if (subCmd === 'seed') {
    const count = flags.slots;
    await runSiteSeed({ count });
    process.exit(0);
  }

  if (subCmd !== 'evolve') {
    console.error('Usage:');
    console.error('  sinter site seed [--slots <n>]                      Seed starter slots (required before first evolve)');
    console.error('  sinter site evolve [--once] [--dry-run] [--slot <id>]  Run the living website evolution daemon');
    process.exit(1);
  }

  // The global flag loop has already parsed and validated these options.
  const options = {
    once: args.includes('--once'),
    dryRun: args.includes('--dry-run'),
    slot: (() => { const idx = args.indexOf('--slot'); return idx !== -1 ? args[idx + 1] : undefined; })(),
    interval: flags.interval,
  };

  await runSiteEvolve(options);
  process.exit(0);
}

if (cmd === 'generate' || cmd === 'gen' || cmd === 'g' || (flags.prompt && (!cmd || naturalLanguagePrompt))) {
  prompt = commandPrompt(flags.prompt, cmdArgs);
  if (!prompt && !flags.batchFile) {
    console.error('Error: --prompt is required');
    process.exit(1);
  }
  if (flags.maxIterations) maxIterations = flags.maxIterations;
  if (flags.output) output = flags.output;
  const { assertGovernedCliCompatibility, runProductionCliGenerate, parseTeachScope, NO_ARTIFACT_EXIT_CODE, replayNoticeLines } =
    await import('../dist/cli/LiminalProductionGenerate.js');
  if (flags.parent !== undefined) {
    // Resolve the parent before any provider call: a typo must not bill a generation that cannot be linked.
    const { LineageTracker } = await import('../dist/emergence/index.js');
    if (!flags.parent || !(await new LineageTracker().get(flags.parent))) {
      console.error(`Error: --parent ${flags.parent || '(empty)'} is not in the lineage store. List known ids with: sinter archive list`);
      process.exit(1);
    }
  }
  if (flags.teach !== undefined) {
    try { flags.teach = parseTeachScope(flags.teach); } catch (error) {
      console.error(`Error: ${error.message}`); process.exit(1);
    }
  }
  let loopsN = 1;
  if (flags.loops !== undefined) {
    try { loopsN = (await import('../dist/cli/LiminalProductionLoops.js')).parseLoopsFlag(flags.loops); } catch (error) {
      console.error(`Error: ${error.message}`); process.exit(1);
    }
  }
  try {
    assertGovernedCliCompatibility({ explicitMaxIterations: flags.maxIterations,
      stages: flags.stages, useSwarm: flags.useSwarm, learn: flags.learn,
      intuition: flags.intuition, aesthetic: !!(flags.aesthetic || flags.aestheticConfig),
      voice: !!flags.voice,
      providerOverride: !!(flags.provider || flags.model || flags.baseUrl || flags.apiKey) });
  } catch (error) {
    console.error(`Error: ${error.message}`);
    process.exit(1);
  }

  const { MIN_STAGED_CREATE_PROVIDER_CALLS, twoStageJudgeEnabled } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
  const staged = twoStageJudgeEnabled();
  const defaultCreateCap = staged ? MIN_STAGED_CREATE_PROVIDER_CALLS : 2;
  if (flags.lane === 'batch' || flags.batchFile) {
    // Anthropic Message Batches lane: generation/revision only, half-price, resumable, capped by --budget-usd (cumulative ledger).
    if (flags.lane !== 'batch' || !flags.batchFile) { console.error('Error: the batch lane needs both --lane batch and --batch-file <prompts.json>'); process.exit(1); }
    if (flags.budgetUsd === undefined) { console.error('Error: --budget-usd <dollars> is required with --lane batch (the cap is cumulative across runs)'); process.exit(1); }
    if (!flags.batchModel) { console.error('Error: --lane batch needs --batch-model <claude-opus-5-5|claude-sonnet-5-5|claude-haiku-5-5|claude-fable-5-2>'); process.exit(1); }
    if (flags.reviseFrom || flags.ref || flags.arc || flags.teach) { console.error('Error: --lane batch cannot be combined with --revise-from, --ref/--arc or --teach'); process.exit(1); }
    const effort = flags.batchEffort || 'high';
    if (!['low', 'medium', 'high', 'xhigh', 'max'].includes(effort)) { console.error('Error: --batch-effort must be low, medium, high, xhigh or max'); process.exit(1); }
    const lane = await import('../dist/cli/LiminalBatchLane.js');
    try {
      const pieces = lane.parseBatchFile(path.resolve(flags.batchFile));
      const res = await lane.runBatchLane({ pieces, loops: loopsN, outputRoot: path.resolve(output || path.join(process.env.HOME || '/tmp', '.sinter', 'output')), model: flags.batchModel, effort,
        maxTokens: flags.batchMaxTokens ?? 32000, budgetUsd: flags.budgetUsd, marginPct: flags.batchMargin ?? 10, dryRun: flags.dryRun === true,
        concurrency: flags.batchConcurrency ?? 4, pollMs: Math.round((flags.batchPollSeconds ?? 60) * 1000), retryRounds: flags.batchRetries ?? 1,
        providerCallsPerLoop: flags.maxProviderCalls ?? Math.max(3, defaultCreateCap), ...(flags.attempt ? { attempt: flags.attempt } : {}), retryUnknown: Boolean(flags.retryUnknown),
        log: (l) => console.log('📦 ' + l) });
      if (res.dryRun) {
        for (const line of lane.formatEstimate(res.estimate)) console.log(line);
        console.log('Dry run: nothing was submitted and no money was spent.');
        process.exit(0);
      }
      let allComplete = true;
      for (const [id, m] of res.manifests) {
        console.log(`${id}: ${m.records.map((r) => `r${r.loop}=${r.status === 'failed' ? 'FAILED' : r.score === null ? 'unscored' : r.score.toFixed(2)}${r.best ? '*' : ''}`).join('  ')}`);
        if (m.records.length !== m.loops || m.records.some(r => r.status === 'failed' || r.score === null)) allComplete = false;
      }
      console.log(`📦 Batches: ${res.batchIds.length}; spent $${res.spentUsd.toFixed(4)}; remaining of cap $${res.remainingUsd.toFixed(2)}; summary ${res.summaryPath}`);
      if (res.stoppedForBudget) { console.error('Stopped for budget ' + res.stoppedForBudget + '. Re-run the same command later to resume.'); process.exit(5); }
      process.exit(allComplete ? 0 : 1);
    } catch (error) {
      console.error(`Error: ${error.message}`);
      process.exit(error.name === 'BatchLaneRefusal' || error.name === 'BatchBudgetStop' ? 2 : 1);
    }
  }

  // Embeddable SVG output (#1162): validate before any provider call is made.
  let svgFragmentSpec = null;
  try {
    const { parseSvgOutputFlags } = await import('../dist/generators/svg/SVGFragment.js');
    svgFragmentSpec = parseSvgOutputFlags(flags);
  } catch (error) {
    console.error(`Error: ${error.message}`);
    process.exit(1);
  }

  const missingKeyMessage = await missingProviderKeyMessageForGeneration();
  if (missingKeyMessage) {
    console.error(missingKeyMessage);
    process.exit(1);
  }

  const outDir = output || path.join(process.env.HOME || '/tmp', '.sinter', 'output');
  fs.mkdirSync(outDir, { recursive: true });

  console.log('');
  console.log('🎨 ' + TAGLINE);
  console.log('📝 Prompt: "' + prompt + '"');
  console.log('🔄 Attempts: ' + (loopsN > 1 ? `${loopsN} improvement loops (one Create each)` : '1'));
  if (flags.maxProviderCalls !== undefined) {
    console.log(`🧾 Provider plan: generate,evaluate cap=${flags.maxProviderCalls}`);
  }
  if (flags.reasoning) {
    console.log(`🧠 Reasoning: ${flags.reasoning} (all roles)`);
  }
  if (output) console.log('📁 Output: ' + output);
  console.log('');
  console.log('Generating:', prompt);
  console.log('');

  // Route generation + validation to the domain the prompt asks for (else the
  // loop defaults to p5 and a "GLSL shader" prompt fails p5 validation).
  // An explicit --domain overrides auto-detection. Without that override,
  // `--domain three` used to auto-detect to p5 and fail.
  const { detectPromptDomain } = await import('../dist/core/detectPromptDomain.js');
  const { mediumLabel } = await import('../dist/types/mediumNames.js');
  let detectedDomain;
  let useHybridPlanner = false;
  // Governed generate supports a subset of the known domains (revideo is known
  // but not governed); reject the rest here with a plain message instead of a
  // raw LIMINAL_PRODUCTION_DOMAIN_UNSUPPORTED from deep in the runtime.
  const { SUPPORTED_LIMINAL_PRODUCTION_DOMAINS, isLiminalProductionDomain } =
    await import('../dist/runtime-core/LiminalProductionEffects.js');
  const governedDomains = SUPPORTED_LIMINAL_PRODUCTION_DOMAINS.join(', ');
  if (flags.domain) {
    detectedDomain = String(flags.domain).toLowerCase();
    detectedDomain = ({ webpage: 'html', 'concrete-poetry': 'textgen', fluid: 'nbe', invented: 'custom' })[detectedDomain] ?? detectedDomain;
    if (!isLiminalProductionDomain(detectedDomain)) {
      console.error(`--domain "${flags.domain}" is not available for generate. Valid: ${governedDomains}`);
      process.exit(1);
    }
    console.log('🎯 Medium (forced via --domain): ' + mediumLabel(detectedDomain) + ' (' + detectedDomain + ')\n');
  } else {
    if (flags.hybrid) process.env.SINTER_LAYERED = '1';
    detectedDomain = await detectPromptDomain(prompt);
    if (detectedDomain) console.log('🎯 Detected medium: ' + mediumLabel(detectedDomain) + ' (' + detectedDomain + ')\n');
    else if (process.env.SINTER_LAYERED === '1' || process.env.SINTER_HYBRID_LAYERS === '1') useHybridPlanner = true;
    else console.log('🎯 No medium cue in the prompt: falling back to p5 (set SINTER_LAYERED=1 to let S1NTR choose the medium; --hybrid is an alias)\n');
    if (detectedDomain && !isLiminalProductionDomain(detectedDomain)) {
      console.error(`The prompt asks for ${detectedDomain}, which generate does not support yet. Rephrase or pass --domain with one of: ${governedDomains}`);
      process.exit(1);
    }
  }

  if (typeof flags.retryUnknown === 'number' && (loopsN < 2 || flags.retryUnknown > loopsN)) {
    console.error('Error: --retry-unknown=N requires a loop in this multi-loop run.');
    process.exit(1);
  }
  if (loopsN > 1 && (flags.reviseFrom || (!useHybridPlanner && (flags.ref || flags.arc)))) {
    console.error('Error: generate --loops already revises each prior take and cannot use --revise-from or single-medium --ref/--arc. Use compose --loops for references.');
    process.exit(1);
  }
  if (useHybridPlanner) {
    if (flags.outputMode !== undefined) {
      console.error('Error: --output-mode needs the svg domain. Add --domain svg.');
      process.exit(1);
    }
    const unsupported = [flags.reviseFrom && '--revise-from', flags.reviseLoop && '--revise-loop',
      flags.reviseOf && '--revise-of', flags.teach && '--teach', loopsN === 1 && flags.retryUnknown && '--retry-unknown'].filter(Boolean);
    if (unsupported.length) {
      console.error(`Error: automatic hybrid generation cannot apply ${unsupported.join(', ')}. Pass --domain to choose a single medium.`);
      process.exit(1);
    }
  }

  let generationPrompt = prompt;
  if (flags.conceptGraph) {
    // nodeprompt: a concept graph (ideas + how they relate) rewrites the request into a structured brief.
    try {
      const { enrichPromptFromGraphFile } = await import('../dist/nodeprompt/index.js');
      generationPrompt = enrichPromptFromGraphFile(prompt, path.resolve(flags.conceptGraph));
      console.log(`🕸️  Concept graph applied: ${path.basename(flags.conceptGraph)}`);
    } catch (error) {
      console.error(`Error: --concept-graph ${error.message}`);
      process.exit(1);
    }
  }
  if (flags.reviseFrom && svgFragmentSpec) { console.error('Error: --revise-from cannot be combined with --output-mode fragment'); process.exit(1); }
  if (flags.reviseFrom) {
    // Revision loop: the previous loop's accepted source + judge critique + frames become part of this Create's brief.
    try {
      const { loadPriorRun, buildRevisionPrompt } = await import('../dist/generators/revision/RevisionBrief.js');
      const prior = loadPriorRun(path.resolve(flags.reviseFrom));
      const loopNo = flags.reviseLoop ?? 2;
      generationPrompt = buildRevisionPrompt({ request: prompt, loop: loopNo, of: flags.reviseOf ?? loopNo,
        priorSource: prior.source, priorScore: prior.score, critique: prior.critique,
        rejectionReasons: prior.rejectionReasons, frames: prior.frames });
      console.log(`♻️  Revising loop ${loopNo - 1} (score ${prior.score === null ? 'unscored' : prior.score.toFixed(2)}, ${prior.source.length} chars of source, ${prior.frames.length} frame(s)) from ${prior.artifactDirectory}\n`);
    } catch (error) {
      console.error(`Error: ${error.message}`);
      process.exit(1);
    }
  }
  if (svgFragmentSpec) {
    const { buildFragmentBrief, routeFragmentDomain } = await import('../dist/generators/svg/SVGFragment.js');
    const routed = routeFragmentDomain(detectedDomain);
    if (!routed.ok) {
      console.error('Error: ' + routed.error);
      process.exit(1);
    }
    if (routed.route.reroutedFrom) {
      detectedDomain = routed.route.domain;
      console.log('🔁 ' + routed.route.notice + '\n');
    }
    generationPrompt = buildFragmentBrief(generationPrompt, svgFragmentSpec);
  }

  // Reverse mode (#711): references become feature cards and an arc, appended to the prompt.
  let reverseBrief = null;
  let visionCalls = 0;
  let createCap = flags.maxProviderCalls ?? defaultCreateCap;
  try {
    const { parseReverseFlags, prepareReverseGoverned, isImagePath } = await import('../dist/cli/ReverseCli.js');
    const { planReverseCalls } = await import('../dist/cli/ProviderCallPlan.js');
    const { applyReverseBrief } = await import('../dist/reverse/ReverseBrief.js');
    const reverseFlags = useHybridPlanner ? null : parseReverseFlags(flags);
    if (reverseFlags) {
      visionCalls = reverseFlags.arcPath && isImagePath(reverseFlags.arcPath) ? 1 : 0;
      if (flags.maxProviderCalls !== undefined) createCap = planReverseCalls(flags.maxProviderCalls, visionCalls).createCap;
      if (staged && createCap < defaultCreateCap) throw new Error('LIMINAL_STAGED_TRANSPORT_CAP_TOO_LOW');
      const prepared = await prepareReverseGoverned(reverseFlags, path.resolve(outDir));
      for (const line of prepared.notices) console.log('🔁 ' + line);
      reverseBrief = prepared.brief;
      generationPrompt = applyReverseBrief(generationPrompt, reverseBrief);
    }
  } catch (error) {
    console.error(`Error: ${error.message}`);
    process.exit(1);
  }

  // Reference pictures go through src/media first: real image bytes only, size-capped, hashed. The receipt lands beside the piece.
  if (!useHybridPlanner && flags.ref) {
    try {
      const { loadImageAttachment, attachmentReceipt } = await import('../dist/media/ImageAttachment.js');
      const { isImagePath } = await import('../dist/cli/ReverseCli.js');
      const receipts = [];
      for (const refPath of flags.ref.filter(isImagePath)) {
        const att = loadImageAttachment(path.resolve(refPath), { role: 'reference', source: 'cli', allowRoots: [path.dirname(path.resolve(refPath))], stageDir: path.join(path.resolve(outDir), '.image-stage') });
        receipts.push(attachmentReceipt(att, { originalName: att.originalName }));
      }
      if (receipts.length) {
        fs.mkdirSync(path.resolve(outDir), { recursive: true });
        fs.writeFileSync(path.join(path.resolve(outDir), 'reference.receipt.json'), JSON.stringify(receipts, null, 2) + '\n', 'utf8');
        console.log('Reference images checked: ' + receipts.length + ' (sha256 ' + receipts.map(r => r.imageSha256.slice(0, 12)).join(', ') + ')');
      }
    } catch (error) {
      console.error('Error: reference image rejected: ' + error.message);
      process.exit(1);
    }
  }

  // Saved seed (gallery): its prompt and note join the brief so the new piece builds on it.
  if (flags.seed) {
    try {
      const { SeedArchive } = await import('../dist/gallery/SeedArchive.js');
      const saved = await new SeedArchive(path.join(os.homedir(), '.sinter', 'seeds')).loadSeed(flags.seed);
      if (!saved) throw new Error('no saved seed named ' + flags.seed + ' (sinter seed list)');
      generationPrompt = generationPrompt + '\n\nBuild on saved seed "' + flags.seed + '": ' + (saved.prompt || '') + (saved.note ? ' (' + saved.note + ')' : '');
      console.log('Seed ' + flags.seed + ' added to the brief');
    } catch (error) {
      console.error('Error: --seed ' + error.message);
      process.exit(1);
    }
  }

  // Critique memo: a reviewer's verdict and high-priority notes are appended to the brief (src/collab EvaluationMemo).
  if (flags.memo) {
    try {
      const { formatMemo } = await import('../dist/collab/EvaluationMemo.js');
      const memo = JSON.parse(fs.readFileSync(path.resolve(flags.memo), 'utf8'));
      generationPrompt = generationPrompt + '\n\nReviewer critique to address (from ' + memo.generatedBy + '):\n' + formatMemo(memo);
      console.log('Critique memo from ' + memo.generatedBy + ' (' + memo.finalVerdict + ') added to the brief');
    } catch (error) {
      console.error('Error: --memo ' + error.message);
      process.exit(1);
    }
  }

  // Voice brief: a recording's measured colour, motion, shape and energy are appended to the brief.
  if (flags.voiceFile) {
    try {
      const { analyzeVoiceFile, applyVoiceBrief } = await import('../dist/audio/VoiceBrief.js');
      generationPrompt = applyVoiceBrief(generationPrompt, await analyzeVoiceFile(path.resolve(flags.voiceFile)));
      console.log('🎤 Voice brief: ' + path.basename(flags.voiceFile) + ' analysed; its palette, motion and form go into the brief');
    } catch (error) {
      console.error(`Error: --voice-file ${error.message}`);
      process.exit(1);
    }
  }

  if (useHybridPlanner) {
    console.log('🎯 No medium cue in the prompt: handing the choice of medium to S1NTR\'s planner\n');
    const { spawnSync } = await import('node:child_process');
    const composed = spawnSync(process.execPath, [process.argv[1], 'compose', '--hybrid', '--prompt', generationPrompt,
      '-o', path.resolve(outDir),
      ...(flags.gallery ? ['--gallery', flags.gallery] : []),
      ...(flags.loops !== undefined ? ['--loops', String(flags.loops)] : []),
      ...(flags.retryUnknown ? [flags.retryUnknown === true ? '--retry-unknown' : '--retry-unknown=' + flags.retryUnknown] : []),
      ...(flags.maxProviderCalls !== undefined ? ['--max-provider-calls', String(flags.maxProviderCalls)] : []),
      ...(flags.attempt ? ['--attempt', flags.attempt] : []),
      ...(flags.hybridLayers ? ['--layers', flags.hybridLayers] : []),
      ...(flags.exportLayer !== undefined ? ['--export-layer', String(flags.exportLayer)] : []),
      ...(flags.ref ?? []).flatMap(ref => ['--ref', ref ?? '']),
      ...(flags.arc !== undefined ? ['--arc', flags.arc] : []),
      ...(flags.duration !== undefined ? ['--duration', flags.duration] : []),
      ...(flags.cues !== undefined ? ['--cues', flags.cues] : [])], { stdio: 'inherit' });
    if (composed.error) console.error('Error: ' + composed.error.message);
    process.exit(composed.status ?? 1);
  }

  try {
    const { decideGenerateMedium } = await import('../dist/core/MediumLine.js');
    let governed;
    if (loopsN > 1) {
      // Improvement loops: N governed Creates in one invocation, each its own folder/artifact/score/critique.
      const { runGovernedLoops } = await import('../dist/cli/LiminalProductionLoops.js');
      const perLoop = createCap;
      console.log(`🧾 Provider budget: ${perLoop} per loop x ${loopsN} loops = ${perLoop * loopsN}`);
      const run = await runGovernedLoops({ request: generationPrompt, domain: detectedDomain || 'p5', loops: loopsN,
        outputRoot: path.resolve(outDir), providerCallsPerLoop: perLoop, resumeKey: flags.attempt ?? undefined, attemptPrefix: flags.attempt, retryUnknown: flags.retryUnknown, retryArgs: args,
        log: (l) => console.log('♻️  ' + l), verifyResumedCreates: true,
        generateOne: async ({ prompt: loopPrompt, outputRoot: loopRoot, attemptId, providerCallsMaximum, replayOnly, onRetryUnknown }) => {
          const g = await runProductionCliGenerate({ prompt: loopPrompt, domain: detectedDomain || 'p5', outputRoot: loopRoot,
            mediumDecision: decideGenerateMedium({ domain: detectedDomain || 'p5', forced: Boolean(flags.domain), detected: flags.domain ? undefined : detectedDomain }),
            fragmentSpec: svgFragmentSpec, maxTransportAttempts: providerCallsMaximum, adoptReplayedArtifacts: true, replayOnly, onRetryUnknown,
            attemptId,
            ...(flags.teach ? { teachScope: flags.teach } : {}) });
          const ev = g.result.evaluation;
          const real = ev.admissionEligible === true;
          console.log(`   loop result: ${real ? 'score ' + ev.score.toFixed(2) : 'ineligible'}; provider calls ${g.result.attempts.consumed}/${g.result.attempts.maximum}; saved ${g.sourcePath}`);
          if (!g.artifactsPresent) throw new Error('LOOP_REPLAY_NO_ARTIFACT: the shared runtime already held this loop Create; use --attempt <new id> or a fresh -o to run it again');
          return { score: real ? ev.score : null, critique: ev.reasoning ?? '', providerCalls: g.result.attempts.consumed,
            model: g.result.roles.generator, prior: g.prior, payload: g };
        } });
      const m = run.manifest;
      console.log('');
      console.log(`🏁 Loops: ${m.records.map((r) => `r${r.loop}=${r.status === 'failed' ? 'FAILED' : r.score === null ? 'unscored' : r.score.toFixed(2)}${r.best ? '*' : ''}`).join('  ')}  (* = best; manifest ${path.join(path.resolve(outDir), 'loops-manifest.json')})`);
      console.log(`🧾 Provider calls: ${m.providerCallsConsumed}/${m.providerCallBudget}${m.providerCallsUnverified ? ` (+ ${m.providerCallsUnverified} unverified)` : ''}`);
      if (typeof flags.retryUnknown === 'number') {
        const target = m.records.find(record => record.loop === flags.retryUnknown);
        console.log(`Loop ${flags.retryUnknown}: ${target.status} (${target.outputRoot})`);
        process.exit(target.status === 'failed' ? 1 : 0);
      }
      if (!run.best) {
        console.error('❌ No loop produced an eligible artifact. See loops-manifest.json for each loop\'s error.');
        process.exit(1);
      }
      governed = run.best.payload;
      console.log(`⭐ Best loop: r${run.bestLoop}`);
    } else {
    governed = await runProductionCliGenerate({ prompt: generationPrompt,
      domain: detectedDomain || 'p5', outputRoot: path.resolve(outDir),
      mediumDecision: decideGenerateMedium({ domain: detectedDomain || 'p5',
        forced: Boolean(flags.domain), detected: flags.domain ? undefined : detectedDomain }),
      fragmentSpec: svgFragmentSpec,
      maxTransportAttempts: createCap,
      retryUnknownOutcome: flags.retryUnknown === true,
      ...(flags.attempt ? { attemptId: flags.attempt } : {}),
      ...(flags.teach ? { teachScope: flags.teach } : {}) });
    }
    const result = governed.result;
    let finalTake = governed;
    console.log('');
    for (const line of formatGovernedHeadline(result.evaluation)) console.log(line);
    if (result.evaluation.degraded || !result.evaluation.identityValid) {
      console.log(`⭐ Quality score: unscored (judge could not score) (failureClass=${result.evaluation.failureClass || 'unknown'}, confidence=${result.evaluation.confidence ?? 0})`);
      const why = formatDegradedWhy({ rejectionReasons: result.evaluation.rejectionReasons,
        runtimeErrors: result.evidence?.runtimeErrors, reasoning: result.evaluation.reasoning });
      if (why) console.log(why);
    } else {
      console.log('⭐ Quality score: ' + result.evaluation.score.toFixed(2));
    }
    console.log('🤖 Model: ' + result.roles.generator);
    console.log(`🧾 Provider calls: ${result.attempts.consumed}/${result.attempts.maximum}`);
    const replayNotice = replayNoticeLines(governed, path.resolve(outDir));
    if (replayNotice) {
      // A replay (the shared runtime already holds this Create) or lost bytes: nothing was saved at -o. Never claim it was.
      for (const line of replayNotice) console.error(line);
      process.exit(NO_ARTIFACT_EXIT_CODE);
    }
    await history.add(prompt);
    if (flags.parent) {
      const { LineageTracker } = await import('../dist/emergence/index.js');
      const child = await new LineageTracker().record({ artifactId: result.operationId, parentIds: [flags.parent], provenance: 'branch',
        runId: result.operationId, runParams: { lineageId: result.lineageId, domain: result.domain, sourcePath: governed.sourcePath } });
      console.log(`🌿 Branched from ${flags.parent} -> ${child.artifactId} (sinter archive lineage ${child.artifactId})`);
    }
    console.log('✅ Saved: ' + governed.sourcePath);
    console.log('✅ HTML: ' + governed.playablePath);
    if (governed.previewPath) console.log('✅ Preview: ' + governed.previewPath);
    if (governed.mediumLine) console.log('🧭 ' + governed.mediumLine);
    if (reverseBrief) {
      const { writeReverseProvenance } = await import('../dist/cli/ReverseCli.js');
      const { shouldFit, runReverseFit, describeFit } = await import('../dist/cli/ReverseFit.js');
      let provenance = reverseBrief.provenance;
      let provenanceDir = path.dirname(governed.sourcePath);
      let fitFailed = false;
      if (shouldFit(detectedDomain, reverseBrief)) {
        console.log('🎚️  Fit check: rendering to measure length, final hit, and arc fit (needs a browser)...');
        const { revisionCap } = await import('../dist/cli/ProviderCallPlan.js');
        const fitted = await runReverseFit({ domain: detectedDomain, brief: reverseBrief,
          sourcePath: governed.sourcePath,
          regenerate: async (critique) => {
            const cap = flags.maxProviderCalls === undefined ? defaultCreateCap : revisionCap(flags.maxProviderCalls, visionCalls, result.attempts.consumed);
            if (cap === null) {
              throw new Error(`PROVIDER_CAP_EXHAUSTED: --max-provider-calls ${flags.maxProviderCalls} is spent (${visionCalls} vision + ${result.attempts.consumed} create); the fit revision was not run`);
            }
            console.log('🔁 Fit check missed; revising once with the measured critique...');
            return runProductionCliGenerate({ prompt: generationPrompt + '\n\n' + critique,
              domain: detectedDomain, outputRoot: path.resolve(outDir), fragmentSpec: null,
              maxTransportAttempts: cap, retryUnknownOutcome: false,
              ...(flags.teach ? { teachScope: flags.teach } : {}) });
          } });
        provenance = fitted.provenance;
        provenanceDir = path.dirname(fitted.sourcePath);
        // Sol L3-17: the revised take is the one the operator is told to use, so its Create is the one reported and exited on.
        if (fitted.revisedTake) {
          finalTake = fitted.revisedTake;
          console.log('');
          console.log('🎯 Final take (revised): ' + finalTake.sourcePath);
          console.log('✅ Revised HTML: ' + finalTake.playablePath);
          console.log('🧾 Revision provider calls: ' + finalTake.result.attempts.consumed + '/' + finalTake.result.attempts.maximum);
          for (const line of formatGovernedHeadline(finalTake.result.evaluation)) console.log(line);
        }
        fitFailed = !fitted.fit.passed;
        console.log('🎚️  Fit: ' + describeFit(fitted.fit));
      } else if (reverseBrief.provenance.durationSec !== null) {
        console.log('🎚️  Fit check runs for tone and strudel only; ' + (detectedDomain || 'p5') + ' output is not measured.');
      }
      console.log('🧾 Reverse provenance: ' + await writeReverseProvenance(provenanceDir, provenance));
      if (fitFailed) {
        console.error('❌ The piece does not fit the brief after one revision. The artifact and its measurements are saved.');
        process.exit(1);
      }
    }
    if (governed.fragmentPath) console.log('Fragment: ' + governed.fragmentPath);
    if (governed.hostProofPath) console.log('Host proof: ' + governed.hostProofPath);
    console.log('🧾 Signed receipt: ' + finalTake.result.receipt.signature);
    console.log('');
    // 0 accepted, 3 generated-but-not-accepted (files saved), 4 replay with no artifact at -o, 1 error.
    process.exit(governedExitCode(finalTake.result.evaluation));
  } catch (err) {
    console.error('');
    console.error('❌ Error:', err.message);
    if (String(err.message).includes('EFFECT_OUTCOME_UNRESOLVED')) {
      console.error('   The last run of this prompt timed out, so it may already have been billed.');
      console.error('   Re-run with --retry-unknown to start fresh and accept a possible second charge.');
    }
    console.error('');
    process.exit(1);
  }

}
else if (cmd === 'serve' || cmd === 's') {
  const port = parsePortArg(cmdArgs[0]);
  if (port === null) {
    console.error(`Invalid port: ${cmdArgs[0]}`);
    console.error('Use a number from 0 to 65535.');
    process.exit(1);
  }
  // Wire the gallery dir so /api/gallery surfaces saved works (generations +
  // compositions). Defaults to cwd/gallery — the same dir generate/compose write to.
  // Step 5 (issue #298): serve uses the bridge-backed preview surface
  // (TuiBridgeServer, which embeds PreviewEndpoints for all preview routes and
  // coexists with /api/tui/session... on the same port). galleryDir is wired
  // through PreviewEndpoints so /api/gallery surfaces saved works.
  const { TuiBridgeServer } = await import('../dist/tui-bridge/TuiBridgeServer.js');
  const { TuiBridgeService } = await import('../dist/tui-bridge/TuiBridgeService.js');
  const { bootstrapProductionLiminalRuntime } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
  const liminalRuntime = await bootstrapProductionLiminalRuntime();
  const bridge = new TuiBridgeService({ ownerReactionPath: organismStatePath(),
    productCommands: liminalRuntime.port, productCreateCommand: liminalRuntime.createCommand,
    dreamCommands: liminalRuntime.dream,
    dreamTransferCommands: liminalRuntime.dreamTransfer,
    dreamActivationCommands: liminalRuntime.dreamActivation,
    compoundCreateCommands: liminalRuntime.compoundCreate });
  const server = new TuiBridgeServer(bridge, { port });
  const { resolveServeGalleryDirs } = await import('../dist/tui-bridge/TuiBridgeServer.js');
  const serveDirs = resolveServeGalleryDirs(flags.gallery);
  server.previewEndpoints.setGalleryDir(serveDirs.galleryDir);
  // #1711: also list what `generate` saved under ~/.sinter/output/artifacts (unless --gallery names a dir).
  server.previewEndpoints.setArtifactsDir(serveDirs.artifactsDir);

  function findLatestSketch(dirs) {
    let latestSketch = null;
    let latestTime = 0;

    for (const dir of dirs) {
      if (!fs.existsSync(dir)) continue;

      const files = fs.readdirSync(dir, { recursive: true })
        .filter(f => f.endsWith('.js'))
        .map(f => ({ file: f, path: path.join(dir, f), stat: fs.statSync(path.join(dir, f)) }))
        .filter(({ stat }) => stat.isFile());

      for (const { file, path: fullPath, stat } of files) {
        if (stat.mtimeMs > latestTime) {
          latestTime = stat.mtimeMs;
          latestSketch = { file, path: fullPath };
        }
      }
    }
    return latestSketch;
  }

  // Same roots the gallery lists: --gallery names the only root; otherwise the saved-output dir plus ./gallery (Sol F14).
  const searchDirs = flags.gallery
    ? [serveDirs.galleryDir]
    : [path.join(process.env.HOME || '/tmp', '.sinter', 'output'), serveDirs.galleryDir];

  const latestSketch = findLatestSketch(searchDirs);
  let sketchCode = '';

  if (latestSketch) {
    sketchCode = fs.readFileSync(latestSketch.path, 'utf-8');
    console.log('📄 Loading sketch:', latestSketch.file);
  } else {
    console.log('⚠️  No sketches found. Generate one first:');
    console.log('   sinter --prompt "your idea"');
  }

  server.previewEndpoints.serveSketch(sketchCode, latestSketch ? fs.statSync(latestSketch.path).mtimeMs : 0);
  const shutdown = async () => {
    await server.stop();
    await liminalRuntime.close();
    process.exit(0);
  };
  process.once('SIGINT', shutdown);
  process.once('SIGTERM', shutdown);
  server.start().then(() => {
    const boundPort = new URL(server.address).port || String(port);
    console.log('✅ Server running on http://localhost:' + boundPort);
  }).catch(err => {
    console.error('❌ Error starting server:', err.message);
    void liminalRuntime.close();
    process.exit(1);
  });
}
else if (cmd === 'compost') {
  // Check for dual-model configuration
  let llm;
  let fastLLM;
  let modelRouter;

  // Check if dual-model flags are provided
  const hasDualModelFlags = flags.fastModel || flags.powerfulModel || flags.routingMode;

  if (hasDualModelFlags) {
    // Dual-model mode: create ModelRouter with two LLM clients
    const fastModelName = flags.fastModel || 'qwen3.5:9b';
    const powerfulModelName = flags.powerfulModel || 'qwen3:30b-a3b';
    const routingMode = flags.routingMode || 'cascade';
    const confidenceThreshold = flags.confidenceThreshold ?? 0.8;

    console.log(`[Compost] Dual-model mode:`);
    console.log(`  Fast model: ${fastModelName}`);
    console.log(`  Powerful model: ${powerfulModelName}`);
    console.log(`  Routing mode: ${routingMode}`);
    console.log(`  Confidence threshold: ${confidenceThreshold}`);
    console.log('');

    // Create primary (fast) LLM client
    const primaryLLM = new LLMClient({
      role: 'generator',
      provider: 'ollama',
      baseUrl: process.env.LIMINAL_LLM_BASE_URL || 'http://localhost:11434',
      model: fastModelName,
    });

    // Create secondary (powerful) LLM client
    const secondaryLLM = new LLMClient({
      role: 'generator',
      provider: 'ollama',
      baseUrl: process.env.LIMINAL_LLM_BASE_URL || 'http://localhost:11434',
      model: powerfulModelName,
    });

    // Create ModelRouter
    modelRouter = new ModelRouter(primaryLLM, secondaryLLM, {
      primary: {
        provider: 'ollama',
        model: fastModelName,
        temperature: 0.7,
        maxTokens: 2000,
      },
      secondary: {
        provider: 'ollama',
        model: powerfulModelName,
        temperature: 0.7,
        maxTokens: 2000,
      },
      routing: {
        mode: routingMode,
        confidenceThreshold,
        primaryConcurrency: 8,
        secondaryConcurrency: 4,
      },
    });

    // Use the router as the main LLM
    llm = modelRouter;
    fastLLM = primaryLLM; // For backward compatibility with fastLLM parameter
  } else {
    // Single-model mode (original behavior)
    llm = new LLMClient({ role: 'generator' });
    fastLLM = new LLMClient({ role: 'generator', provider: 'lmstudio' });
  }

  // Compost rehydrate subcommand — handled before parseArgs delegation
  if (cmdArgs[0] === 'rehydrate') {
    const { CompostRehydrator } = await import('../dist/compost/CompostRehydrator.js');
    const { CompostHeap } = await import('../dist/compost/CompostHeap.js');
    const { CompostShredder } = await import('../dist/compost/CompostShredder.js');

    const heap = new CompostHeap({ heapDir: path.join(process.cwd(), '.sinter', 'compost', 'heap') });
    const heapFiles = await heap.listFiles();
    if (heapFiles.length === 0) {
      console.log('No files in heap to rehydrate.');
      process.exit(0);
    }

    // Read heap files and shred into fragments
    const allFragments = [];
    for (const relPath of heapFiles) {
      const fullPath = path.join(process.cwd(), '.sinter', 'compost', 'heap', relPath);
      try {
        const content = fs.readFileSync(fullPath, 'utf-8');
        const frags = CompostShredder.shredSemantic(content, relPath, 'compost');
        allFragments.push(...frags);
      } catch (_) { /* skip unreadable files */ }
    }

    if (allFragments.length === 0) {
      console.log('No fragments extracted from heap files.');
      process.exit(0);
    }

    const rehydrator = new CompostRehydrator();
    const rehydratable = rehydrator.findRehydratable(allFragments);
    if (rehydratable.length === 0) {
      console.log('No fragments meet the motif density threshold for rehydration.');
      process.exit(0);
    }

    const candidates = rehydrator.rehydrate(rehydratable);
    console.log('');
    console.log(`Rehydrated ${candidates.length} candidates from ${rehydratable.length} fragments (${heapFiles.length} heap files):`);
    for (const c of candidates) {
      console.log(`  motifDensity=${c.motifDensity.toFixed(3)} complexity=${c.complexity.toFixed(3)} complete=${c.isComplete} sources=${c.sourceIds.length}`);
    }
    console.log('');
    process.exit(0);
  }

  const action = parseArgs(leafArgv());

  // Bootstrap metabolic entropy engine
  const { EventStore } = await import('../dist/compost/EventStore.js');
  const { MetabolicEntropyEngine } = await import('../dist/entropy/MetabolicEntropyEngine.js');
  const { initializeTelemetry, getTelemetry } = await import('../dist/guardrails/observation/TelemetryCollector.js');

  const eventStore = new EventStore({ projectRoot: process.cwd() });
  eventStore.init();

  let telemetry = getTelemetry();
  if (!telemetry) {
    telemetry = initializeTelemetry({ enabled: true, sampleRate: 1.0 });
  }

  const entropyEngine = new MetabolicEntropyEngine({
    eventStore,
    heap: { listFiles: async () => [] },
    telemetry,
  });

  // Timeline commands (log/undo/branch/history) read and write the project's event store; without one they only
  // printed "Project history is not enabled". Open it in the project directory for exactly those actions.
  let projectStore;
  if (['log', 'undo', 'branch', 'history'].includes(action.command)) {
    const { ProjectStore } = await import('../dist/compost/ProjectStore.js');
    projectStore = new ProjectStore({ projectRoot: process.cwd() });
    projectStore.init();
  }
  const mill = new CompostMill(llm, { soupEnabled: true, fastLLM, modelRouter, entropy: entropyEngine,
    ...(projectStore ? { projectStore } : {}) });
  // Product-owned fix (CEO 2026-09-19): bind executor transport authority around compost
  // LLM work — the mill ran bare (#717) and its fragment scorer degraded to neutral 5/10.
  const { bootstrapExecutorAuthority } = await import('../dist/identity/executorAuthorityBootstrap.js');
  const { withHarnessTransportAuthority } = await import('../dist/llm/LLMClient.js');
  let transportAuthority;
  try { transportAuthority = bootstrapExecutorAuthority(); }
  catch (authErr) { console.error('[Compost] executor authority unavailable — LLM scoring degrades to neutral:', authErr.message); }
  const runCompost = () => execute(action, mill);
  await (transportAuthority
    ? withHarnessTransportAuthority(transportAuthority, runCompost)
    : runCompost()
  ).catch(err => {
    console.error('Compost error:', err.message);
    process.exit(1);
  });
  process.exit(0);
}
else if (cmd === 'composite') {
  const specPath = flags.spec;
  if (!specPath) {
    console.error('Usage: sinter composite --spec <spec.json> [--output <plan.json>] [--render [--render-out <dir>]]');
    process.exit(1);
  }

  const { Compositor } = await import('../dist/composite/Compositor.js');
  const { CompositionAnalyzer } = await import('../dist/composition/CompositionAnalyzer.js');
  try {
    const specJson = fs.readFileSync(specPath, 'utf-8');
    const spec = JSON.parse(specJson);
    const compositor = new Compositor();
    compositor.validateSpec(spec);

    console.log('Composition Spec Analysis');
    console.log(`  Layers: ${spec.layers?.length ?? 0}`);

    const analyzer = new CompositionAnalyzer();

    // Map compositor layer types (video/image/audio) to composition domain hints
    const typeToDomain = { video: 'p5', image: 'svg', audio: 'tone' };

    for (const layer of spec.layers ?? []) {
      const domainHint = typeToDomain[layer.type] || layer.type;
      const recommendations = await analyzer.analyze(`Generate ${domainHint} visual`);
      console.log(`  [${layer.type} -> ${domainHint}] confidence=${recommendations[0]?.confidence ?? 'n/a'} reason=${recommendations[0]?.reason ?? 'n/a'}`);
    }

    // Note: PromptEnhancer requires full composition Layer objects (with .type, .enabled,
    // .metadata.prompt) which compositor stub layers don't provide. Skip enhancement here
    // — it's available via the composition pipeline when layers are created through generators.

    const outputPath = flags.output;
    if (outputPath) {
      const plan = { spec, analyzedAt: new Date().toISOString(), layers: spec.layers?.length ?? 0 };
      fs.writeFileSync(outputPath, JSON.stringify(plan, null, 2));
      console.log(`  Plan written to: ${outputPath}`);
    }
    if (flags.render) {
      // The validated spec becomes a compose spec (the real source media of each layer, embedded), and the
      // existing compose path renders it to composition.html.
      const renderDir = path.resolve(flags.renderOut || 'composite-render');
      fs.mkdirSync(renderDir, { recursive: true });
      // Each spec layer renders its own media: the source file is embedded (data URI) in an html layer, so the page holds
      // the real picture, clip or sound. Blend and opacity are applied by compose. Code is supplied, so no provider call.
      const mimeOf = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.webp': 'image/webp', '.svg': 'image/svg+xml',
        '.mp4': 'video/mp4', '.webm': 'video/webm', '.mov': 'video/quicktime', '.wav': 'audio/wav', '.mp3': 'audio/mpeg', '.ogg': 'audio/ogg', '.m4a': 'audio/mp4', '.flac': 'audio/flac' };
      const maxLayerBytes = 24 * 1024 * 1024;
      const layerHtml = (layer) => {
        const src = path.resolve(layer.source);
        if (!fs.existsSync(src)) throw new Error('layer source not found: ' + layer.source);
        const bytes = fs.readFileSync(src);
        if (bytes.length > maxLayerBytes) throw new Error('layer source over ' + (maxLayerBytes >> 20) + ' MB cannot be embedded: ' + layer.source);
        const mime = mimeOf[path.extname(src).toLowerCase()];
        if (!mime) throw new Error('layer source type not supported: ' + layer.source);
        const uri = 'data:' + mime + ';base64,' + bytes.toString('base64');
        const css = '<style>html,body{margin:0;height:100%;background:transparent;overflow:hidden}.m{width:100%;height:100%;object-fit:cover;display:block}</style>';
        const el = mime.startsWith('image/') ? '<img class="m" alt="" src="' + uri + '">'
          : mime.startsWith('video/') ? '<video class="m" src="' + uri + '" autoplay muted loop playsinline></video>'
          : '<audio src="' + uri + '" autoplay loop controls></audio>';
        return '<!doctype html><html><head><meta charset="utf-8">' + css + '</head><body>' + el + '</body></html>';
      };
      const composeSpec = {
        title: 'Composite ' + spec.width + 'x' + spec.height,
        layers: (spec.layers ?? []).map(layer => ({
          domain: 'html',
          prompt: 'Layer from ' + path.basename(layer.source),
          code: layerHtml(layer),
          ...(layer.blend ? { blendMode: layer.blend } : {}),
          ...(layer.opacity !== undefined ? { opacity: layer.opacity } : {}),
        })),
      };
      const composeSpecPath = path.join(renderDir, 'composite.compose-spec.json');
      fs.writeFileSync(composeSpecPath, JSON.stringify(composeSpec, null, 2));
      const { spawnSync } = await import('node:child_process');
      const composed = spawnSync(process.execPath, [fileURLToPath(import.meta.url), 'compose', '--spec', composeSpecPath, '--output', renderDir], { stdio: 'inherit', env: process.env });
      if (composed.status !== 0) { console.error('Composite render failed: compose exited ' + composed.status); process.exit(composed.status || 1); }
      console.log('Rendered: ' + path.join(renderDir, 'composition.html'));
    }
    console.log('Done.');
    process.exit(0);
  } catch (err) {
    console.error('Composite analysis failed:', err.message);
    process.exit(1);
  }
}
else if (cmd === 'compose') {
  // End-to-end layered work: generate every layer via the domain generators and
  // assemble one standalone composite HTML (stacked, blended visual layers +
  // audio). This is the "combine outputs" path — Sinter's core mixing capability.
  let specPath = flags.spec;
  const campaignExecutionPath = flags.campaignExecution;
  const nlPrompt = flags.prompt || (cmdArgs.length ? cmdArgs.join(' ') : undefined);
  let composeLoopsN = 1;
  if (flags.loops !== undefined) {
    try { composeLoopsN = (await import('../dist/cli/LiminalProductionLoops.js')).parseLoopsFlag(flags.loops); } catch (error) {
      console.error('Error: ' + error.message); process.exit(1);
    }
    if (composeLoopsN > 1 && (specPath || flags.w9Brief || campaignExecutionPath || flags.regenerateLayer || !nlPrompt)) {
      console.error('Error: compose --loops N revises a layered piece made from an idea: use --prompt "<idea>" (a frozen --spec, --campaign-execution, --w9-brief or --regenerate-layer has no idea to improve).');
      process.exit(1);
    }
  }
  if (flags.retryUnknown && composeLoopsN === 1) {
    console.error('Error: compose --retry-unknown requires --loops N with N greater than 1.');
    process.exit(1);
  }
  if (flags.w9Brief) {
    // Wave 9 campaign briefs: three frozen multi-node CompositionGraphs. `list` shows them; an id composes that graph.
    const { W9_BRIEFS } = await import('../dist/creative-run/w9Briefs.js');
    if (flags.w9Brief === 'list') {
      for (const b of W9_BRIEFS) console.log(`${b.id.padEnd(12)} ${String(b.graph.nodes.length).padStart(2)} nodes  ${b.medium.padEnd(5)} ${b.title}`);
      process.exit(0);
    }
    const brief = W9_BRIEFS.find((b) => b.id === flags.w9Brief);
    if (!brief || specPath || nlPrompt) {
      console.error(brief ? 'Error: --w9-brief replaces --spec/--prompt' : `Error: unknown --w9-brief "${flags.w9Brief}" (try: list)`);
      process.exit(1);
    }
    const w9Dir = path.resolve(flags.output || 'output');
    fs.mkdirSync(w9Dir, { recursive: true });
    specPath = path.join(w9Dir, `w9-${brief.id}.graph.json`);
    fs.writeFileSync(specPath, JSON.stringify(brief.graph, null, 2));
    console.log(`🧩 W9 brief "${brief.title}": ${brief.graph.nodes.length} nodes -> ${path.basename(specPath)}`);
  }
  if (!specPath && !campaignExecutionPath && !nlPrompt && !flags.regenerateLayer) {
    console.error('Usage: sinter compose (--prompt "<idea>" | --spec <spec.json> | --campaign-execution <json>) [-o <dir>] [--export-layer <index>] [--campaign-manifest <json> --owner-review-package <json>]');
    console.error('       sinter compose --regenerate-layer <id> [-o <existing-dir>] [--spec <override.json>]');
    console.error('  --prompt: an LLM decomposes the idea into layers, then composes them');
    console.error('  --spec:   a CompositionGraph v2, or legacy { "title", "background", "layers": [...] }');
    console.error('  export writes composition.html plus the versioned composition.layers.json plan');
    console.error('  --export-layer: additionally save the zero-based non-base layer as a transparent PNG');
    console.error('  --regenerate-layer: replace one persisted layer by stable ID; siblings stay unchanged');
    console.error('  domains: p5, three, shader, hydra, ascii, html, tone, strudel');
    console.error('  layered (SINTER_LAYERED=1; --hybrid and SINTER_HYBRID_LAYERS=1 are aliases): S1NTR chooses single vs layered, domains, roles, palette, tempo and signals,');
    console.error('    and records why in composition.hybrid.json + medium.json. --layers "glsl:background,kinetic:overlay,tone:sound" fixes the layers.');
    process.exit(1);
  }
  if ((flags.maxProviderCalls !== undefined || flags.attempt) &&
    (specPath || campaignExecutionPath || flags.regenerateLayer)) {
    console.error('Error: compose --max-provider-calls and --attempt require --prompt for a generated composition.');
    process.exit(1);
  }
  const composePerLoop = flags.maxProviderCalls ?? 8;
  if (composeLoopsN > 1 && (!Number.isSafeInteger(composePerLoop) || composePerLoop < 1)) {
    console.error('Error: compose --loops requires a positive safe integer for --max-provider-calls.');
    process.exit(1);
  }
  let hybridLayers;
  try {
    if (flags.hybridLayers) {
      hybridLayers = (await import('../dist/composition/hybrid/HybridPlan.js')).parseLayerList(flags.hybridLayers);
    }
  } catch (error) {
    console.error('Error: --layers ' + error.message);
    process.exit(1);
  }
  if (flags.hybrid || flags.hybridLayers) process.env.SINTER_LAYERED = '1';
  const outDir = flags.output || 'output';
  let composePrompt = nlPrompt;
  let composeReverse = null;
  if (flags.ref !== undefined || flags.arc !== undefined || flags.duration !== undefined || flags.cues !== undefined) {
    try {
      if (specPath || campaignExecutionPath || flags.regenerateLayer || !nlPrompt) {
        throw new Error('--ref/--arc/--duration/--cues work with a compose prompt, not --spec, --campaign-execution or --regenerate-layer');
      }
      const { isImagePath, parseReverseFlags, prepareReverseGoverned } = await import('../dist/cli/ReverseCli.js');
      const { applyReverseBrief } = await import('../dist/reverse/ReverseBrief.js');
      const reverseFlags = parseReverseFlags(flags);
      if (reverseFlags.arcPath && isImagePath(reverseFlags.arcPath)) {
        if (flags.maxProviderCalls !== undefined) {
          throw new Error('compose cannot include an image --arc in --max-provider-calls. Pass a JSON or SVG arc to keep the provider cap.');
        }
        console.log('🧾 Image arc analysis has a separate one-request limit before composition.');
      }
      const replayImageArcOnly = composeLoopsN > 1 && (flags.retryUnknown || fs.existsSync(path.join(outDir, 'loops-manifest.json')));
      const prepared = await prepareReverseGoverned(reverseFlags, path.resolve(outDir), { replayImageArcOnly });
      for (const line of prepared.notices) console.log('🔁 ' + line);
      composeReverse = prepared.brief;
      composePrompt = applyReverseBrief(nlPrompt, composeReverse);
    } catch (error) {
      console.error(`Error: ${error.message}`);
      process.exit(1);
    }
  }
  if (flags.regenerateLayer) {
    try {
      const planPath = path.join(outDir, 'composition.layers.json');
      const plan = JSON.parse(fs.readFileSync(planPath, 'utf8'));
      const target = plan.layers?.find(layer => layer.id === flags.regenerateLayer);
      if (!target) throw new Error('Unknown layer ID: ' + flags.regenerateLayer);
      let overrideSpec;
      if (specPath) {
        const override = JSON.parse(fs.readFileSync(specPath, 'utf8'));
        overrideSpec = override.layers?.[target.sourceIndex];
        if (!overrideSpec) {
          throw new Error('Override spec has no layer at source index ' + target.sourceIndex);
        }
      }
      const { regenerateLayerBundle } = await import('../dist/composition/LayerRegeneration.js');
      const regenerated = await regenerateLayerBundle(
        planPath,
        flags.regenerateLayer,
        overrideSpec,
      );
      console.log('✅ Regenerated layer: ' + regenerated.target.id);
      console.log('✅ Artifact: ' + regenerated.target.artifact.path);
      console.log('✅ Previous SHA-256: ' + regenerated.previousSha256);
      console.log('✅ Current SHA-256: ' + regenerated.target.artifact.sha256);
      process.exit(0);
    } catch (err) {
      console.error('Layer regeneration failed:', err.message);
      process.exit(1);
    }
  }
  const { CreativeRunCoordinator } = await import('../dist/creative-run/CreativeRunCoordinator.js');
  const { harnessMemory } = await import('../dist/harness/HarnessMemory.js');
  try {
    let coordinator;
    let campaign;
    let campaignExecution;
    let ownerReviewPackage;
    let campaignService;
    if (flags.campaignManifest) {
      const ownerPackagePath = flags.ownerReviewPackage || process.env.SINTER_CAMPAIGN_OWNER_REVIEW_PACKAGE;
      if (!ownerPackagePath) throw new Error('Governed campaign requires --owner-review-package');
      if (!campaignExecutionPath || specPath || nlPrompt) {
        throw new Error('Governed campaign requires only --campaign-execution with all frozen slot graphs');
      }
      const { loadProductionOwnerReviewPackage } = await import('../dist/cli/ProductionOwnerReview.js');
      ownerReviewPackage = loadProductionOwnerReviewPackage(ownerPackagePath);
      const signingKeyPath = process.env.SINTER_CAMPAIGN_SIGNING_KEY;
      const keyId = process.env.SINTER_CAMPAIGN_KEY_ID;
      const ledgerPath = process.env.SINTER_CAMPAIGN_ADMISSION_LEDGER;
      if (!signingKeyPath || !keyId || !ledgerPath) {
        throw new Error('Governed campaign requires SINTER_CAMPAIGN_SIGNING_KEY, SINTER_CAMPAIGN_KEY_ID, and SINTER_CAMPAIGN_ADMISSION_LEDGER');
      }
      campaign = JSON.parse(fs.readFileSync(flags.campaignManifest, 'utf8'));
      campaignExecution = JSON.parse(fs.readFileSync(campaignExecutionPath, 'utf8'));
      ownerReviewPackage.assertManifestCoverage(campaign);
      const { createCampaignAuthority, FileCampaignAdmissionStore } = await import('../dist/runtime-core/CampaignOrigin.js');
      const { assertWave8GovernedCampaignPreflight,
        assertWave8GovernedCampaignArtifacts } = await import('../dist/llm/PreSpendInterlock.js');
      const { installCampaignLiveAuthority } = await import('../dist/cli/CampaignCli.js');
      installCampaignLiveAuthority();
      assertWave8GovernedCampaignArtifacts({ manifestPath: flags.campaignManifest,
        executionPath: campaignExecutionPath, ownerReviewPackagePath: ownerPackagePath });
      coordinator = new CreativeRunCoordinator({
        campaignAuthority: createCampaignAuthority({ keyId,
          privateKeyPem: fs.readFileSync(signingKeyPath, 'utf8'),
          admissionStore: new FileCampaignAdmissionStore(ledgerPath) }),
        campaignPreflight: async () => assertWave8GovernedCampaignPreflight(),
      });
      const { CampaignService } = await import('../dist/creative-run/CampaignService.js');
      campaignService = CampaignService.shared(coordinator);
    } else {
      coordinator = new CreativeRunCoordinator();
    }
    let result;
    let campaignResult;
    let campaignOwnerReviews;
    if (campaign) {
      console.log('🎨 Composing ' + campaignExecution.slotGraphs.length + ' frozen candidate graphs...');
      console.log('');
      const { runCampaignCliJourney } = await import('../dist/cli/CampaignCli.js');
      const journey = await runCampaignCliJourney(campaignService,
        { entryPoint: 'cli-compose', requestKey: campaign.campaignRunId },
        campaign, ownerReviewPackage.plan, {
          input: campaignExecution,
          ownerReviewBriefIds: ownerReviewPackage.briefIds,
          ownerReviews: async (admission, candidateManifests) => ownerReviewPackage.buildInputs(
            campaignService, admission, campaign, candidateManifests,
            await ownerReviewPackage.captureEvidence(candidateManifests)),
        });
      campaignResult = journey.result;
      campaignOwnerReviews = journey.ownerReviews;
      const first = campaignResult?.executions[0]?.composition;
      if (!first) throw new Error('Governed campaign returned no executed candidate artifacts');
      result = { ...first };
      for (const review of journey.ownerReviews ?? []) {
        console.log('🔎 Owner review: ' + review.handle.url);
      }
    } else if (specPath) {
      const spec = JSON.parse(fs.readFileSync(specPath, 'utf-8'));
      console.log('🎨 Composing ' + (spec.nodes?.length ?? spec.layers?.length ?? 0) + ' graph nodes...');
      console.log('');
      // A spec layer with a prompt calls the provider: open the same receipted grant the --prompt branch uses.
      const { runProductionCliCycleEffect } = await import('../dist/cli/LiminalProductionProviderEffect.js');
      const { randomUUID: specRunId } = await import('node:crypto');
      result = await runProductionCliCycleEffect({
        idempotencyKey: 'production-compose-spec:' + specRunId(),
        binding: { surface: 'compose-spec', specPath: path.resolve(specPath) },
        maxGeneratorAttempts: flags.maxProviderCalls ?? (Array.isArray(spec.nodes) ? spec.nodes.length
          : Array.isArray(spec.layers) ? spec.layers.length : 0),
        effect: () => coordinator.compose(spec, { entryPoint: 'cli-compose' }),
      });
    } else {
      console.log('🧩 Decomposing idea into layers...');
      console.log('');
      const { runProductionCliCompose } = await import('../dist/cli/LiminalProductionCompose.js');
      if (composeLoopsN > 1) {
        // Improvement loops for layered pieces: loops/rK each a governed compose; loop k+1 carries loop k's plan, layer code, stills and critique.
        const { runComposeLoops } = await import('../dist/cli/LiminalProductionComposeLoops.js');
        const perLoop = composePerLoop;
        console.log(`🧾 Provider budget: ${perLoop} per loop x ${composeLoopsN} loops = ${perLoop * composeLoopsN} (planner call + regenerated layers; kept layers cost none)`);
        const looped = await runComposeLoops({ prompt: composePrompt, outputRoot: path.resolve(outDir), loops: composeLoopsN, delegate: coordinator,
          providerCallsPerLoop: perLoop, attemptId: flags.attempt, retryUnknown: flags.retryUnknown, retryArgs: args, reverseProvenance: composeReverse?.provenance,
          ...(hybridLayers ? { hybridLayers } : {}), log: (l) => console.log('♻️  ' + l) });
        const m = looped.manifest;
        console.log('');
        console.log(`🏁 Loops: ${m.records.map((r) => `r${r.loop}=${r.status === 'failed' ? 'FAILED' : r.score === null ? 'unscored' : r.score.toFixed(2)}${r.best ? '*' : ''}`).join('  ')}  (* = best${m.bestBasis === 'last-unscored' ? ', last loop: no numeric score for this piece' : ''}; manifest ${path.join(path.resolve(outDir), 'loops-manifest.json')})`);
        console.log(`🧾 Provider calls: ${m.providerCallsConsumed}/${m.providerCallBudget}${m.providerCallsUnverified ? ` (+ ${m.providerCallsUnverified} unverified)` : ''}`);
        if (typeof flags.retryUnknown === 'number') {
          const target = m.records.find(record => record.loop === flags.retryUnknown);
          console.log(`Loop ${flags.retryUnknown}: ${target.status} (${target.outputRoot})`);
          process.exit(target.status === 'failed' ? 1 : 0);
        }
        if (looped.bestFolder === null) {
          console.error('❌ No loop produced a piece. See loops-manifest.json for each loop\'s error.');
          process.exit(1);
        }
        const { publishComposeLoop } = await import('../dist/cli/LiminalProductionComposeLoops.js');
        const published = await publishComposeLoop(looped, path.resolve(outDir), {
          exportLayer: flags.exportLayer,
          galleryDir: flags.gallery ? path.resolve(flags.gallery) : undefined,
        });
        if (published.layerPng) console.log('✅ Transparent layer PNG: ' + published.layerPng);
        if (published.provenance) console.log('🧾 Reverse provenance: ' + published.provenance);
        if (published.gallery) console.log('🖼️  Gallery: ' + published.gallery.slug + ' v' + published.gallery.version);
        console.log(`⭐ Best loop: r${looped.bestLoop} (copied to ${path.resolve(outDir)}; every loop is saved in loops/rK)`);
        console.log('✅ Saved: ' + path.join(outDir, 'composition.html'));
        process.exit(0);
      }
      const { hashReverseProvenance } = await import('../dist/reverse/ReverseBrief.js');
      const governed = await runProductionCliCompose({
        prompt: composePrompt,
        outputRoot: path.resolve(outDir),
        attemptId: flags.attempt,
        maxProviderCalls: flags.maxProviderCalls,
        referenceProvenanceSha256: composeReverse ? hashReverseProvenance(composeReverse.provenance) : undefined,
        ...(hybridLayers ? { hybridLayers } : {}),
      }, coordinator);
      result = governed.result;
    }
    fs.mkdirSync(outDir, { recursive: true });
    if (composeReverse) {
      const { writeReverseProvenance } = await import('../dist/cli/ReverseCli.js');
      console.log('🧾 Reverse provenance: ' + await writeReverseProvenance(outDir, composeReverse.provenance));
    }
    if (campaignResult) {
      const candidateDir = path.join(outDir, 'campaign-candidates');
      fs.mkdirSync(candidateDir, { recursive: true });
      for (const execution of campaignResult.executions) {
        const name = encodeURIComponent(execution.briefId + '--' + execution.candidateSlotId);
        fs.writeFileSync(path.join(candidateDir, name + '.html'), execution.composition.html, 'utf8');
      }
      for (const manifest of campaignResult.candidateManifests) {
        const name = encodeURIComponent(manifest.briefId);
        fs.writeFileSync(path.join(candidateDir, name + '.manifest.json'),
          JSON.stringify(manifest, null, 2));
      }
    }
    if (campaignResult?.campaignEvidenceCheckpoint) {
      fs.writeFileSync(path.join(outDir, 'campaign-evidence-checkpoint.json'),
        JSON.stringify(campaignResult.campaignEvidenceCheckpoint, null, 2));
    }
    if (campaignOwnerReviews) {
      fs.writeFileSync(path.join(outDir, 'campaign-owner-review-handles.json'),
        JSON.stringify(campaignOwnerReviews.map((review) => ({ briefId: review.packet.briefId,
          packetDigest: review.packet.packetDigest, reviewDigest: review.bundle.reviewDigest,
          url: review.handle.url })), null, 2));
    }
    const htmlPath = path.join(outDir, 'composition.html');
    if (!result.hybridPlan) fs.writeFileSync(htmlPath, result.html, 'utf-8');
    // Say what S1NTR built. Hybrid pieces also get the plan, the render check and the stills.
    try {
      const mediumFile = path.join(outDir, 'medium.json');
      if (result.hybridPlan) {
        const { writeHybridArtifacts } = await import('../dist/composition/hybrid/HybridComposition.js');
        const art = await writeHybridArtifacts(outDir, result, { plan: result.hybridPlan, html: result.html, build: result.hybridBuild });
        console.log('🧭 ' + art.medium.made_with);
        console.log('🔎 Hybrid render check: ' + art.judgement.verdict.toUpperCase()
          + (art.judgement.frameChange !== undefined ? ' — early/late frame change ' + art.judgement.frameChange.toFixed(4) : '')
          + (art.judgement.reason ? ' (' + art.judgement.reason + ')' : ''));
        console.log('✅ Hybrid manifest: ' + art.manifestPath);
      } else if (result.successCount > 0) {
        const { describeMedium } = await import('../dist/core/MediumLine.js');
        const ok = result.layers.filter(l => l.generated);
        const record = describeMedium({ domain: ok[0].domain, source: '',
          renderTarget: 'one self-contained page of stacked layers',
          decision: { source: 'planner', reason: 'the decomposition planner split the idea into ' + ok.length + ' layer(s); it did not record per-layer reasons (set SINTER_LAYERED=1 for that)' },
          layers: ok.map((l, i) => ({ id: 'layer-' + i, domain: l.domain, role: i === 0 ? 'background' : 'overlay' })) });
        fs.writeFileSync(mediumFile, JSON.stringify(record, null, 2) + '\n');
        console.log('🧭 ' + record.made_with);
      }
    } catch (mediumErr) {
      console.error('❌ ' + mediumErr.message);
      process.exit(1);
    }
    const { writeLayerPlan, compositionOutcomeLines } = await import('../dist/composition/LayerPlan.js');
    let layerPlanPath;
    if (result.successCount > 0) {
      layerPlanPath = path.join(outDir, 'composition.layers.json');
      await writeLayerPlan(layerPlanPath, result);
    }
    let layerPngPath;
    if (flags.exportLayer !== undefined) {
      const { renderLayerPng } = await import('../dist/composition/LayerPngExporter.js');
      const png = await renderLayerPng(result.html, flags.exportLayer);
      layerPngPath = path.join(outDir, 'layer-' + flags.exportLayer + '.png');
      fs.writeFileSync(layerPngPath, png);
    }
    for (const l of result.layers) {
      console.log('  [' + l.domain + '] ' + (l.generated
        ? 'ok — ' + l.codeLength + ' chars, blend=' + l.blendMode + ' opacity=' + l.opacity
        : 'FAILED: ' + l.error));
    }
    console.log('');
    for (const line of compositionOutcomeLines(result.successCount, result.layers.length, htmlPath)) console.log(line);
    if (layerPlanPath) console.log('✅ Layer plan: ' + layerPlanPath);
    if (layerPngPath) console.log('✅ Transparent layer PNG: ' + layerPngPath);
    // Surface the measured-frame grade (luminance + seam) the composite render gate computed.
    if (result.renderGate) {
      const g = result.renderGate;
      if (g.skipped) {
        console.log('🔎 Render gate: skipped (' + g.skipped + ')');
      } else if (g.measure) {
        console.log('🔎 Render gate: ' + String(g.verdict).toUpperCase()
          + ' — luminance ' + g.measure.meanLuminance.toFixed(3)
          + ', spread ' + (g.measure.brightnessStd ?? 0).toFixed(1));
        if (g.remediation) {
          console.log('   remediation: demoted layers [' + g.remediation.demotedLayers.join(',') + '] → '
            + g.remediation.verdictAfter + (g.remediation.applied ? ' (applied)' : ' (reverted)'));
        }
      }
    }
    const seamLayers = result.layers.filter(l => l.opaqueBackground).map(l => l.domain);
    if (seamLayers.length) {
      console.log('⚠️  Seam risk: foreground layer(s) paint an opaque background — ' + seamLayers.join(', '));
    }
    // Persist to the gallery so composed works are first-class citizens — browsable
    // and versioned alongside single-domain generations (e.g. via `sinter serve`).
    if (result.successCount > 0) {
      try {
        const { Gallery } = await import('../dist/gallery/Gallery.js');
        const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');
        const galleryDir = flags.gallery ? path.resolve(flags.gallery) : path.join(resolveSinterProjectRoot(), 'gallery');
        const gallery = new Gallery(galleryDir);
        const { slug, version } = await gallery.recordComposition(result.html, {
          title: result.title,
          layers: result.layers.filter(l => l.generated).map(l => l.domain),
        });
        console.log('🖼️  Gallery: ' + slug + ' v' + version);
      } catch (galErr) {
        if (flags.gallery) throw galErr;
        console.log('⚠️  Gallery save skipped: ' + galErr.message);
      }
    }
    // Feed self-improvement: record this composition as a generation episode.
    try {
      await harnessMemory.initialize();
      harnessMemory.recordEpisode({
        type: 'generation',
        domain: 'composition',
        prompt: result.title + ' :: ' + result.layers.map(l => l.domain + ':' + l.prompt).join(' | '),
        code: result.html,
        score: result.layers.length ? result.successCount / result.layers.length : 0,
        tags: ['composition', ...result.layers.map(l => l.domain)],
      });
      await harnessMemory.save();
      console.log('🧠 Recorded composition episode for self-improvement');
    } catch (memErr) {
      console.log('⚠️  Episode not recorded: ' + memErr.message);
    }
    process.exit(result.successCount > 0 ? 0 : 1);
  } catch (err) {
    console.error('Compose failed:', err.message);
    if (err.stack) console.error(err.stack);
    process.exit(1);
  }
}
else if (cmd === 'chat') {
  // studio reflection works on saved sessions. The interactive surface is Studio.
  if (cmdArgs[0] === 'reflect') {
    const { runChatReflect } = await import('../dist/chat/commands/chatReflect.js');
    process.exit(await runChatReflect({ limit: parseInt(cmdArgs[1] || '10', 10) || 10 }));
  }
  console.error('The interactive chat panel is retired. Open sinter studio for a conversation.');
  console.error('Use sinter chat reflect [N] to send saved sessions for reflection.');
  process.exit(2);
}
else if (cmd === 'git') {
  handleGitCommand(cmdArgs[0], cmdArgs.slice(1)).then(() => {
    process.exit(0);
  }).catch(err => {
    console.error('Git error:', err.message);
    process.exit(1);
  });
}
else if (cmd === 'consolidate') {
  console.error('Legacy consolidation is retired; use governed Dream transfer and activation.');
  process.exit(2);
} else if (cmd === 'bridge') {
  // Standalone bridge server (no TUI launched)
  const port = parseInt(cmdArgs[0]) || 3000;
  import('../dist/tui-bridge/TuiBridgeServer.js').then(async ({ TuiBridgeServer }) => {
    const { TuiBridgeService } = await import('../dist/tui-bridge/TuiBridgeService.js');
    const { bootstrapProductionLiminalRuntime } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
    const liminalRuntime = await bootstrapProductionLiminalRuntime();
    const bridge = new TuiBridgeService({ ownerReactionPath: organismStatePath(),
      productCommands: liminalRuntime.port, productCreateCommand: liminalRuntime.createCommand,
      dreamCommands: liminalRuntime.dream,
      dreamTransferCommands: liminalRuntime.dreamTransfer,
      dreamActivationCommands: liminalRuntime.dreamActivation,
      compoundCreateCommands: liminalRuntime.compoundCreate });

    await LLMClient.loadRoles();
    const llm = new LLMClient({ role: 'generator' });
    const llmModel = process.env.LIMINAL_LLM_MODEL || 'auto';
    const llmProvider = process.env.LIMINAL_LLM_BASE_URL || 'config';

    const server = new TuiBridgeServer(bridge, { port, llm });
    await server.start();
    console.log('');
    console.log('Sinter TUI Bridge');
    console.log(`  Listening: ${server.address}`);
    console.log(`  LLM: ${llmProvider} / ${llmModel}`);
    console.log('');
    const shutdown = async () => {
      console.log('\nShutting down bridge...');
      await server.stop();
      await liminalRuntime.close();
      process.exit(0);
    };
    process.on('SIGINT', shutdown);
    process.on('SIGTERM', shutdown);
  }).catch(err => {
    console.error('Bridge error:', err.message);
    console.error('Make sure to run `pnpm build` first.');
    process.exit(1);
  });
}
else if (cmd === 'studio') {
  // Studio is the GUI-first workbench: Express bridge/API plus Vite browser app.
  const { spawn } = await import('child_process');
  const apiPort = parseInt(cmdArgs[0]) || 5174;
  const guiUrl = 'http://localhost:5173';
  const npmCmd = process.platform === 'win32' ? 'npm.cmd' : 'npm';
  const requiredStudioFiles = [
    'tsconfig.json',
    'scripts/utils/start-studio.js',
    'gui/package.json',
  ];
  const missingStudioFiles = requiredStudioFiles.filter((file) => !fs.existsSync(path.join(repoRoot, file)));

  if (missingStudioFiles.length > 0) {
    console.error('Sinter Studio requires a repository checkout; the npm package does not include the GUI development runtime.');
    console.error(`Missing: ${missingStudioFiles.join(', ')}`);
    console.error('Run from a cloned repo with `pnpm install`, then `pnpm gui` or `sinter studio`.');
    process.exit(1);
  }

  console.log('');
  console.log('◆ Sinter Studio');
  console.log(`  GUI: ${guiUrl}`);
  console.log(`  API: http://localhost:${apiPort}`);
  console.log('  Surface: GUI workbench with live preview and Improve lane');
  console.log('');

  const studio = spawn(npmCmd, ['run', 'gui'], {
    cwd: repoRoot,
    env: {
      ...process.env,
      PORT: String(apiPort),
      VITE_API_TARGET: `http://localhost:${apiPort}`,
    },
    stdio: 'inherit',
  });

  studio.on('exit', (code) => {
    process.exit(code ?? 0);
  });

  studio.on('error', (err) => {
    console.error('Failed to launch Sinter Studio:', err.message);
    process.exit(1);
  });
}
else if (cmd === 'quality') {
  const subCmd = cmdArgs[0];
  if (!subCmd || (subCmd !== 'run' && subCmd !== 'gate')) {
    console.error('Usage: sinter quality <run|gate>');
    console.error('  run   --spec <path>   Run a golden suite');
    console.error('  gate  --spec <path>   Block promotion on regression');
    console.error('  both need --candidates <dir>: one saved file per case id (<id>.html, <id>.glsl, ...)');
    process.exit(1);
  }

  const { EvaluationFabric } = await import('../dist/evaluation/EvaluationFabric.js');
  const { GoldenSuiteRunner } = await import('../dist/release/GoldenSuiteRunner.js');
  const { PromotionGate } = await import('../dist/release/PromotionGate.js');

  const suitePath = flags.spec;
  if (!suitePath) {
    console.error('Error: --spec <path> is required (path to golden suite JSON)');
    process.exit(1);
  }

  const suiteJson = fs.readFileSync(suitePath, 'utf-8');
  const suite = JSON.parse(suiteJson);
  if (!flags.candidates) {
    console.error('Error: --candidates <dir> is required: the gate judges saved output, one file per case id');
    process.exit(1);
  }
  const { loadGoldenCandidates } = await import('../dist/release/GoldenCandidates.js');
  let goldenCandidates;
  try { goldenCandidates = loadGoldenCandidates(suite, flags.candidates); }
  catch (e) { console.error(`Error: ${e.message}`); process.exit(1); }

  console.log('');
  console.log('◆ Sinter Quality Gate');
  console.log(`  Suite: ${suite.name} (${suite.cases.length} cases)`);
  console.log('');

  const runner = new GoldenSuiteRunner({
    qualityThreshold: flags.confidenceThreshold,
    onCaseComplete: (id, passed, score) => {
      const icon = passed ? 'PASS' : 'FAIL';
      console.log(`  ${icon} ${id}: ${score.toFixed(3)}`);
    },
  });

  const result = await runner.run(suite, goldenCandidates);
  console.log('');
  console.log(`  Result: ${result.aggregate.passed}/${result.aggregate.total} passed`);
  console.log(`  Average score: ${result.aggregate.averageScore.toFixed(3)}`);
  console.log(`  Duration: ${result.durationMs}ms`);

  if (subCmd === 'gate') {
    console.log('');
    const gate = new PromotionGate({ maxRegressions: 0 });
    const gateResult = gate.check(result.aggregate);
    console.log(gateResult.summary);
    console.log('');
    process.exit(gateResult.passed ? 0 : 1);
  } else {
    console.log(`  Suite passed: ${result.aggregate.suitePassed}`);
    console.log('');
    process.exit(result.aggregate.suitePassed ? 0 : 1);
  }
}
else if (cmd === 'fix') {
  // Fix command - auto-fix code issues with LLM assistance
  const fixTarget = cmdArgs[0];

  console.log('');
  console.log('🔧 Sinter Fix');
  console.log('');

  // Validate and normalize confirm option
  const confirmLevel = flags.confirm || 'ask';
  if (!['auto', 'ask', 'never'].includes(confirmLevel)) {
    console.error('Error: --confirm must be one of: auto, ask, never');
    process.exit(1);
  }

  if (!fixTarget && !flags.error && !flags.testFailures && !flags.testFile) {
    printFixUsage();
    process.exit(1);
  }

  // Build fix configuration from parsed arguments
  const fixConfig = {
    target: fixTarget,
    error: flags.error,
    testFailures: flags.testFailures,
    testFile: flags.testFile,
    dryRun: flags.dryRun,
    confirm: confirmLevel,
  };

  // Determine fix type based on arguments
  let fixType = 'natural-language';
  if (flags.testFailures) {
    fixType = 'test-failures';
  } else if (flags.testFile || flags.error || (fixTarget && fixTarget.match(/\.(ts|js|tsx|jsx)$/))) {
    fixType = 'file-error';
  }

  // Import and use AutoFixOrchestrator
  const { AutoFixOrchestrator } = await import('../dist/fix/index.js');
  const llmClient = new LLMClient({ role: 'generator' });
  const orchestrator = new AutoFixOrchestrator(llmClient);

  // Build and execute the fix request
  const fixRequest = {
    type: fixType,
    target: fixTarget || flags.testFile,
    errorDescription: flags.error || fixTarget, // For natural language, use target as description
    dryRun: flags.dryRun,
    confirmLevel: confirmLevel,
  };

  console.log('Starting fix...');
  console.log('  Type:', fixType);
  console.log('  Target:', fixRequest.target || '(none)');
  console.log('');

  try {
    // LLMModeAgent's provider calls need a journal-reserved generator grant
    // (#710). Unique key per run: a repeat fix must run again, not replay.
    const { runProductionCliProviderEffect } =
      await import('../dist/cli/LiminalProductionProviderEffect.js');
    const result = await runProductionCliProviderEffect({
      idempotencyKey: 'production-fix:' + randomUUID(),
      binding: { surface: 'cli-fix', type: fixType, target: fixRequest.target ?? null },
      effect: () => orchestrator.executeFix(fixRequest),
    });

    console.log('');
    if (result.success) {
      console.log('✅ Fix completed successfully!');
      if (result.error) {
        console.log('   Notice:', result.error);
      }
    } else {
      console.log('❌ Fix failed');
      if (result.error) {
        console.log('   Error:', result.error);
      }
    }
    console.log('   Task ID:', result.taskId);
    console.log('   Changes:', result.changes.length);
    if (fixRequest.dryRun) {
      console.log('   Build passed: not run (dry run)');
      console.log('   Tests passed: not run (dry run)');
    } else {
      console.log('   Build passed:', result.buildPassed);
      console.log('   Tests passed:', result.testsPassed);
    }
    if (result.rolledBack) {
      console.log('   ⚠️  Changes were rolled back');
    }
    console.log('');

    process.exit(result.success ? 0 : 1);
  } catch (error) {
    console.error('❌ Fix execution error:', error.message);
    process.exit(1);
  }
}
else if (cmd === 'fs') {
  const subCmd = cmdArgs[0];
  const { SinterFS } = await import('../dist/fs/index.js');
  const sinterFs = SinterFS.open(process.cwd());

  try {
    if (subCmd === 'refs') {
      const refName = cmdArgs[1];
      if (!refName) {
        // List all refs
        const fs = await import('fs');
        const refsDir = path.join(process.cwd(), '.sinter', 'refs');
        if (!fs.existsSync(refsDir)) {
          console.log('No refs found.');
          process.exit(0);
        }
        const entries = fs.readdirSync(refsDir).filter(f => f.endsWith('.json'));
        console.log(`\n🔖 Refs (${entries.length}):\n`);
        for (const entry of entries) {
          console.log(`  ${entry.replace('.json', '')}`);
        }
        console.log('');
      } else {
        const ref = sinterFs.readRef(refName);
        if (!ref) {
          console.error(`Ref not found: ${refName}`);
          process.exit(1);
        }
        console.log(JSON.stringify(ref, null, 2));
      }
    } else if (subCmd === 'runs') {
      // Query EventStore for run_record events
      const projectStore = sinterFs.getProjectStore();
      const eventStore = projectStore.getEventStore();
      // EventStore has queryEvents method — use it to filter run_record events
      const events = eventStore.queryEvents({ type: 'run_record' });
      if (!events || events.length === 0) {
        console.log('No runs recorded.');
        process.exit(0);
      }
      console.log(`\n🏃 Runs (${events.length}):\n`);
      for (const event of events) {
        const data = event.payload || event.data || event;
        const runId = data.runId || 'unknown';
        const status = data.status || 'unknown';
        const project = data.project || '';
        console.log(`  ${String(runId).slice(0, 12)}…  ${String(status).padEnd(10)}  ${project}`);
      }
      console.log('');
    } else {
      console.log('Usage: sinter fs <artifacts|refs|runs>');
      console.log('  sinter fs artifacts          List all tracked artifacts');
      console.log('  sinter fs refs [name]        List refs or show specific ref');
      console.log('  sinter fs runs               List recorded runs');
      process.exit(1);
    }
  } finally {
    sinterFs.close();
  }
}
else if (cmd === 'second-judge') {
  // SECOND JUDGING PANEL (CEO 2026-08-30): completely independent re-scoring.
  // Round 1: gemini + minimax + glm-flash. Round 2: Sol (vision, API) +
  // glm-5.3 (vision, z.ai; replaced kimi-via-kilo 2026-09-01) + grok-4.5 (code, CLI).
  // Also: failure investigation for rejected generations.
  // Usage: sinter second-judge <artifact-dir>          (one piece)
  //        sinter second-judge --sweep                 (recent scored pieces)
  //        sinter second-judge --investigate           (failed generations)
  const sub = cmdArgs[0];
  const SJ_DIR = path.join(process.cwd(), '.omx', 'atelier', 'second-judge');
  const { readRequiredSinterConfig } = await import('../dist/cli/readRequiredSinterConfig.js');
  let sinterCfg;
  try { sinterCfg = readRequiredSinterConfig(sinterConfigPath(), 'second-judge'); }
  catch (error) { console.error('SECOND_JUDGE_CONFIG_INVALID: ' + error.message); process.exit(1); }
  fs.mkdirSync(SJ_DIR, { recursive: true });
  const KILO_KEY = sinterCfg.providers?.kilo?.apiKey || '';
  const SOL_KEY = sinterCfg.roles?.evaluator?.apiKey || '';
  const JUDGE_PROMPT_FULL = (domain) => 'Judge this generative artwork using ALL senses. You see: SCREENSHOT + SOURCE CODE + METADATA (motion, domain context, round-1 scores). Score D craft, A artistic, R reliability, N novelty. Each 1-10, be strict.' + (SINTER_DOMAIN_RUBRIC[domain] ? ' DOMAIN CRITERIA — weight these: ' + SINTER_DOMAIN_RUBRIC[domain] : '') + ' Output ONLY JSON: {"D":n,"A":n,"R":n,"N":n}';

  async function judgeWithSol(imgB64, code, meta, domain) {
    const body = JSON.stringify({ model: 'gpt-5.6-sol', max_tokens: 1500, messages: [{ role: 'user', content: [
      { type: 'text', text: JUDGE_PROMPT_FULL(domain) + '\n\nSOURCE CODE:\n```\n' + (code||'').slice(0, 8000) + '\n```\n\nCONTEXT: ' + (meta||'none') },
      { type: 'image_url', image_url: { url: `data:image/png;base64,${imgB64}` } }] }] });
    const res = await fetch('http://localhost:8317/v1/chat/completions', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${SOL_KEY}` }, body });
    const r = await res.json();
    return (r.choices || [{}])[0]?.message?.content || '';
  }
  async function judgeWithGlm(imgB64, code, meta, domain) {
    // 2026-09-01 second substitution: kimi-via-kilo was dead (negative balance);
    // the LAN champion model hangs on ANY image payload (probed: 64x64 png times
    // out - the "champion has vision" note failed the law-27 transport test).
    // GLM-5.3 @ z.ai accepts anthropic-format image blocks in ~2s (probed) and
    // is MECE vs the R1 panel (R1 carries glm-5.3-FLASH, a different model;
    // family overlap noted honestly). Record key 'glm-5.3'.
    const GLM_KEY = sinterCfg.providers?.glm?.apiKey || sinterCfg.roles?.harness?.apiKey || '';
    const body = JSON.stringify({ model: 'glm-5.3', max_tokens: 4000, thinking: { type: 'disabled' }, messages: [{ role: 'user', content: [
      { type: 'text', text: JUDGE_PROMPT_FULL(domain) + '\n\nSOURCE CODE:\n```\n' + (code||'').slice(0, 8000) + '\n```\n\nCONTEXT: ' + (meta||'none') },
      { type: 'image', source: { type: 'base64', media_type: 'image/png', data: imgB64 } }] }] });
    const res = await fetch('https://api.z.ai/api/anthropic/v1/messages', { method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-key': GLM_KEY, 'anthropic-version': '2023-06-01' }, body, signal: AbortSignal.timeout(180000) });
    const r = await res.json();
    const blocks = Array.isArray(r.content) ? r.content : [];
    return blocks.filter(b => b.type === 'text').map(b => b.text || '').join('');
  }
  async function judgeWithGrok(imgB64, code, meta, domain) {
    // Grok via CLI subscription (not kilo API) — reads code + visual metrics
    const { execFile } = await import('node:child_process');
    const prompt = JUDGE_PROMPT_FULL(domain) + '\n\nNOTE: You receive code + visual metrics (not the raw screenshot). Judge code craft from source, aesthetics from the visual metrics + code logic.\n\nSOURCE CODE:\n```\n' + (code||'').slice(0, 10000) + '\n```\n\nVISUAL + MOTION DATA: ' + (meta||'none') + '\n\nOutput ONLY the JSON scores.';
    return new Promise((resolve) => {
      execFile('grok', ['--model', 'grok-4.5', '-p', prompt],
        { timeout: 120000, encoding: 'utf8', env: process.env }, (e, stdout) => {
          resolve(e ? '' : stdout);
        });
    });
  }
  function parseJudgeOutput(text) {
    if (!text) return null;
    // Strip markdown code fences and reasoning text; find the JSON
    let t = text.replace(/```[a-z]*\n?/g, '').trim();
    // Try direct JSON parse first (fastest path)
    try { const j = JSON.parse(t); if (j.D !== undefined) return j; } catch {}
    // Regex fallback: find {..."D":number...}
    const m = t.match(/\{[^{}]*"D"\s*:\s*[\d.]+[^{}]*\}/);
    if (m) { try { return JSON.parse(m[0]); } catch {} }
    return null;
  }
  function collectMeta(dir, shotPath) {
    try {
      const artId = path.basename(dir);
      const cardsDir = path.join(process.cwd(), '.omx', 'atelier', 'scorecards');
      const cards = fs.readdirSync(cardsDir).filter(f => f.endsWith('.json')).sort().reverse();
      let myCard = null;
      for (const c of cards.slice(0, 50)) {
        try { const sc = JSON.parse(fs.readFileSync(path.join(cardsDir, c), 'utf8'));
          if (String(sc.artifact || '').includes(artId)) { myCard = sc; break; } } catch {}
      }
      const domain = (myCard?.domain || '').toLowerCase();
      const pngBytes = fs.readFileSync(shotPath);
      const smp = [];
      for (let bi = 100; bi < Math.min(pngBytes.length, 12000); bi += 97) smp.push(pngBytes[bi]);
      const mean = smp.reduce((a,b)=>a+b,0) / smp.length;
      const distinct = new Set(smp.slice(0, 200)).size;
      const parts = [`brightness=${mean.toFixed(0)}/255, color_diversity=${distinct}/200`];
      if (myCard) {
        if (myCard.temporal?.verdict) parts.push(`fps=${myCard.temporal.verdict.fps || '?'}, jank=${myCard.temporal.verdict.jankPercent || '?'}%`);
        if (myCard.domain) parts.push(`domain=${myCard.domain}`);
        if (myCard.ensemble) parts.push(`round1=D=${myCard.ensemble.D} A=${myCard.ensemble.A} R=${myCard.ensemble.R} N=${myCard.ensemble.N}`);
      }
      const dh = { p5:'2D canvas', three:'3D WebGL', glsl:'shaders', hydra:'video-synth', strudel:'live-coding music', tone:'Web Audio' };
      if (dh[domain]) parts.push(`typical=${dh[domain]}`);
      return { text: parts.join(', '), domain };
    } catch { return { text: 'none', domain: '' }; }
  }
  async function judgeArtifact(dir, domainHint) {
    const playable = path.join(dir, 'playable.html');
    const source = path.join(dir, 'source.txt');
    if (!fs.existsSync(playable)) return null;
    const shot = path.join('/tmp', `sj-${Date.now()}.png`);
    const { capturePlayableScreenshot } = await import('../dist/render/capturePlayableScreenshot.js');
    await capturePlayableScreenshot(playable, shot);
    const imgB64 = fs.readFileSync(shot).toString('base64');
    const code = fs.existsSync(source) ? fs.readFileSync(source, 'utf8') : '';
    const meta = collectMeta(dir, shot);
    const dom = String(domainHint || meta.domain || '').toLowerCase();
    console.log('[second-judge] judging ' + path.basename(dir).slice(0, 20) + '…');
    const [solR, glmR, grokR] = await Promise.allSettled([
      judgeWithSol(imgB64, code, meta.text, dom), judgeWithGlm(imgB64, code, meta.text, dom), judgeWithGrok(imgB64, code, meta.text, dom)
    ]);
    const results = {};
    for (const [name, r] of [['sol', solR], ['glm-5.3', glmR], ['grok', grokR]]) {
      const parsed = r.status === 'fulfilled' ? parseJudgeOutput(r.value) : null;
      results[name] = parsed || { error: r.status === 'rejected' ? String(r.reason).slice(0, 80) : 'parse-fail' };
    }
    try { fs.unlinkSync(shot); } catch (_) {}
    return results;
  }

  if (sub === 'sweep') {
    // Re-judge the most recent scored pieces (last 5 that haven't been round-2'd)
    const trendPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    if (!fs.existsSync(trendPath)) { console.error('no trend data'); process.exit(1); }
    const rows = fs.readFileSync(trendPath, 'utf8').trim().split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
    const already = new Set(fs.readdirSync(SJ_DIR).filter(f => f.endsWith('.json')).map(f => f.replace('.json', '')));
    // artifact_scored rows may record the playable FILE (.../playable.html) or the
    // artifact DIR — normalize to the dir before existence checks and id extraction.
    const artDirOf = (r) => {
      const a = String(r.artifact || '');
      return a.endsWith('.html') ? path.dirname(a) : a;
    };
    const toJudge = rows.filter(r => r.axes).slice(-10).filter(r => {
      const id = path.basename(artDirOf(r));
      return id && !already.has(id) && fs.existsSync(path.join(artDirOf(r), 'playable.html'));
    }).slice(0, 5);
    console.log(`[second-judge] sweep: ${toJudge.length} pieces to re-judge`);
    for (const r of toJudge) {
      const id = path.basename(artDirOf(r));
      try {
        const results = await judgeArtifact(artDirOf(r), r.domain);
        // Sol L3-16: seats that all errored are no verdict. Saving the error-only row made later sweeps skip the piece forever.
        if (results && !Object.values(results).some(v => v && !v.error)) {
          console.log(`[second-judge] ${id.slice(0, 16)}… NO VERDICT from any seat (${Object.entries(results).map(([k, v]) => k + ': ' + v.error).join('; ')}); not saved, will retry next sweep`);
          process.exitCode = 1;
        } else if (results) {
          const round1 = r.axes || '';
          const m = round1.match(/D=([\d.]+)\s+A=([\d.]+)\s+R=([\d.]+)\s+N=([\d.]+)/);
          const r1 = m ? { D: +m[1], A: +m[2], R: +m[3], N: +m[4] } : null;
          const out = { id, domain: r.domain, model: r.model, round1: r1, round1_axes: round1, round2: results,
            timestamp: new Date().toISOString() };
          fs.writeFileSync(path.join(SJ_DIR, id + '.json'), JSON.stringify(out, null, 1));
          console.log(`[second-judge] ${id.slice(0, 16)}… saved`);
        }
      } catch (e) { console.log(`[second-judge] ${id.slice(0, 16)}… failed: ${String(e).slice(0, 80)}`); }
    }
    console.log('[second-judge] sweep complete');
  } else if (sub === 'investigate') {
    // FAILURE INVESTIGATION: diagnose why generations failed
    const failsPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'failures.log');
    if (!fs.existsSync(failsPath)) { console.error('no failures.log'); process.exit(1); }
    const lines = fs.readFileSync(failsPath, 'utf8').trim().split('\n').filter(l => l.includes('Error:'));
    const recent = lines.slice(-5); // investigate last 5 failures
    console.log(`[investigate] ${recent.length} recent failures to diagnose`);
    const INVESTIGATE_PROMPT = 'You are a failure investigator for a generative-art system. Analyze this error and the code that produced it. Answer STRICT JSON: {"failure_class":"syntax|validation|render|audio|lease|provider|other","root_cause":"one sentence","preventable":true/false,"prevention":"specific deterministic fix if preventable, else empty","severity":"low|medium|high"}';
    for (const line of recent) {
      const errMatch = line.match(/Error: (.+)/);
      if (!errMatch) continue;
      const error = errMatch[1].slice(0, 300);
      console.log(`[investigate] diagnosing: ${error.slice(0, 60)}…`);
      try {
        const { execFile } = await import('node:child_process');
        const diag = await new Promise((resolve) => {
          execFile('grok', ['--model', 'grok-4.5', '-p', INVESTIGATE_PROMPT + '\n\nERROR:\n' + error],
            { timeout: 60000, encoding: 'utf8', env: process.env }, (e, stdout) => resolve(e ? '' : stdout));
        });
        const parsed = parseJudgeOutput(diag);
        if (parsed) {
          const entry = { error: error.slice(0, 200), diagnosis: parsed, timestamp: new Date().toISOString() };
          const invDir = path.join(SJ_DIR, 'investigations');
          fs.mkdirSync(invDir, { recursive: true });
          fs.writeFileSync(path.join(invDir, `inv-${Date.now()}.json`), JSON.stringify(entry, null, 1));
          console.log(`[investigate] ${parsed.failure_class}: ${parsed.root_cause?.slice(0, 60)} (preventable: ${parsed.preventable})`);
        }
      } catch (e) { console.log(`[investigate] failed: ${String(e).slice(0, 60)}`); }
    }
    console.log('[investigate] complete');
  } else if (sub && !sub.startsWith('-')) {
    // Single artifact
    const dir = path.resolve(sub);
    const results = await judgeArtifact(dir);
    if (results) {
      console.log(JSON.stringify(results, null, 1));
    } else { console.error('could not judge artifact'); process.exit(1); }
  } else {
    console.error('usage: sinter second-judge <dir> | sweep | investigate');
    process.exit(1);
  }
}
else if (cmd === 'third-judge') {
  // THIRD JUDGE TEAM (CEO order 2026-08-31): independent judges with
  // domain-customized criteria whose job is pushing each domain toward its
  // most amazing output. MECE vs R1 (gemini/minimax/glm vision) and R2
  // (Sol/kimi/grok): zero model overlap. This panel's sense is DOMAIN-EXPERT
  // CODE READING — no screenshot render (least compute), judges read source
  // + motion metrics + round-1 context against SINTER_DOMAIN_RUBRIC, and each
  // lane returns a "gap": the one system-level thing separating the piece
  // from a 9/10 in its domain (coaching signal for the lessons channel).
  // Lanes: command-code (CLI), agy (CLI — quota window may be closed; lane
  //        degrades gracefully). The two kilo lanes (deepseek-v4-flash,
  //        mimo-v2.5-pro) were REMOVED 2026-09-02: kilo balance went negative
  //        and every call 402s — dead lanes shipped error entries into the
  //        team map. CEO no-kilo-credit order; revisit at the Sep 15 review.
  // Usage: sinter third-judge <artifact-dir>
  //        sinter third-judge sweep [spread] [N]   (spread = one per domain, best first)
  const sub = cmdArgs[0];
  const TJ_DIR = path.join(process.cwd(), '.omx', 'atelier', 'third-judge');
  fs.mkdirSync(TJ_DIR, { recursive: true });
  // Loud skip log (honesty law): the panel is command-code + agy since the
  // kilo lanes died. One line per invocation, cannot be mistaken for a
  // 4-lane panel.
  console.log('[third-judge] kilo lanes (deepseek/mimo) SKIPPED — removed 2026-09-02 (kilo balance negative, every call 402s; CEO no-kilo-credit order, Sep 15 review). Panel: command-code + agy.');
  const spread = cmdArgs.includes('spread');
  const nArg = cmdArgs.slice(1).find(a => /^\d+$/.test(a));
  const COUNT = nArg ? Math.max(1, parseInt(nArg, 10)) : 5;

  async function judgeViaCli(bin, args, prompt) {
    const { execFile } = await import('node:child_process');
    return new Promise((resolve) => {
      execFile(bin, args.concat([prompt]), { timeout: 120000, encoding: 'utf8', env: process.env },
        (e, stdout, stderr) => resolve(e ? `__CLI_ERROR__: ${String(e.message || stderr || e).slice(0, 120)}` : stdout));
    });
  }
  function tjMeta(dir) {
    // Same metadata the second panel sees, minus the screenshot sample:
    // motion verdict + round-1 ensemble from the artifact's scorecard.
    try {
      const artId = path.basename(dir);
      const cardsDir = path.join(process.cwd(), '.omx', 'atelier', 'scorecards');
      const cards = fs.readdirSync(cardsDir).filter(f => f.endsWith('.json')).sort().reverse();
      let myCard = null;
      for (const c of cards.slice(0, 50)) {
        try { const sc = JSON.parse(fs.readFileSync(path.join(cardsDir, c), 'utf8'));
          if (String(sc.artifact || '').includes(artId)) { myCard = sc; break; } } catch {}
      }
      const parts = [];
      if (myCard?.temporal?.verdict) parts.push(`fps=${myCard.temporal.verdict.fps || '?'}, jank=${myCard.temporal.verdict.jankPercent || '?'}%`);
      if (myCard?.ensemble) parts.push(`round1=D=${myCard.ensemble.D} A=${myCard.ensemble.A} R=${myCard.ensemble.R} N=${myCard.ensemble.N}`);
      if (myCard?.domain) parts.push(`domain=${myCard.domain}`);
      return { text: parts.join(', ') || 'none', domain: (myCard?.domain || '').toLowerCase() };
    } catch { return { text: 'none', domain: '' }; }
  }
  async function tjJudge(dir, domainHint, domainsHint) {
    const source = path.join(dir, 'source.txt');
    const code = fs.existsSync(source) ? fs.readFileSync(source, 'utf8') : '';
    if (!code) return null;
    const meta = tjMeta(dir);
    const domain = String(domainHint || meta.domain || '').toLowerCase();
    // LAW 30 — composite domains are first-class: a layered piece carries
    // domains[] (lead first). Judge it against EVERY layer's rubric, not just
    // the primary — that's where the frontier accumulates.
    const domains = Array.isArray(domainsHint) ? domainsHint.map(d => String(d).toLowerCase()) : [];
    const rubricFor = (d) => SINTER_DOMAIN_RUBRIC[d] ? ' DOMAIN CRITERIA — weight these: ' + SINTER_DOMAIN_RUBRIC[d] : '';
    const rubricText = domains.length
      ? ' DOMAIN CRITERIA (layered piece — weight each layer): ' + domains.map(d => SINTER_DOMAIN_RUBRIC[d]).filter(Boolean).join(' || ')
      : rubricFor(domain);
    const prompt = 'You are a domain-expert judge of generative art. You read SOURCE CODE plus MOTION/VISUAL METADATA (no screenshot). Score D craft, A artistic, R reliability, N novelty. Each 1-10, be strict.' + rubricText + ' Also answer "gap": the ONE system-level thing that most separates this piece from a 9/10 in THIS domain — a coaching insight about the approach, not an edit request. Output ONLY JSON: {"D":n,"A":n,"R":n,"N":n,"gap":"..."}';
    console.log('[third-judge] judging ' + path.basename(dir).slice(0, 20) + ' domain=' + (domains.length ? domains.join('+') : (domain || '?')));
    const fullPrompt = prompt + '\n\nSOURCE CODE:\n```\n' + code.slice(0, 10000) + '\n```\n\nVISUAL + MOTION DATA: ' + meta.text + '\n\nOutput ONLY the JSON.';
    // 2026-09-02: kilo lanes (deepseek/deepseek-v4-flash, xiaomi/mimo-v2.5-pro)
    // removed from this allSettled — negative balance, all calls 402s. CEO
    // no-kilo-credit order; revisit at the Sep 15 review before re-adding.
    const [ccR, agyR] = await Promise.allSettled([
      judgeViaCli('command-code', ['-p'], fullPrompt),
      judgeViaCli('agy', ['-p'], fullPrompt),
    ]);
    const results = {};
    for (const [name, r] of [['command_code', ccR], ['agy', agyR]]) {
      const raw = r.status === 'fulfilled' ? String(r.value || '') : '';
      const cliErr = raw.startsWith('__CLI_ERROR__') ? raw.slice('__CLI_ERROR__:'.length) : null;
      const parsed = !cliErr && raw ? parseJudgeJsonLoose(raw) : null;
      results[name] = parsed || { error: cliErr || (r.status === 'rejected' ? String(r.reason).slice(0, 80) : 'parse-fail') };
    }
    return { team: results, domain, ...(domains.length ? { domains } : {}) };
  }
  function tjConsensus(team) {
    const axes = { D: [], A: [], R: [], N: [] };
    for (const v of Object.values(team)) {
      if (v && typeof v.D === 'number') { axes.D.push(v.D); axes.A.push(v.A); axes.R.push(v.R); axes.N.push(v.N); }
    }
    const out = {};
    for (const k of Object.keys(axes)) if (axes[k].length) out[k] = +(axes[k].reduce((a,b)=>a+b,0) / axes[k].length).toFixed(2);
    return Object.keys(out).length ? out : null;
  }

  if (sub === 'sweep') {
    const trendPath = path.join(process.cwd(), '.omx', 'atelier', 'lessons', 'trend.jsonl');
    if (!fs.existsSync(trendPath)) { console.error('no trend data'); process.exit(1); }
    const rows = fs.readFileSync(trendPath, 'utf8').trim().split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
    const already = new Set(fs.readdirSync(TJ_DIR).filter(f => f.endsWith('.json')).map(f => f.replace('.json', '')));
    const artDirOf = (r) => {
      const a = String(r.artifact || '');
      return a.endsWith('.html') ? path.dirname(a) : a;
    };
    const scored = rows.filter(r => r.axes).filter(r => {
      const id = path.basename(artDirOf(r));
      return id && fs.existsSync(path.join(artDirOf(r), 'source.txt'));
    });
    let toJudge;
    if (spread) {
      // One piece per domain, highest round-1 mean first: judge each domain's
      // current best — where "push toward amazing" matters most. The best is
      // chosen from ALL scored rows (rare domains' only pieces can be far back
      // in history), and already-judged bests are skipped at EXECUTION time —
      // filtering them during selection would silently demote each domain to
      // its best REMAINING piece on every re-run.
      const byDomain = {};
      for (const r of scored) {
        const m = String(r.axes).match(/D=([\d.]+)\s+A=([\d.]+)\s+R=([\d.]+)\s+N=([\d.]+)/);
        if (!m) continue;
        const mean = (+m[1] + +m[2] + +m[3] + +m[4]) / 4;
        const d = r.domain || 'unlabeled';
        if (!byDomain[d] || mean > byDomain[d].mean) byDomain[d] = { r, mean };
      }
      toJudge = Object.values(byDomain).sort((a,b) => b.mean - a.mean)
        .map(x => x.r).filter(r => !already.has(path.basename(artDirOf(r)))).slice(0, COUNT);
    } else {
      toJudge = scored.filter(r => !already.has(path.basename(artDirOf(r)))).slice(-COUNT);
    }
    console.log(`[third-judge] sweep: ${toJudge.length} pieces${spread ? ' (spread: one per domain)' : ''}`);
    for (const r of toJudge) {
      const id = path.basename(artDirOf(r));
      try {
        const out = await tjJudge(artDirOf(r), r.domain, r.domains);
        if (out && !Object.values(out.team).some(v => v && !v.error)) {
          console.log(`[third-judge] ${id.slice(0, 16)}… NO VERDICT from any seat (${Object.entries(out.team).map(([k, v]) => k + ': ' + v.error).join('; ')}); not saved, will retry next sweep`);
          process.exitCode = 1;
        } else if (out) {
          const m = String(r.axes).match(/D=([\d.]+)\s+A=([\d.]+)\s+R=([\d.]+)\s+N=([\d.]+)/);
          const rec = { id, domain: out.domain || r.domain, round1: m ? { D: +m[1], A: +m[2], R: +m[3], N: +m[4] } : null,
            round1_axes: r.axes, team: out.team, consensus: tjConsensus(out.team),
            gaps: Object.values(out.team).filter(v => v && typeof v.gap === 'string' && v.gap).map(v => v.gap).slice(0, 4),
            timestamp: new Date().toISOString() };
          fs.writeFileSync(path.join(TJ_DIR, id + '.json'), JSON.stringify(rec, null, 1));
          console.log(`[third-judge] ${id.slice(0, 16)}… saved consensus=` + JSON.stringify(rec.consensus));
        }
      } catch (e) { console.log(`[third-judge] ${id.slice(0, 16)}… failed: ${String(e).slice(0, 80)}`); }
    }
    console.log('[third-judge] sweep complete');
  } else if (sub && !sub.startsWith('-')) {
    const dir = path.resolve(sub);
    const out = await tjJudge(dir);
    if (out) { console.log(JSON.stringify(out, null, 1)); }
    else { console.error('could not judge artifact (no source.txt)'); process.exit(1); }
  } else {
    console.error('usage: sinter third-judge <dir> | sweep [spread] [N]');
    process.exit(1);
  }
}
else if (cmd === 'rescue') {
  // Rescue organ: see src/cli/RescueCli.ts (capability lives in src; bin stays thin).
  const { runRescueCommand } = await import('../dist/cli/RescueCli.js');
  await runRescueCommand(cmdArgs, { sweep: flags.sweep, noLlm: flags.noLlm });
}
