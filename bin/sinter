const args = process.argv.slice(2);
if (process.env.SINTER_PROOF_ISOLATION === '1') {
  const { assertProofCannotTouchRealState } = await import('../dist/config/ProofIsolationGuard.js');
  try {
    assertProofCannotTouchRealState(process.env.HOME || process.env.USERPROFILE || os.homedir());
    assertProofCannotTouchRealState(sinterConfigPath());
    const state = process.env.SINTER_LIMINAL_RUNTIME_ROOT;
    if (state) assertProofCannotTouchRealState(state);
  } catch (error) {
    console.error(error.message);
    process.exit(2);
  }
}
// Historical inventory has a read-only path and needs no CLI provider bootstrap.
if (args[0] === 'learn-from-existing-art') {
  const { runLearnFromExistingArt } = await import('../dist/cli/ExistingArtDigestCli.js');
  process.exit(await runLearnFromExistingArt(args.slice(1)));
}


// One-time config-home migration (~/.liminal or ~/.atelier to ~/.sinter).
// Runs before any config read; --help and --version leave files alone.
{
  // An unbuilt checkout has no dist yet; --help still works there, so skip the move.
  const { migrateConfigHome } = await import('../dist/config/migrateConfigHome.js')
    .catch((error) => (error?.code === 'ERR_MODULE_NOT_FOUND' ? { migrateConfigHome: () => 'none' } : Promise.reject(error)));
  const migration = migrateConfigHome(process.env.HOME || process.env.USERPROFILE, args);
  if (migration === 'copied') {
    console.error('Copied your Sinter settings to ~/.sinter. The old folder was kept.');
  } else if (migration === 'failed') {
    console.error('Could not move your old Sinter settings to ~/.sinter. Sinter will try again next time.');
  }
}

