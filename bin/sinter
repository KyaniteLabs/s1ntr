    const result = await liminalRuntime.dream.run(command);
    console.log('');
    console.log('=== Governed Dream Research Completed ===');
    console.log(`  Plan: ${result.researchPlan.planDigest}`);
    console.log(`  Outcome: ${result.outcome}`);
    console.log(`  State: ${result.state}`);
    console.log('');
  } catch (error) {
    console.error(`Dream research failed: ${error?.message || String(error)}`);
    process.exitCode = 1;
