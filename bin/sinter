  const { rerenderReevaluateProductRunCli } = await import('../dist/cli/LiminalRerenderReevaluate.js');
  try {
    const outcome = await rerenderReevaluateProductRunCli(path.resolve(flags.runRoot), path.resolve(flags.grant), {
      promptFile: flags.promptFile ? path.resolve(flags.promptFile) : undefined,
      repoRoot: flags.repoRoot ? path.resolve(flags.repoRoot) : undefined,
    });
    console.log(JSON.stringify({ grantDigest: outcome.grantDigest, parentKey: outcome.parentKey,
      score: outcome.result.evaluation.score, admissionEligible: outcome.result.evaluation.admissionEligible,
      operationId: outcome.result.operationId }, null, 2));
    process.exit(outcome.result.evaluation.admissionEligible ? 0 : 2);
