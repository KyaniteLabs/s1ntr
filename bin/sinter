else if (cmd === 'persona') {
  // Persona Fleet organ: cognitive-style personas per machine.
  const { runPersonaCommand } = await import('../dist/cli/PersonaCli.js');
  await runPersonaCommand(cmdArgs);
}
else if (cmd === 'prompt-next') {
  // Prompt Organ: generative prompt engine — infinite frontier-directed prompts.
  const { runPromptNextCommand } = await import('../dist/cli/PromptOrganCli.js');
  await runPromptNextCommand(cmdArgs);
