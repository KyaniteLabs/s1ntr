function printFixUsage() {
  console.error('Usage: sinter fix <file|description> [--error <text>] [--dry-run] [--confirm auto|ask|never]');
  console.error('       sinter fix --test-failures [--test-file <path>] [--dry-run] [--confirm auto|ask|never]');
}

// Handle --help flag (global) and the bare `help` word (previously fell
// through to the generate path as a prompt and died on key preflight).
if (flags.help || cmd === 'help') {
  if (flags.help && cmd && cmd !== 'help') {
    const { printCommandHelp } = await import('../dist/cli/CommandHelp.js');
    if (printCommandHelp(cmd)) process.exit(0);
  }
  printHelp();
  process.exit(0);
}

if (cmd === 'judge') {
  console.error('Usage: sinter judge compare or sinter judge --round <2|3> <artifact>');
  process.exit(1);
}

if (cmd === 'taste' && ['train', 'eval'].includes(cmdArgs[0]) && cmdArgs.length > 1) {
  console.error('Taste train and eval use project data. For a wall-vote report, run scripts/learning/beauty.py report.');
  process.exit(2);
}

// Handle --version flag
if (flags.version) {
  console.log(`Sinter v${packageJson.version}`);
  process.exit(0);
}

// `seed save|list|show`: the gallery archive of named seeds (prompt, domain, note) under ~/.sinter/seeds.
// `generate --seed <name>` builds on a saved seed: its prompt and note go into the brief.
if (cmd === 'seed') {
  const { SeedArchive } = await import('../dist/gallery/SeedArchive.js');
  const archive = new SeedArchive(path.join(os.homedir(), '.sinter', 'seeds'));
  const [verb, name] = cmdArgs;
  try {
    if (verb === 'save') {
      if (!name) throw new Error('usage: sinter seed save <name> --prompt "..." [--domain d] [--title note]');
      await archive.saveSeed(name, { prompt: flags.prompt || '', domain: flags.domain || null, note: flags.title || '', savedAt: new Date().toISOString() });
      console.log('Seed saved: ' + name);
    } else if (verb === 'show') {
      const data = name ? await archive.loadSeed(name) : null;
      if (!data) throw new Error('no such seed: ' + name);
      console.log(JSON.stringify(data, null, 2));
    } else if (verb === 'list') {
      const dir = path.join(os.homedir(), '.sinter', 'seeds');
      const names = fs.existsSync(dir) ? fs.readdirSync(dir).filter(f => f.endsWith('.json')).map(f => f.slice(0, -5)).sort() : [];
      console.log(names.length ? names.join('\n') : '(no saved seeds)');
    } else {
      throw new Error('usage: sinter seed <save|show|list> [name]');
    }
    process.exit(0);
  } catch (error) {
    console.error('Error: ' + error.message);
    process.exit(1);
  }
}

// `export <html|js|zip> <code-file> -o <out>`: package a piece's code for sharing (validated before it is wrapped).
if (cmd === 'export') {
  const [kind, codeFile] = cmdArgs;
  try {
    if (!['html', 'js', 'zip'].includes(kind) || !codeFile || !flags.output) throw new Error('usage: sinter export <html|js|zip> <code-file> -o <out-path>');
    const { Exporter } = await import('../dist/export/Exporter.js');
    const code = fs.readFileSync(path.resolve(codeFile), 'utf8');
    const out = path.resolve(flags.output);
    const exporter = new Exporter();
    if (kind === 'html') await exporter.exportHTML(code, out);
    else if (kind === 'js') await exporter.exportJS(code, out);
    else await exporter.exportZIP({ name: path.basename(codeFile).replace(/\.[^.]+$/, '') || 'piece', iterations: [{ version: 1, code, timestamp: new Date().toISOString() }] }, out);
    console.log('Exported ' + kind + ': ' + out);
    process.exit(0);
  } catch (error) {
    console.error('Error: export failed: ' + error.message);
    process.exit(1);
  }
}

// `memo`: write a reviewer's critique as an EvaluationMemo file that `generate --memo` feeds into the next brief.
// sinter memo -o memo.json --by <reviewer> --verdict approve|revise|reject --score 0..1 --title T "brief" --section "Title|text|high"
if (cmd === 'memo') {
  const { EvaluationMemoBuilder } = await import('../dist/collab/EvaluationMemo.js');
  try {
    const builder = new EvaluationMemoBuilder()
      .setTitle(flags.title || 'Critique').setBrief(flags.prompt || cmdArgs.join(' '))
      .setVerdict(flags.verdict, flags.score).setGeneratedBy(flags.by || '');
    for (const sec of flags.sections || []) {
      const [t, c, pr] = sec.split('|');
      builder.addSection(t, c ?? '', pr || 'medium');
    }
    const memo = builder.build();
    const out = path.resolve(flags.output || 'memo.json');
    fs.mkdirSync(path.dirname(out), { recursive: true });
    fs.writeFileSync(out, JSON.stringify(memo, null, 2) + '\n', 'utf8');
    console.log('Memo written: ' + out + ' (' + memo.finalVerdict + ', ' + memo.score.toFixed(2) + ', by ' + memo.generatedBy + ')');
    process.exit(0);
  } catch (error) {
    console.error('Error: ' + error.message);
    process.exit(1);
  }
}

// Operator swarm surface: run a swarm, list sessions, or record a human gold
// label. Dispatched from dist so the command group stays a thin entrypoint.
if (cmd === 'gallery') {
  const { Gallery } = await import('../dist/gallery/Gallery.js');
  const sub = cmdArgs[0] ?? 'list';
  if (sub !== 'list') {
    console.error(`Unknown gallery command "${sub}". Usage: sinter gallery list [--gallery <dir>]`);
    process.exit(1);
  }
  const { resolveSinterProjectRoot } = await import('../dist/fs/projectRoot.js');
  const galleryDir = flags.gallery ? path.resolve(flags.gallery) : path.join(resolveSinterProjectRoot(), 'gallery');
  if (flags.gallery && !fs.existsSync(galleryDir)) {
    console.error(`No gallery at ${galleryDir} (the --gallery directory does not exist).`);
    process.exit(1);
  }
  const gallery = new Gallery(galleryDir);
  const dirs = await gallery.listProjectDirs();
  if (dirs.length === 0) {
    console.log(`Gallery ${galleryDir} is empty. Accepted \`sinter generate\` runs and loop iterations save here.`);
    process.exit(0);
  }
  console.log(`Gallery ${galleryDir}: ${dirs.length} project${dirs.length === 1 ? '' : 's'}`);
  for (const dir of dirs) {
    const history = await gallery.loadHistoryFromDir(dir);
    const latest = history.length ? Math.max(...history.map(h => h.version)) : 0;
    console.log(`  ${dir}  ${history.length} version${history.length === 1 ? '' : 's'}  latest v${latest}`);
  }
  process.exit(0);
}

if (cmd === 'swarm') {
  const { runSwarmCli } = await import('../dist/cli/SwarmCli.js');
  process.exit(await runSwarmCli(cmdArgs, flags));
}

// DOMAIN-CUSTOMIZED JUDGE CRITERIA (CEO order 2026-08-31): judges must score
// against what makes EACH domain amazing, not a generic visual rubric. Shared
// by every judging panel (second-judge, third-judge) — one source of truth.
const SINTER_DOMAIN_RUBRIC = {
  strudel: 'STRUDEL/audio: judge rhythm sophistication, harmonic movement, timbral layering, strategic silence, groove; code = pattern craft (mininotation elegance).',
  tone: 'TONE/audio: judge sound design depth, effect-chain creativity, temporal evolution, spectral interest.',
  glsl: 'GLSL/shader: judge light quality, motion fluidity, mathematical elegance of the field, color grading; code = GLSL craft.',
  three: 'THREE.JS: judge spatial composition, camera work, material/light interplay, geometry sophistication.',
  hydra: 'HYDRA: judge feedback/texture richness, source transformation inventiveness, signal-chain creativity.',
  p5: 'P5: judge compositional clarity, motion choreography, particle/system sophistication.',
  kinetic: 'KINETIC TYPE: judge typographic drama, timing/rhythm of reveal, readability vs expression.',
  ascii: 'ASCII: judge character-density craft, tonal range from character choice, motion within constraint.',
  svg: 'SVG: judge geometric precision, negative space, path elegance.',
  hyperframes: 'HYPERFRAMES: judge layered parallax depth, frame narrative.',
  dataviz: 'DATAVIZ: judge whether hidden structure becomes FELT (synesthetic clarity), not chart legibility.',
  textgen: 'TEXTGEN: judge language craft — imagery, rhythm, surprise — AND its typographic rendering.',
  custom: 'CUSTOM: judge self-reference that earns its keep — the piece\'s visibility into its own process must create real composition, not a debug overlay wearing art clothes.',
  html: 'HTML: judge the living page — typography/layout/state mutating as ONE organism, CSS as medium, DOM choreography; not a static page screenshot.',
};
SINTER_DOMAIN_RUBRIC.meta = SINTER_DOMAIN_RUBRIC.custom; // deprecated alias: provenance written before the meta -> custom rename
// Robust judge-output parser: strips fences, tries whole-body JSON, then
// brace-balanced scan (tolerates prose around the JSON and strings containing braces).
function parseJudgeJsonLoose(text) {
  if (!text) return null;
  let t = String(text).replace(/```[a-z]*\n?/g, '').trim();
  try { const j = JSON.parse(t); if (j.D !== undefined) return j; } catch {}
  const m = t.match(/\{[^{}]*"D"\s*:\s*[\d.]+[^{}]*\}/);
  if (m) { try { return JSON.parse(m[0]); } catch {} }
  return null;
}

if (cmd === 'authoritative-create') {
  if (!flags.authority) {
    console.error('Usage: sinter authoritative-create --authority <absolute-authority.json>');
    process.exit(1);
