const CLI_PROVIDER_NAMES = Object.keys(CLI_PROVIDER_DEFAULTS);

function resolveCliProvider(value) {
  if (!value) return undefined;
  const normalized = value.toLowerCase();
  return CLI_PROVIDER_DEFAULTS[normalized] ? normalized : undefined;
}

function sinterHomeDir() {
  return path.join(process.env.HOME || process.env.USERPROFILE || '.', '.sinter');
}

// Same override the core honors (RoleConfig.resolveUserConfigPath), so every
// command reads and writes the config the generation path actually uses.
function sinterConfigPath() {
  const override = (process.env.SINTER_CONFIG_PATH ?? process.env.LIMINAL_CONFIG_PATH)?.trim();
  return override || path.join(sinterHomeDir(), 'config.json');
}

function organismStatePath() {
  return process.env.SINTER_ORGANISM_STATE_PATH
    || path.join(sinterHomeDir(), 'organism', 'owner-reactions.json');
}

// Route provider updates through ConfigLoader's single deep-merging atomic
// writer. With `activate`, update only the generator role; evaluator, harness,
// studio, fallbacks, capabilities, and forward-compatible keys survive.
async function setProviderKey(providerKey, apiKey, { model, baseUrl, activate } = {}) {
  const defaults = CLI_PROVIDER_DEFAULTS[providerKey];
  if (!defaults) throw new Error(`Unknown provider: ${providerKey} (one of: ${CLI_PROVIDER_NAMES.join(', ')})`);
  const cfgPath = sinterConfigPath();
  // baseUrl override lets a provider point at a self-hosted endpoint (e.g. a
  // remote Ollama/vLLM/LM Studio on a home server) instead of its default URL.
  const block = {
    baseUrl: baseUrl || defaults.baseUrl,
    model: model || defaults.model,
  };
  if (apiKey) block.apiKey = apiKey; // keyless local servers (ollama/lmstudio) need none
  const update = { providers: { [providerKey]: block } };
  if (activate) {
    update.defaultProvider = providerKey;
    const roleBlock = { provider: providerKey, ...block };
    update.roles = { generator: roleBlock };
  }
  const { updateConfig } = await import('../dist/config/ConfigLoader.js');
  const result = await updateConfig(update, cfgPath);
  if (result.isErr()) throw result.error;
  return { cfgPath, model: block.model, baseUrl: block.baseUrl, activated: !!activate };
}

function printProviderHelp() {
  console.log('');
  console.log('🔌 Sinter Provider Setup');
  console.log('');
  console.log('USAGE:');
  console.log('  sinter provider help');
  console.log('  sinter provider list');
  console.log('  sinter provider status');
  console.log('  sinter provider set-key <name> [<API_KEY>] [--base-url <url>] [--model <id>] [--use]');
  console.log('  sinter provider provision-glm-coding-plan --seat-id <id> --expires-at <iso> --owner-private-key <path> --owner-public-key <path> --confirm-owner-authorized-subscription');
  console.log('  sinter --configure --provider <name>');
  console.log('');
  console.log('PROVIDERS:');
  for (const [name, provider] of Object.entries(CLI_PROVIDER_DEFAULTS)) {
    const keyHint = provider.requiresKey && provider.apiKeyEnv
      ? `requires ${provider.apiKeyEnv}`
      : 'no API key required';
    console.log(`  ${name.padEnd(10)} ${provider.label.padEnd(13)} model=${provider.model} (${keyHint})`);
  }
  console.log('');
  console.log('EXAMPLES:');
  console.log('  sinter --configure --provider lmstudio');
  console.log('  sinter provider set-key minimax sk-... --use   # MiniMax-M3, international endpoint, made active');
  console.log('  GLM_API_KEY=... sinter --provider glm "make a p5 sketch"');
  console.log('  sinter provider status');
  console.log('');
}

function printProviderList() {
  console.log('');
  console.log('Available Sinter providers:');
  for (const name of CLI_PROVIDER_NAMES) {
    const provider = CLI_PROVIDER_DEFAULTS[name];
    console.log(`  ${name.padEnd(10)} ${provider.label} (${provider.baseUrl})`);
  }
  console.log('');
}

function readSinterConfig() {
  const p = sinterConfigPath();
  if (!fs.existsSync(p)) return {};
  try {
    return JSON.parse(fs.readFileSync(p, 'utf-8'));
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    // Fail closed: continuing with defaults silently switches provider, model,
    // and billing. The operator must fix or rebuild the config.
    throw new Error(`${p} is not valid JSON (${message}). Refusing to run with defaults; move it aside (mv \"${p}\" \"${p}.bak\") or fix the JSON, then re-run.`);
  }
}

function savedKeyFor(name, config) {
  const fromProvider = config.providers?.[name]?.apiKey;
  const fromRole = ['generator', 'evaluator', 'harness']
    .map((r) => config.roles?.[r])
    .find((role) => role?.provider === name && role?.apiKey)?.apiKey;
  return Boolean(fromProvider || fromRole);
}

// Keyless providers are only "ready" if a listener actually answers; the
// status used to claim ready for LM Studio / Ollama with nothing running.
function probeLocalEndpoint(baseUrl, timeoutMs = 300) {
  return new Promise((resolve) => {
    let url;
    try { url = new URL(baseUrl); } catch { resolve(false); return; }
    const port = Number(url.port) || (url.protocol === 'https:' ? 443 : 80);
    const socket = net.connect({ host: url.hostname, port });
    let settled = false;
    const done = (ok) => {
      if (settled) return;
      settled = true;
      socket.destroy();
      resolve(ok);
    };
    socket.setTimeout(timeoutMs, () => done(false));
    socket.once('connect', () => done(true));
    socket.once('error', () => done(false));
  });
}

async function printProviderStatus() {
  const config = readSinterConfig();
  const active = config.defaultProvider;
  const names = Object.keys(CLI_PROVIDER_DEFAULTS);
  const reachable = new Map(await Promise.all(names.map(async (name) => {
    const provider = CLI_PROVIDER_DEFAULTS[name];
    if (provider.requiresKey) return [name, true];
    return [name, await probeLocalEndpoint(provider.baseUrl)];
  })));
  console.log('');
  console.log('Sinter provider readiness:');
  for (const [name, provider] of Object.entries(CLI_PROVIDER_DEFAULTS)) {
    // Ready if a required key is present, and a keyless endpoint answers.
    const hasKey = Boolean(process.env[provider.apiKeyEnv]) || savedKeyFor(name, config);
    const configured = !provider.requiresKey || hasKey;
    const status = !configured
      ? `missing key (set with: sinter provider set-key ${name} <KEY>)`
      : reachable.get(name) === false
        ? `not reachable at ${provider.baseUrl}`
        : 'ready';
    const activeMark = name === active ? ' (active)' : '';
    console.log(`  ${name.padEnd(10)} ${status}${activeMark}`);
  }
  console.log('');
  console.log('Set a key with `sinter provider set-key <name> <KEY> --use`.');
  console.log('');
}

function hasConfiguredProviderKey(name) {
  const provider = CLI_PROVIDER_DEFAULTS[name];
  if (!provider?.requiresKey) return true;
  if (flags.apiKey || process.env.LLM_API_KEY || process.env.LIMINAL_LLM_API_KEY || process.env.SINTER_LLM_API_KEY) return true;
  if (provider.apiKeyEnv && process.env[provider.apiKeyEnv]) return true;
  return savedKeyFor(name, readSinterConfig());
}

function providerNameFromBaseUrl(baseUrl) {
  if (!baseUrl) return undefined;
  const normalized = String(baseUrl).toLowerCase();
  return CLI_PROVIDER_NAMES.find((name) => {
    const defaults = CLI_PROVIDER_DEFAULTS[name];
    return defaults.baseUrl && normalized.startsWith(defaults.baseUrl.toLowerCase());
  });
}

function providerForGenerationPreflight() {
  if (flags.provider) return resolveCliProvider(flags.provider);
  const config = readSinterConfig();
  if (config.defaultProvider && CLI_PROVIDER_DEFAULTS[config.defaultProvider]) return config.defaultProvider;
  const configuredBaseUrl = process.env.LIMINAL_LLM_BASE_URL || process.env.SINTER_LLM_BASE_URL;
  const providerFromEndpoint = providerNameFromBaseUrl(configuredBaseUrl);
  if (providerFromEndpoint) return providerFromEndpoint;
  const keyedProvider = CLI_PROVIDER_NAMES.find((name) => {
    const provider = CLI_PROVIDER_DEFAULTS[name];
    return provider.requiresKey && provider.apiKeyEnv && process.env[provider.apiKeyEnv];
  });
  return keyedProvider || 'anthropic';
}

function missingProviderKeyMessageForGeneration() {
  // File-pinned seats (e.g. roles.generator with its own apiKey/baseUrl)
  // satisfy the preflight: the sniff below only sees env keys and would
  // otherwise demand an unrelated default-provider key.
  try {
    const resolvedRole = LLMClient.getResolvedRoleConfig('generator');
    if (resolvedRole?.apiKey) return null;
    // CLI-lane rotation seats (cli://command) carry their own auth via the
    // subscription CLI — demanding an API key here killed every cli:// turn.
    if (resolvedRole?.baseUrl && resolvedRole.baseUrl.startsWith('cli://')) return null;
  } catch { /* fall through to the sniff */ }
  const providerName = providerForGenerationPreflight();
  const provider = providerName ? CLI_PROVIDER_DEFAULTS[providerName] : undefined;
  if (!providerName || !provider?.requiresKey || hasConfiguredProviderKey(providerName)) return null;
  const keyHint = provider.apiKeyEnv || 'the provider API key env var';
  return [
    `Missing API key for ${providerName}.`,
    `Set ${keyHint} or run: sinter provider set-key ${providerName} <KEY> --use`,
  ].join(' ');
}

function parsePortArg(rawPort) {
  if (rawPort === undefined) return 3456;
  if (!/^\d+$/.test(String(rawPort))) return null;
  const port = Number(rawPort);
  if (!Number.isInteger(port) || port < 0 || port > 65535) return null;
  return port;
}

function parseNumericFlag(flag, rawValue, { integer = false, min, max, expected }) {
  const value = rawValue === undefined || String(rawValue).trim() === ''
    ? NaN
    : Number(rawValue);
  if (
    !Number.isFinite(value)
    || (integer && !Number.isInteger(value))
    || value < min
    || value > max
  ) {
    console.error(`Invalid value for ${flag}: expected ${expected}.`);
    process.exit(1);
  }
  return value;
}

