  process.on('exit', () => {
    console.error(`SINTER_TRACE_MODULE_LOADS=${JSON.stringify(Object.keys(require.cache))}`);
  });
}

const binDir = path.dirname(fileURLToPath(import.meta.url));
const repoRoot = path.join(binDir, '..');
const packageJson = JSON.parse(fs.readFileSync(path.join(repoRoot, 'package.json'), 'utf-8'));
const args = process.argv.slice(2);

// One-time config-home migration (~/.liminal or ~/.atelier to ~/.sinter).
// Runs before any config read; --help and --version leave files alone.
{
  // An unbuilt checkout has no dist yet; --help still works there, so skip the move.
  const { migrateConfigHome } = await import('../dist/config/migrateConfigHome.js')
    .catch((error) => (error?.code === 'ERR_MODULE_NOT_FOUND' ? { migrateConfigHome: () => 'none' } : Promise.reject(error)));
  const migration = migrateConfigHome(process.env.HOME || process.env.USERPROFILE, args);
  if (migration === 'copied') {
    console.error('Copied your Sinter settings to ~/.sinter. The old folder was kept.');
  } else if (migration === 'failed') {
    console.error('Could not move your old Sinter settings to ~/.sinter. Sinter will try again next time.');
  }
}

