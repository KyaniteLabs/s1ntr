    flags.once = true;
  } else if (arg === '--slots') {
    flags.slots = parseNumericFlag('--slots', args[++i], {
      integer: true,
      min: 1,
      max: Infinity,
      expected: 'a positive integer',
    });
  } else if (arg === '--slot') {
    flags.slot = args[++i];
  } else if (arg === '--interval') {
    flags.interval = parseNumericFlag('--interval', args[++i], {
      integer: true,
      min: 1,
      max: Infinity,
      expected: 'a positive integer',
    });
  } else if (arg === '--magnitude') {
    flags.magnitude = parseNumericFlag('--magnitude', args[++i], {
      min: 0,
      max: 1,
      expected: 'a number from 0 to 1',
    });
  } else if (arg === '--allow-fallback') {
    flags.allowFallback = true;
  } else if (arg === '--no-llm') {
    flags.noLlm = true;
  } else if (arg === '--sweep') {
    flags.sweep = true;
  } else if (arg === '--state') {
    flags.state = args[++i];
  } else if (arg === '--questions') {
    flags.questions = args[++i];
  } else if (arg === '--image') {
    (flags.images ??= []).push(args[++i]);
  } else if (arg.startsWith('-') && cmd !== null && LEAF_OWNED_ARGV.has(cmd)) {
    // leaf-owned flag: validated by the leaf from leafArgv(); its value (if any) falls through as a positional here
  } else if (arg.startsWith('-')) {
    console.error(`Unknown option: ${arg}`);
    console.error('Run "sinter --help" for usage, or: sinter "your idea"');
    process.exit(1);
  } else if (!arg.startsWith('-')) {
    if (cmd === null) {
      const normalized = normalizeCliCommand(arg, []);
      cmd = normalized.cmd;
      cmdIndex = i;
      args.splice(i, 1, cmd, ...normalized.cmdArgs);
    } else {
      cmdArgs.push(arg);
    }
  }
}

/** Raw tokens the leaf command parses for itself: everything after the command, plus safety booleans given before it. */
function leafArgv() {
  const raw = cmdIndex >= 0 ? args.slice(cmdIndex + 1) : [];
  const before = cmdIndex >= 0 ? args.slice(0, cmdIndex) : [];
  for (const f of LEAF_FORWARDED_BOOLEANS) if (before.includes(f) && !raw.includes(f)) raw.push(f);
  return raw;
}

// One boundary for deprecated domain ids: `--domain meta` is now `--domain custom`.
if (flags.domain) {
  try {
    const { canonicalDomainId } = await import('../dist/types/domains.js');
    flags.domain = canonicalDomainId(flags.domain, (from, to) =>
      console.error(`note: --domain ${from} is deprecated; it now means --domain ${to}.`));
  } catch { /* dist not built yet: keep the raw value */ }
}


function isIsolatedWorktree(cwd = process.cwd()) {
  return cwd.includes(`${path.sep}.worktrees${path.sep}`)
    || cwd.includes(`${path.sep}.claude${path.sep}worktrees${path.sep}`);
}

// Run ONE real bounded self-improvement pass through the live runtime inside a
// throwaway git worktree sandbox, verify a real edit landed, then remove the
// sandbox. The launch worktree is never mutated: all edits happen in the
// sandbox (the agent's edit tools resolve against process.cwd()), and we chdir
// back + git-worktree-remove afterwards. Returns the process exit code.
async function runLiveSelfImproveGauntlet() {
  const { execFileSync } = await import('child_process');
  const git = (args, opts = {}) =>
    execFileSync('git', args, { cwd: repoRoot, encoding: 'utf-8', ...opts }).trim();

  // Resolve a live provider/client the same way `improve run` does: a harness
  // role client picks up whatever provider env keys (GLM/MiniMax/...) are set.
  // --provider narrows to one explicit provider when supplied.
  const { LLMClient } = await import('../dist/llm/LLMClient.js');
  const providerKey = resolveCliProvider(flags.provider);
  if (flags.provider && !providerKey) {
    console.error(`Unknown --provider (one of: ${CLI_PROVIDER_NAMES.join(', ')}).`);
    return 1;
  }
  let llm;
  if (providerKey) {
    const defaults = CLI_PROVIDER_DEFAULTS[providerKey];
    const baseUrl = flags.baseUrl || defaults.baseUrl;
    const apiKey = (defaults.apiKeyEnv && process.env[defaults.apiKeyEnv]) || flags.apiKey || undefined;
    if (defaults.requiresKey && !apiKey) {
      console.error(`Live gauntlet of ${providerKey} requires an API key (set ${defaults.apiKeyEnv}).`);
      return 1;
    }
    llm = new LLMClient({ provider: providerKey, baseUrl, model: flags.model || defaults.model, apiKey, role: 'harness' });
  } else {
    if (!LLMClient.isConfigured()) {
      console.error('Live gauntlet requires a configured LLM. Set a provider key (e.g. GLM_API_KEY/MINIMAX_API_KEY) or pass --provider.');
      return 1;
    }
    llm = new LLMClient({ role: 'harness' });
  }

  // Create the throwaway sandbox worktree off the current HEAD. Detached (no
  // branch) so it never collides with the launch branch or trips the
  // merged-branch/already-checked-out warnings, and so cleanup is just a
  // worktree remove.
  const headSha = git(['rev-parse', 'HEAD']);
  const sandboxPath = fs.mkdtempSync(path.join(os.tmpdir(), 'sinter-live-gauntlet-'));
  const originalCwd = process.cwd();
  let runtime = null;

  const cleanup = async () => {
    try { process.chdir(originalCwd); } catch { /* ignore */ }
    try { await runtime?.close(); } catch { /* ignore */ }
    try { git(['worktree', 'remove', '--force', sandboxPath]); } catch { /* ignore */ }
    try { if (fs.existsSync(sandboxPath)) fs.rmSync(sandboxPath, { recursive: true, force: true }); } catch { /* ignore */ }
  };

  console.log('');
  console.log('=== Self-improvement gauntlet (LIVE) ===');
  console.log(`Provider: ${providerKey || 'harness-role (env-configured)'}`);
  console.log(`Sandbox: ${sandboxPath}`);
  console.log(`Base: ${headSha}`);

  try {
    // mkdtemp already created the dir; git worktree add populates it. --detach
    // avoids creating a branch (and its cleanup) for a throwaway sandbox.
    git(['worktree', 'add', '--force', '--detach', sandboxPath, headSha]);
    // A fresh worktree has no dependencies, so the agent's focused tests could
    // not resolve Vitest. Link the launch checkout's (ignored by .gitignore, so
    // they never count as a sandbox edit; cleanup removes the links only).
    for (const rel of ['node_modules', path.join('gui', 'node_modules')]) {
      const source = path.join(repoRoot, rel);
      if (fs.existsSync(source)) fs.symlinkSync(fs.realpathSync(source), path.join(sandboxPath, rel), 'dir');
    }

    const { runLiveSelfImprovementGauntlet, LIVE_GAUNTLET_DESCRIPTION } =
      await import('../dist/runtime-core/SelfImprovementGauntletLive.js');
    // Harness transports need a role-bound product grant like every other
    // product call; bootstrap before entering the sandbox so the journal never
    // lands in the throwaway worktree.
    const { bootstrapProductionLiminalRuntime } = await import('../dist/runtime-core/ProductionLiminalRuntime.js');
    runtime = await bootstrapProductionLiminalRuntime();

    process.chdir(sandboxPath);
    console.log(`Description: ${LIVE_GAUNTLET_DESCRIPTION}`);
    console.log('Running one bounded self-improvement pass through the real runtime...');
    console.log('');

    const result = await runtime.port.runResearchProviderEffect({
      idempotencyKey: `live-gauntlet:${headSha}:${path.basename(sandboxPath)}`,
      binding: { surface: 'cli-self-improve-gauntlet', base: headSha, sandbox: sandboxPath },
      identity: runtime.identities.harness, role: 'harness', maxTransportAttempts: 1,
      effect: () => runLiveSelfImprovementGauntlet({
      llm,
      detectSandboxEdits: () => {
        // Independent filesystem proof the edit landed in the sandbox.
        const porcelain = execFileSync('git', ['status', '--porcelain'], { cwd: sandboxPath, encoding: 'utf-8' });
        const changedFiles = porcelain
          .split('\n')
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => line.replace(/^\S+\s+/, ''));
        return { hasUncommittedChange: changedFiles.length > 0, changedFiles };
      },
    }) });

    console.log(`Model: ${result.modelName}`);
    console.log(`Status: ${result.status}`);
    console.log(`Steps: ${result.stepCount}`);
    console.log(`Runtime mutated files: ${result.mutatedFiles.length > 0 ? result.mutatedFiles.join(', ') : 'none'}`);
    console.log(`Sandbox changed files: ${result.sandboxChangedFiles.length > 0 ? result.sandboxChangedFiles.join(', ') : 'none'}`);
    console.log(`Verified real edit: ${result.verified ? 'YES' : 'NO'}`);
    console.log(`Reason: ${result.reason}`);

    if (result.verified && result.sandboxChangedFiles.length > 0) {
      const firstChanged = result.sandboxChangedFiles[0];
      try {
        const diffStat = execFileSync('git', ['diff', '--stat', '--', firstChanged], { cwd: sandboxPath, encoding: 'utf-8' }).trim();
        if (diffStat) {
          console.log('');
          console.log('Sandbox diff (proof of bounded edit):');
          console.log(diffStat);
        }
      } catch { /* diffstat is best-effort proof */ }
    }

    if (flags.output) {
      const report = {
        verified: result.verified,
        description: result.description,
        provider: providerKey || 'harness-role',
        model: result.modelName,
        status: result.status,
        stepCount: result.stepCount,
        mutatedFiles: result.mutatedFiles,
        successfulMutatedFiles: result.successfulMutatedFiles,
        sandboxChangedFiles: result.sandboxChangedFiles,
        reason: result.reason,
        sandbox: sandboxPath,
        base: headSha,
      };
      fs.writeFileSync(flags.output, `${JSON.stringify(report, null, 2)}\n`, 'utf-8');
      console.log('');
      console.log(`Wrote live gauntlet report: ${flags.output}`);
    }

    console.log('');
    console.log('Cleaning up sandbox worktree (no changes leak to the main repo)...');
    return result.verified ? 0 : 1;
  } catch (err) {
    console.error(`Live gauntlet error: ${err instanceof Error ? err.message : String(err)}`);
    return 1;
  } finally {
    await cleanup();
    console.log('Sandbox removed.');
  }
}

function loadAestheticConfig(configPath) {
  if (!configPath) return undefined;
  const resolvedPath = path.resolve(configPath);
  try {
    return JSON.parse(fs.readFileSync(resolvedPath, 'utf-8'));
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    console.error(`Error: failed to load --aesthetic-config from ${resolvedPath}: ${message}`);
    process.exit(1);
  }
}


function summarizeSession(session) {
  return {
    status: session.status,
    exitReason: session.exitReason,
    startTime: session.startTime,
    endTime: session.endTime,
    stepCount: session.stepCount,
    mutatedFiles: Array.from(session.mutatedFiles || []),
    successfulMutatedFiles: Array.from(session.successfulMutatedFiles || []),
    exploredPaths: Array.from(session.exploredPaths || []),
    messages: (session.messages || []).map((message) => ({
      role: message.role,
      content: typeof message.content === 'string' ? message.content.slice(0, 4000) : message.content,
      toolCall: message.toolCall,
      toolResult: message.toolResult,
    })),
  };
}

