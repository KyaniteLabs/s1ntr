*.zip

# Sinter runtime object store — content-addressable store (objects, refs) + SQLite
# DB and its WAL/SHM. All regenerable machine-local state; never tracked.
/.sinter/

# Quality/QA verification artifacts (baselines, render matrices, compose-verify logs)
/.quality/*
# Wave-8 release root is a FROZEN BUILD INPUT, not machine-local state: the
# release-truth test requires the 16-conjunct wave-8 branch, which activates
# only when this file exists. Doctrine: build inputs live in the repo.
# Alternating ladder: re-include each parent dir, re-ignore its contents,
# so ONLY the named file escapes the ignore (GLM review round 1).
!/.quality/wave-8/
/.quality/wave-8/*
!/.quality/wave-8/release/
/.quality/wave-8/release/*
!/.quality/wave-8/release/release-root.json

# Weekly read-only re-score reports (ops output written by the rescore cadence; Phase 4.G2)
/docs/validation/rescore/
.gjc/
packages/sing/public/presets/

# Compost runtime data (generated at runtime; heap source modules, tests,
# README, digest/*.md, and seeds/seeds.json stay intentionally tracked)
compost/seeds/archive/
compost/routing-removal/
compost/heap/cli-project-final.js
compost/heap/p5-3-organic.js

# Dogfood runtime outputs (producers such as scripts/dogfood-*.ts write to
# these same paths; dogfood-campaign/REPORT.md is intentional evidence and
# stays tracked, so only generated per-run subdirectories are ignored)
dogfood-telemetry/
dogfood-test/
dogfood-campaign-dashboard.html
dogfood-campaign/*/
dogfood-campaign/*.json
/dogfood-cloud-agent-*.ts
node_modules
